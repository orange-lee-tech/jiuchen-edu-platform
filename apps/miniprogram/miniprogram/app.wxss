page {
  min-height: 100%;
  background: #f4f2ed;
  color: #223246;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Segoe UI", sans-serif;
  font-size: 26rpx;
  -webkit-font-smoothing: antialiased;
}

.page-shell {
  box-sizing: border-box;
  padding: 28rpx 28rpx 56rpx;
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

.surface {
  background: #fffdf9;
  border: 1rpx solid #e8e2d6;
  border-radius: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(28, 52, 77, 0.04);
}

.section-title {
  color: #173e67;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.35;
}

.section-subtitle {
  margin-top: 8rpx;
  color: #737b87;
  font-size: 24rpx;
  line-height: 1.65;
}

.muted {
  color: #8b929d;
}

/*
 * Jiuchen V1 UI primitives
 * Keep these classes opt-in so feature pages can adopt them as their
 * business structure stabilizes.
 */

.jc-page-title {
  display: block;
  color: #173e67;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.25;
}

.jc-page-lead {
  display: block;
  margin-top: 12rpx;
  color: #66707d;
  font-size: 25rpx;
  line-height: 1.7;
}

.jc-section {
  margin-top: 36rpx;
}

.jc-section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.jc-card {
  box-sizing: border-box;
  background: #fffdf9;
  border: 1rpx solid #e8e2d6;
  border-radius: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(28, 52, 77, 0.04);
}

.jc-card--interactive:active {
  background: #f3f7fc;
  border-color: #cfddec;
}

.jc-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 84rpx;
  margin: 0;
  padding: 0 28rpx;
  border: 0;
  border-radius: 8rpx;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.2;
}

.jc-button::after {
  border: 0;
}

.jc-button--primary {
  background: #173e67;
  color: #ffffff;
}

.jc-button--primary:active {
  background: #245681;
}

.jc-button--secondary {
  background: #eaf2fa;
  color: #173e67;
}

.jc-button--secondary:active {
  background: #dceaf6;
}

.jc-button--outline {
  border: 1rpx solid #c9d9e8;
  background: #fffdf9;
  color: #173e67;
}

.jc-button--ghost {
  background: transparent;
  color: #5f6874;
}

.jc-button--danger {
  background: #fff4f2;
  color: #b34b43;
}

.jc-button[disabled] {
  background: #f0f2f5;
  color: #a4aab3;
  opacity: 1;
}

.jc-button--compact {
  min-height: 64rpx;
  padding: 0 22rpx;
  border-radius: 6rpx;
  font-size: 23rpx;
}

.jc-field {
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #dfe4ec;
  border-radius: 6rpx;
  background: #fffdf9;
}

.jc-field--focus {
  border-color: #7e9db9;
  box-shadow: 0 0 0 4rpx rgba(23, 62, 103, 0.08);
}

.jc-field--disabled {
  background: #f4f5f7;
  color: #9da3ac;
}

.jc-field-label {
  display: block;
  margin-bottom: 10rpx;
  color: #596371;
  font-size: 23rpx;
  font-weight: 600;
}

.jc-field-help {
  display: block;
  margin-top: 10rpx;
  color: #8b929d;
  font-size: 21rpx;
  line-height: 1.55;
}

.jc-tag {
  display: inline-flex;
  align-items: center;
  min-height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #faf1db;
  color: #896526;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.2;
}

.jc-tag--success {
  background: #edf8f1;
  color: #2e7d4f;
}

.jc-tag--warning {
  background: #fff6e8;
  color: #a76515;
}

.jc-tag--error {
  background: #fff1ef;
  color: #b34b43;
}

.jc-tag--neutral {
  background: #f0f2f5;
  color: #68717d;
}

.jc-state {
  box-sizing: border-box;
  padding: 44rpx 30rpx;
  border: 1rpx solid #e8e2d6;
  border-radius: 22rpx;
  background: #fffdf9;
  text-align: center;
}

.jc-state-title {
  display: block;
  color: #173e67;
  font-size: 27rpx;
  font-weight: 700;
}

.jc-state-desc {
  display: block;
  max-width: 560rpx;
  margin: 12rpx auto 0;
  color: #7b838f;
  font-size: 23rpx;
  line-height: 1.65;
}

.jc-state--error {
  border-color: #f0d9d6;
  background: #fffafa;
}

.jc-state--success {
  border-color: #d8eadf;
  background: #fbfefc;
}

.jc-spinner {
  width: 40rpx;
  height: 40rpx;
  margin: 0 auto 18rpx;
  border: 4rpx solid #dce6f1;
  border-top-color: #173e67;
  border-radius: 50%;
  animation: jc-spin 0.8s linear infinite;
}

@keyframes jc-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

.jc-rich-text {
  color: #343d49;
  font-size: 26rpx;
  line-height: 1.82;
  white-space: normal;
}

.jc-rich-text text,
.jc-rich-text view {
  max-width: 100%;
}

.jc-divider {
  height: 1rpx;
  background: #e8e2d6;
}

.jc-clickable:active {
  opacity: 0.72;
}
