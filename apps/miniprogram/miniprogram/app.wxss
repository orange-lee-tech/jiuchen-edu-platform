page {
  min-height: 100%;
  background: #f5f7fa;
  color: #20242c;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
}

view,
text,
button,
input,
scroll-view {
  box-sizing: border-box;
}

.page-shell {
  padding: 28rpx 28rpx 44rpx;
}

.section {
  margin-top: 32rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #171a21;
}

.section-link {
  font-size: 24rpx;
  color: #6f7785;
}

.surface {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(31, 53, 94, 0.06);
}

.muted {
  color: #7d8490;
}

.pill {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #edf3ff;
  color: #2b67f6;
  font-size: 22rpx;
}
