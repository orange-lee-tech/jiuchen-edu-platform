page {
  min-height: 100%;
  background: #f6f7fb;
  color: #1f2329;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page-shell {
  padding: 28rpx 28rpx 48rpx;
}

.surface {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(31, 35, 41, 0.05);
}

.section-title {
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #172033;
}

.section-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #8a91a1;
}

.pill {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #246bfd;
  font-size: 22rpx;
}
