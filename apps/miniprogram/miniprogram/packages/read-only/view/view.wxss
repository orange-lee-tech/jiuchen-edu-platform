page{background:#eef5f2}.mirror-shell{padding:18rpx 20rpx 75rpx;min-height:100vh;box-sizing:border-box;color:#18454a}.mirror-banner{padding:24rpx;background:linear-gradient(120deg,#153f57,#086e68);color:#fff;border-bottom:5rpx solid #e5b553;border-radius:9rpx}.banner-top{display:flex;justify-content:space-between;align-items:center;gap:10rpx;font-size:20rpx;color:#fce4a4}.badge{font-size:17rpx;color:#fff;padding:6rpx;border:1rpx solid #9cc7bf;border-radius:4rpx}.banner-title{display:block;font-size:33rpx;font-weight:850;margin:10rpx 0}.banner-hint{display:block;font-size:21rpx;line-height:1.6;color:#dbefec}.exit-button{margin:16rpx 0 0;background:#e8f7f0;color:#125950;font-size:21rpx;border-radius:5rpx;line-height:63rpx}.student-identity,.mirror-card{padding:21rpx 22rpx;background:#fff;border:1rpx solid #cee0d8;border-radius:9rpx;margin-top:15rpx}.section-title{display:block;font-size:28rpx;color:#153d44;font-weight:800;margin-bottom:12rpx}.meta{display:block;color:#718581;font-size:21rpx;line-height:1.55;margin-top:5rpx}.readonly-note{display:block;margin-top:12rpx;font-size:21rpx;color:#0d7d74}.mirror-tabs{margin-top:14rpx;white-space:nowrap}.mirror-tab-list{display:flex;width:max-content;gap:10rpx}.mirror-tab{padding:14rpx 19rpx;border:1rpx solid #b8d9ce;border-radius:5rpx;color:#246a67;background:#fff;font-size:23rpx}.mirror-tab.active{background:#096c65;color:#fff}.kv{display:flex;justify-content:space-between;align-items:flex-start;border-top:1rpx solid #e5ece9;padding:14rpx 0;gap:14rpx;font-size:22rpx}.kv text:first-child{color:#667e79;white-space:nowrap}.kv text:last-child{color:#194b49;text-align:right}.stage-picker{background:#f0f8f4;padding:16rpx;color:#086e64;border-radius:5rpx;font-size:23rpx}.plan-block,.record-row{padding:15rpx 0;border-bottom:1rpx solid #e4eee9}.item-header,.mirror-row{display:flex;justify-content:space-between;gap:12rpx;align-items:center}.item-title{font-size:25rpx;font-weight:800;color:#17464b}.status{color:#08786e;font-size:19rpx;flex:none}.task-row{padding:10rpx 8rpx;background:#f5faf8;font-size:22rpx;margin-top:8rpx;line-height:1.5}.task-row text{display:block}.body-copy{display:block;line-height:1.65;font-size:23rpx;color:#536d6b;white-space:pre-wrap;margin-top:7rpx}.subsection{margin-top:22rpx}.mirror-row{padding:18rpx 0;border-bottom:1rpx solid #e2efea}.arrow{font-size:21rpx;color:#087c72}.empty{display:block;padding:20rpx 0;color:#7b908b;font-size:22rpx}.error{color:#ae3933;font-size:24rpx;line-height:1.6}