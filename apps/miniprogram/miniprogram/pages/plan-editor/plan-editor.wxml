<auth-gate />
<view class="page-shell">
  <view class="editor-head">
    <text class="page-title">{{studentName || '计划编辑'}}</text>
    <text class="page-desc">保存后立即更新正式规划，无需审核。</text>
    <text wx:if="{{!teacherMode}}" class="status-line">当前规划：{{revisionStatus === 'pending' ? '旧版草稿未生效' : revisionStatus === 'approved' ? '已保存' : '尚未建立'}}</text>
  </view>

  <view wx:if="{{loading}}" class="editor-state surface">正在读取该学期规划…</view>
  <view wx:elif="{{loadError}}" class="editor-state surface">
    <text>{{loadError}}</text>
    <button class="retry-button" bindtap="onRetryLoad">重新读取</button>
  </view>

  <view wx:else class="surface editor-card">
    <view wx:if="{{schedulePrefillCount > 0}}" class="empty-note">已从最近一次课表带入 {{schedulePrefillCount}} 门课程。请核对并补充目标，点击保存后立即生效。</view>
    <text class="field-label">计划名称</text>
    <input disabled="{{readOnly}}" class="title-input" value="{{title}}" placeholder="填写计划名称" bindinput="onTitleInput" />

    <view class="section-row">
      <text class="section-title">任务清单</text>
      <text wx:if="{{!readOnly}}" class="add-link" bindtap="onAddItem">+ 添加任务</text>
    </view>

    <view wx:for="{{items}}" wx:key="index" class="item-card">
      <input disabled="{{readOnly}}" class="item-input strong" data-index="{{index}}" data-field="name" value="{{item.name}}" placeholder="任务名称" bindinput="onItemInput" />
      <input disabled="{{readOnly}}" class="item-input" data-index="{{index}}" data-field="target" value="{{item.target}}" placeholder="目标 / 说明（可选）" bindinput="onItemInput" />
      <view class="item-actions">
        <picker disabled="{{readOnly}}" range="{{statusOptions}}" range-key="label" data-index="{{index}}" bindchange="onStatusChange">
          <text class="status-picker">{{item.status === 'done' ? '已完成' : item.status === 'in_progress' ? '进行中' : '未开始'}} ▾</text>
        </picker>
        <text wx:if="{{!readOnly}}" class="remove-link" data-index="{{index}}" bindtap="onRemoveItem">删除</text>
      </view>
    </view>

    <view wx:if="{{items.length === 0}}" class="empty-note">还没有任务，点击“+ 添加任务”开始建立真实计划。</view>
  </view>

  <button wx:if="{{!readOnly && !loading && !loadError}}" class="save-button" loading="{{saving}}" disabled="{{saving}}" bindtap="onSave">
    保存规划
  </button>

  <view wx:if="{{!loading && !loadError && !teacherMode && versions.length}}" class="history-card surface">
    <text class="section-title">历史审核记录（只读）</text>
    <view wx:for="{{versions}}" wx:key="id" class="history-row">
      <view>
        <text class="history-title">{{item.title}}</text>
        <text class="history-time">{{item.createdAt}}</text>
      </view>
      <text class="history-status {{item.status}}">{{item.status === 'pending' ? '历史未生效' : item.status === 'approved' ? '历史已生效' : '历史未生效'}}</text>
    </view>
  </view>
</view>
