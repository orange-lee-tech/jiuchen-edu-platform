<auth-gate />
<view class="page-shell">
  <view class="editor-head">
    <text class="page-title">{{studentName || '计划编辑'}}</text>
    <text wx:if="{{!teacherMode}}" class="status-line">当前规划：{{revisionStatus === 'pending' ? '旧版草稿未生效' : revisionStatus === 'approved' ? '已保存' : '尚未建立'}}</text>
  </view>

  <view wx:if="{{loading}}" class="editor-state surface">正在读取该学期规划…</view>
  <view wx:elif="{{loadError}}" class="editor-state surface">
    <text>{{loadError}}</text>
    <button class="retry-button" bindtap="onRetryLoad">重新读取</button>
  </view>

  <view wx:else class="surface editor-card">
    <plan-task-editor title="{{title}}" items="{{items}}" read-only="{{readOnly}}" saving="{{saving}}" schedule-prefill-count="{{schedulePrefillCount}}" focus-task-index="{{focusTaskIndex}}"
      bind:titleinput="onTitleInput" bind:additem="onAddItem" bind:iteminput="onItemInput" bind:statuschange="onStatusChange"
      bind:duedatechange="onDueDateChange" bind:clearduedate="onClearDueDate" bind:removeitem="onRemoveItem" />
  </view>

  <button wx:if="{{!readOnly && !loading && !loadError}}" class="save-button" loading="{{saving}}" disabled="{{saving}}" bindtap="onSave">
    保存规划
  </button>

  <view wx:if="{{!loading && !loadError && !teacherMode && versions.length}}" class="history-card surface">
    <text class="section-title">历史审核记录（只读）</text>
    <view wx:for="{{versions}}" wx:key="id" class="history-row">
      <view>
        <text class="history-title">{{item.title}}</text>
        <text class="history-time">{{item.createdAt}}</text>
      </view>
      <text class="history-status {{item.status}}">{{item.status === 'pending' ? '历史未生效' : item.status === 'approved' ? '历史已生效' : '历史未生效'}}</text>
    </view>
  </view>
</view>
