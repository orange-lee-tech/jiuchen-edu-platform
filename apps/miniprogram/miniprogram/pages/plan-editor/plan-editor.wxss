.editor-head {
  margin: 8rpx 4rpx 22rpx;
}

.page-title,
.page-desc,
.status-line,
.field-label,
.history-title,
.history-time {
  display: block;
}

.page-title {
  font-size: 38rpx;
  font-weight: 800;
}

.page-desc {
  margin-top: 10rpx;
  color: #747b86;
  font-size: 23rpx;
  line-height: 1.65;
}

.status-line {
  margin-top: 12rpx;
  color: #6a50d5;
  font-size: 22rpx;
}

.editor-card,
.history-card {
  padding: 26rpx;
}

.editor-state {
  padding: 26rpx;
  color: #36566b;
  font-size: 25rpx;
  line-height: 1.6;
}

.retry-button {
  margin: 18rpx 0 0;
  border: 0;
  border-radius: 10rpx;
  background: #205b7d;
  color: #fff;
  font-size: 24rpx;
}

.field-label,
.section-title {
  font-size: 25rpx;
  font-weight: 700;
}

.title-input {
  margin-top: 14rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #f6f7fa;
}

.section-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 30rpx;
}

.add-link {
  color: #2f6fed;
  font-size: 23rpx;
}

.item-card {
  margin-top: 16rpx;
  padding: 18rpx;
  border: 1rpx solid #edf0f4;
  border-radius: 16rpx;
}

.item-input {
  padding: 13rpx 0;
  border-bottom: 1rpx solid #f0f1f4;
  font-size: 23rpx;
}

.item-input.strong {
  font-weight: 700;
}

.item-actions {
  display: flex;
  justify-content: space-between;
  padding-top: 14rpx;
}

.status-picker {
  color: #5d6570;
  font-size: 22rpx;
}

.remove-link {
  color: #b4534b;
  font-size: 22rpx;
}

.empty-note {
  margin-top: 18rpx;
  color: #8c929c;
  font-size: 22rpx;
}

.save-button {
  margin-top: 24rpx;
  border: 0;
  border-radius: 18rpx;
  background: #2f6fed;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
}

.save-button::after {
  border: 0;
}

.history-card {
  margin-top: 24rpx;
}

.history-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eef0f4;
}

.history-row:last-child {
  border-bottom: 0;
}

.history-title {
  font-size: 23rpx;
  font-weight: 650;
}

.history-time {
  margin-top: 6rpx;
  color: #959aa3;
  font-size: 19rpx;
}

.history-status {
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  background: #f1f3f6;
}

.history-status.pending { color: #9a6a00; background: #fff3d7; }
.history-status.approved { color: #257a4b; background: #eaf7ef; }
.history-status.rejected { color: #a34b43; background: #fbeceb; }
