.library-head {
  margin: 10rpx 4rpx 24rpx;
}

.page-title,
.eyebrow,
.result-title,
.result-desc,
.result-action {
  display: block;
}

.page-title {
  font-size: 38rpx;
  font-weight: 800;
}

.search-box {
  display: flex;
  align-items: center;
  padding: 18rpx 22rpx;
}

.search-icon {
  margin-right: 14rpx;
  color: #8a8f98;
}

.search-input {
  flex: 1;
  font-size: 25rpx;
}

.result-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 22rpx;
}

.result-card,
.state-card {
  padding: 26rpx;
}

.school-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 26rpx;
  border-left: 6rpx solid #896526;
}

.school-entry-pressed { background: #eaf2fa; }
.school-entry-title, .school-entry-arrow { display: block; }
.school-entry-title { color: #173e67; font-size: 29rpx; font-weight: 700; }
.school-entry-arrow { color: #245681; font-size: 34rpx; }
.error-state, .partial-state { color: #5f6b78; }
.retry-button { margin: 18rpx 0 0; background: #eaf2fa; color: #173e67; font-size: 25rpx; }
.retry-button::after { border: 0; }

.eyebrow {
  color: #2f6fed;
  font-size: 21rpx;
  font-weight: 700;
}

.result-title {
  margin-top: 10rpx;
  font-size: 29rpx;
  font-weight: 750;
  line-height: 1.45;
}

.result-desc {
  margin-top: 10rpx;
  color: #777e89;
  font-size: 23rpx;
  line-height: 1.6;
}

.result-action {
  margin-top: 16rpx;
  color: #2f6fed;
  font-size: 23rpx;
}

.state-card {
  margin-top: 22rpx;
  color: #858b95;
  font-size: 24rpx;
  line-height: 1.7;
}
