<view class="page-shell">
  <view class="library-head">
    <text class="page-title">资料与文章</text>
  </view>

  <view class="school-entry surface" bindtap="onSchools" hover-class="school-entry-pressed" aria-role="button">
    <view><text class="school-entry-title">进入院校库</text></view>
    <text class="school-entry-arrow">›</text>
  </view>

  <view class="search-box surface">
    <text class="search-icon">⌕</text>
    <input
      class="search-input"
      placeholder="输入院校、项目、夏令营、科研等关键词"
      value="{{query}}"
      bindinput="onSearchInput"
    />
  </view>

  <view wx:if="{{loading}}" class="state-card surface">资料加载中…</view>

  <view wx:elif="{{loadError}}" class="state-card surface error-state">
    <text>{{loadError}}</text>
    <button class="retry-button" bindtap="loadData">重新加载</button>
  </view>

  <view wx:else class="result-list">
    <view wx:if="{{partialNotice}}" class="state-card surface partial-state"><text>{{partialNotice}}</text><button class="retry-button" bindtap="loadData">刷新资料</button></view>
    <view
      wx:for="{{items}}"
      wx:key="id"
      class="result-card surface"
      data-index="{{index}}"
      bindtap="onItemTap"
    >
      <text class="eyebrow">{{item.eyebrow}}</text>
      <text class="result-title">{{item.title}}</text>
      <text class="result-desc">{{item.desc}}</text>
      <text class="result-action">{{item.kind === 'product' ? '查看详情 ›' : '查看原文 ›'}}</text>
    </view>
    <view wx:if="{{items.length === 0}}" class="state-card surface">
      {{query ? '没有匹配的资料，请换个关键词。' : '目前没有可浏览的资料，请稍后刷新。'}}
    </view>
  </view>
</view>
