.position-hero {
  padding: 32rpx;
  overflow: hidden;
  background: linear-gradient(145deg, #edf4ff 0%, #ffffff 72%);
  border-color: #e0e8f7;
}

.eyebrow,
.hero-title,
.hero-desc,
.quota,
.dimension-title,
.dimension-desc,
.notice-title,
.notice-text {
  display: block;
}

.eyebrow {
  color: #2f6fed;
  font-size: 23rpx;
  font-weight: 700;
}

.hero-title {
  margin-top: 14rpx;
  color: #18202b;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.34;
}

.hero-desc {
  margin-top: 16rpx;
  color: #66707d;
  font-size: 24rpx;
  line-height: 1.72;
}

.primary-btn {
  margin-top: 28rpx;
  height: 84rpx;
  border: 0;
  border-radius: 8rpx;
  background: #2f6fed;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.primary-btn:active {
  background: #285fcf;
}

.primary-btn::after {
  border: 0;
}

.history-btn {
  margin-top: 12rpx;
  height: 76rpx;
  border: 1rpx solid #cfdaf0;
  border-radius: 18rpx;
  background: #ffffff;
  color: #2f6fed;
  font-size: 24rpx;
  font-weight: 700;
}

.history-btn:active {
  background: #f5f8ff;
}

.history-btn::after {
  border: 0;
}

.quota {
  margin-top: 13rpx;
  text-align: center;
  color: #848c97;
  font-size: 21rpx;
  line-height: 1.5;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
  margin: 34rpx 4rpx 16rpx;
}

.saving-label {
  flex-shrink: 0;
  color: #7f8792;
  font-size: 21rpx;
}

.profile-card {
  padding: 2rpx 24rpx;
}

.profile-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 94rpx;
  box-sizing: border-box;
  padding: 19rpx 0;
  border-bottom: 1rpx solid #eceef2;
}

.profile-row:last-child {
  border-bottom: 0;
}

.profile-label {
  flex-shrink: 0;
  color: #5e6875;
  font-size: 25rpx;
  font-weight: 600;
}

.profile-input {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  color: #2e3742;
  font-size: 26rpx;
  font-weight: 600;
  text-align: right;
}

.profile-input::placeholder {
  color: #9da3ac;
  font-weight: 400;
}

.dimension-list {
  display: flex;
  flex-direction: column;
  gap: 13rpx;
}

.dimension-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 112rpx;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
}

.dimension-card:active {
  background: #f8faff;
  border-color: #d8e2f5;
}

.dimension-title {
  color: #2a333e;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.4;
}

.dimension-desc {
  margin-top: 6rpx;
  color: #78818d;
  font-size: 22rpx;
  line-height: 1.5;
}

.dimension-status {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #2f6fed;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.3;
}

.notice {
  margin-top: 26rpx;
  padding: 26rpx;
  background: #fcfdff;
}

.notice-title {
  color: #2a333e;
  font-size: 27rpx;
  font-weight: 700;
}

.notice-text {
  margin-top: 10rpx;
  color: #68727f;
  font-size: 23rpx;
  line-height: 1.72;
}
