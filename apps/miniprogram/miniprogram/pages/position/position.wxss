.position-hero,.section-card{padding:32rpx;margin-bottom:24rpx}.position-title{display:block;margin-top:20rpx;font-size:40rpx;line-height:1.4;font-weight:800;color:#172033}.position-desc{display:block;margin-top:16rpx;font-size:25rpx;line-height:1.7;color:#7f8797}.primary-btn{margin-top:30rpx;background:#246bfd!important;color:#fff!important;border-radius:18rpx;font-size:28rpx;font-weight:700}.primary-btn::after{border:0}.profile-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:24rpx}.profile-item{padding:22rpx;border-radius:18rpx;background:#f7f9fc}.profile-label{display:block;font-size:22rpx;color:#8a91a1}.profile-value{display:block;margin-top:8rpx;font-size:27rpx;font-weight:600}.steps{margin-top:24rpx}.step{display:flex;align-items:center;gap:18rpx;padding:18rpx 0;border-top:1rpx solid #eef0f4;font-size:26rpx}.step-index{width:44rpx;height:44rpx;border-radius:50%;background:#eef4ff;color:#246bfd;display:flex;align-items:center;justify-content:center;font-weight:700}.plan-note{margin-top:22rpx;padding:22rpx;border-radius:18rpx;background:#f7f9fc;color:#596273;font-size:24rpx;line-height:1.65}