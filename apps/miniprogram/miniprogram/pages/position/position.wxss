.position-hero {
  padding: 32rpx;
  overflow: hidden;
  background: linear-gradient(145deg, #eaf2fa 0%, #fffdf9 72%);
  border-color: #dbe3e8;
}
.hero-title,
.hero-desc,
.dimension-title,
.dimension-desc {
  display: block;
}

.hero-title {
  margin-top: 0;
  color: #18202b;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.34;
}

.hero-desc {
  margin-top: 16rpx;
  color: #66707d;
  font-size: 24rpx;
  line-height: 1.72;
}

.primary-btn {
  margin-top: 28rpx;
  height: 84rpx;
  border: 0;
  border-radius: 8rpx;
  background: #245681;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.primary-btn:active {
  background: #173e67;
}

.primary-btn::after {
  border: 0;
}

.history-btn {
  margin-top: 12rpx;
  height: 76rpx;
  border: 1rpx solid #cfdaf0;
  border-radius: 8rpx;
  background: #fffdf9;
  color: #245681;
  font-size: 24rpx;
  font-weight: 700;
}

.history-btn:active {
  background: #f3f7fc;
}

.history-btn::after {
  border: 0;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
  margin: 34rpx 4rpx 16rpx;
}

.saving-label {
  flex-shrink: 0;
  color: #7f8792;
  font-size: 21rpx;
}

.profile-card {
  padding: 2rpx 24rpx;
}

.profile-state { padding: 24rpx; color: #5e6875; font-size: 23rpx; line-height: 1.6; }
.profile-state button { width: max-content; margin: 16rpx 0 0; padding: 0 22rpx; border-radius: 8rpx; background: #eaf2fa; color: #173e67; font-size: 22rpx; }
.profile-state button::after { border: 0; }
.profile-edit-card{padding-top:12rpx;padding-bottom:18rpx;}
.profile-edit-card .profile-input{height:58rpx;}
.profile-error{display:block;margin-top:12rpx;color:#ad4437;font-size:22rpx;}
.profile-resume{padding:18rpx 0;color:#74542b;font-size:23rpx;line-height:1.5;}
.profile-actions{display:flex;gap:12rpx;margin-top:18rpx;}
.profile-actions button{flex:1;margin:0;font-size:23rpx;}
.profile-actions .primary-btn{height:76rpx;margin:0;}

.profile-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 94rpx;
  box-sizing: border-box;
  padding: 19rpx 0;
  border-bottom: 1rpx solid #eceef2;
}

.profile-row:last-child {
  border-bottom: 0;
}

.profile-label {
  flex-shrink: 0;
  color: #5e6875;
  font-size: 25rpx;
  font-weight: 600;
}

.profile-input {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  color: #2e3742;
  font-size: 26rpx;
  font-weight: 600;
  text-align: right;
}

.profile-input::placeholder {
  color: #9da3ac;
  font-weight: 400;
}

.dimension-list {
  display: flex;
  flex-direction: column;
  gap: 13rpx;
}

.dimension-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  min-height: 112rpx;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
}
.dimension-card-head{display:flex;align-items:center;justify-content:space-between;gap:18rpx;width:100%;}
.dimension-details{width:100%;margin-top:18rpx;padding-top:16rpx;border-top:1rpx solid #e8e2d8;}
.dimension-record{padding:14rpx 0;border-bottom:1rpx solid #eee9df;}
.dimension-record-actions{display:flex;gap:10rpx;margin-top:8rpx;}
.dimension-record-actions button{margin:0;font-size:21rpx;}
.growth-editor{margin-top:16rpx;}
.growth-field{display:block;box-sizing:border-box;width:100%;min-height:66rpx;margin-top:12rpx;padding:12rpx 14rpx;border:1rpx solid #e4ded2;border-radius:8rpx;background:#fffdf9;font-size:23rpx;}
.growth-textarea{height:125rpx;}

.dimension-card:active {
  background: #f8faff;
  border-color: #d8e2f5;
}

.dimension-title {
  color: #2a333e;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.4;
}

.dimension-desc {
  margin-top: 6rpx;
  color: #78818d;
  font-size: 22rpx;
  line-height: 1.5;
}

.dimension-status {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #245681;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.3;
}
