.detail-page {
  min-height: 100vh;
  padding: 24rpx 22rpx 150rpx;
  box-sizing: border-box;
  background: #f5f7fa;
  color: #252932;
}

.state-card,
.hero-card,
.section-card {
  margin-bottom: 18rpx;
  overflow: hidden;
  border: 1rpx solid #e8ebf0;
  border-radius: 8rpx;
  background: #fff;
}

.state-card {
  padding: 32rpx;
  color: #727984;
  font-size: 24rpx;
}

.state-card.error {
  color: #ad4f49;
}

.cover {
  width: 100%;
  height: 330rpx;
  background: #e9eef9;
}

.hero-body,
.section-card {
  padding: 28rpx;
}

.title,
.tagline,
.service-model,
.positioning,
.section-title,
.row-title,
.detail-text,
.line,
.section-note,
.resource-meta,
.pending,
.verification,
.bottom-title,
.bottom-desc {
  display: block;
}

.title {
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.35;
}

.tagline {
  margin-top: 8rpx;
  color: #5f6673;
  font-size: 23rpx;
}

.service-model {
  margin-top: 16rpx;
  color: #2f6fed;
  font-size: 23rpx;
  font-weight: 700;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 20rpx;
}

.meta-chip {
  padding: 9rpx 15rpx;
  border-radius: 999rpx;
  background: #f0f4ff;
  color: #4969ad;
  font-size: 20rpx;
}

.positioning {
  margin-top: 20rpx;
  color: #666e7b;
  font-size: 23rpx;
  line-height: 1.7;
}

.consult {
  margin-top: 24rpx;
  border: 0;
  border-radius: 8rpx;
  background: #2f6fed;
  color: #fff;
  font-size: 25rpx;
  font-weight: 700;
}

.consult::after {
  border: 0;
}

.consult.compact {
  flex-shrink: 0;
  margin: 0;
  padding: 0 22rpx;
  font-size: 22rpx;
  line-height: 64rpx;
}

.section-title {
  margin-bottom: 18rpx;
  font-size: 29rpx;
  font-weight: 800;
}

.section-note {
  margin: -6rpx 0 18rpx;
  color: #8a9099;
  font-size: 20rpx;
  line-height: 1.55;
}

.bullet-row {
  display: flex;
  gap: 10rpx;
  padding: 10rpx 0;
}

.bullet {
  color: #2f6fed;
  font-weight: 800;
}

.bullet-text {
  flex: 1;
  color: #555d69;
  font-size: 23rpx;
  line-height: 1.6;
}

.source {
  flex-shrink: 0;
  color: #a0a5ad;
  font-size: 18rpx;
}

.chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.highlight-card {
  width: calc(50% - 6rpx);
  min-height: 120rpx;
  box-sizing: border-box;
  padding: 18rpx;
  border-radius: 8rpx;
  background: #f7f9fc;
}

.highlight-title {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
}

.detail-text {
  margin-top: 7rpx;
  color: #68707c;
  font-size: 21rpx;
  line-height: 1.6;
}

.timeline-row {
  display: flex;
  gap: 16rpx;
  padding: 12rpx 0 20rpx;
}

.timeline-dot {
  width: 14rpx;
  height: 14rpx;
  margin-top: 12rpx;
  border: 5rpx solid #dce7ff;
  border-radius: 50%;
  background: #2f6fed;
}

.timeline-body {
  flex: 1;
}

.row-title {
  color: #303640;
  font-size: 24rpx;
  font-weight: 750;
  line-height: 1.5;
}

.line {
  margin-top: 7rpx;
  color: #646c78;
  font-size: 21rpx;
  line-height: 1.6;
}

.service-row,
.resource-row,
.teacher-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eef0f3;
}

.service-row:last-child,
.resource-row:last-child,
.teacher-row:last-child {
  border-bottom: 0;
}

.resource-row,
.teacher-row {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
}

.resource-row > view,
.teacher-main {
  flex: 1;
}

.resource-meta {
  margin-top: 7rpx;
  color: #8b929c;
  font-size: 20rpx;
}

.pending {
  margin-top: 8rpx;
  color: #9b6b26;
  font-size: 20rpx;
  line-height: 1.5;
}

.verification {
  margin-top: 8rpx;
  color: #9197a1;
  font-size: 19rpx;
}

.example-card {
  background: #fffcf5;
}

.bottom-consult {
  position: fixed;
  left: 22rpx;
  right: 22rpx;
  bottom: 24rpx;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #dfe6f6;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 10rpx 36rpx rgba(55, 76, 120, 0.12);
}

.bottom-title {
  font-size: 22rpx;
  font-weight: 750;
}

.bottom-desc {
  margin-top: 5rpx;
  color: #858b95;
  font-size: 19rpx;
}


.package-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.package-head > view {
  flex: 1;
}

.package-price {
  flex-shrink: 0;
  color: #2f6fed;
  font-size: 24rpx;
  font-weight: 800;
}

.paper-package {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eef0f3;
}

.paper-package:last-child {
  border-bottom: 0;
}

.package-meta-row {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-top: 8rpx;
}
