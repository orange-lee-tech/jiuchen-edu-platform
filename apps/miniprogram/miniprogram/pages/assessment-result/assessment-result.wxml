<auth-gate />
<view class="result-page">
  <view wx:if="{{loading}}" class="state-card">正在加载评估报告…</view>
  <view wx:elif="{{error}}" class="state-card error-card">
    <text>{{error}}</text>
    <button class="secondary" bindtap="onViewHistory">返回历史评估</button>
  </view>

  <block wx:elif="{{output}}">
    <view class="report-hero">
      <text class="eyebrow">AI 保研评估报告</text>
      <text class="report-title">{{assessment.input.profile.university}} · {{assessment.input.profile.major}}</text>
      <text class="report-meta">{{assessmentDate}} · {{assessment.model.name || '评估模型'}}</text>
      <view class="report-actions">
        <button class="action-button primary-action" bindtap="onCopyReport">复制报告</button>
        <button class="action-button" loading="{{exporting}}" disabled="{{exporting}}" bindtap="onDownloadReport">下载报告</button>
      </view>
    </view>

    <view class="section-card strengths-card">
      <view class="section-heading">
        <text class="section-number">01</text>
        <text class="section-title">优势</text>
      </view>
      <text wx:if="{{output.strengths.length === 0}}" class="empty">暂无明确优势结论</text>
      <view wx:for="{{output.strengths}}" wx:key="title" class="finding">
        <text class="finding-title">{{item.title}}</text>
        <view class="body-with-citations">
          <text class="body-text" user-select="true">{{item.detail}}</text>
          <button
            wx:for="{{item.citations}}"
            wx:for-item="citation"
            wx:key="ref"
            class="citation-link"
            data-ref="{{citation.ref}}"
            catchtap="onReferenceTap"
          >{{citation.label}}</button>
        </view>
      </view>
    </view>

    <view class="section-card risks-card">
      <view class="section-heading">
        <text class="section-number">02</text>
        <text class="section-title">风险</text>
      </view>
      <text wx:if="{{output.risks.length === 0}}" class="empty">暂无明确风险结论</text>
      <view wx:for="{{output.risks}}" wx:key="title" class="finding">
        <text class="finding-title">{{item.title}}</text>
        <view class="body-with-citations">
          <text class="body-text" user-select="true">{{item.detail}}</text>
          <button
            wx:for="{{item.citations}}"
            wx:for-item="citation"
            wx:key="ref"
            class="citation-link"
            data-ref="{{citation.ref}}"
            catchtap="onReferenceTap"
          >{{citation.label}}</button>
        </view>
      </view>
    </view>

    <view class="section-heading outside-heading">
      <text class="section-number">03</text>
      <text class="section-title">目标评估</text>
    </view>
    <view wx:if="{{output.targetAssessments.length === 0}}" class="section-card">
      <text class="empty">当前报告没有可展示的目标判断</text>
    </view>
    <view wx:for="{{output.targetAssessments}}" wx:key="schoolName" class="section-card target-card">
      <view class="target-head">
        <view>
          <text class="target-school">{{item.schoolName}}</text>
          <text wx:if="{{item.programName}}" class="target-program">{{item.programName}}</text>
        </view>
        <text class="tier {{item.tierTone}}">{{item.tierLabel}}</text>
      </view>

      <view class="body-with-citations rationale">
        <text class="body-text" user-select="true">{{item.rationale}}</text>
        <button
          wx:for="{{item.citations}}"
          wx:for-item="citation"
          wx:key="ref"
          class="citation-link"
          data-ref="{{citation.ref}}"
          catchtap="onReferenceTap"
        >{{citation.label}}</button>
      </view>

      <view wx:if="{{item.gapItems.length}}" class="subsection">
        <text class="sub-title">关键差距</text>
        <text wx:for="{{item.gapItems}}" wx:key="*this" class="bullet" user-select="true">· {{item}}</text>
      </view>
      <view wx:if="{{item.actions.length}}" class="subsection">
        <text class="sub-title">针对性动作</text>
        <text wx:for="{{item.actions}}" wx:key="*this" class="bullet" user-select="true">· {{item}}</text>
      </view>
    </view>

    <view class="section-card">
      <view class="section-heading">
        <text class="section-number">04</text>
        <text class="section-title">推荐行动</text>
      </view>
      <text wx:if="{{output.recommendedActions.length === 0}}" class="empty">暂无额外行动建议</text>
      <view wx:for="{{output.recommendedActions}}" wx:key="title" class="action-row">
        <text class="priority {{item.priority}}">{{item.priorityLabel}}</text>
        <view class="action-content">
          <text class="finding-title">{{item.title}}</text>
          <text class="body-text" user-select="true">{{item.rationale}}</text>
          <text wx:if="{{item.timeframe}}" class="timeframe">建议周期：{{item.timeframe}}</text>
        </view>
      </view>
    </view>

    <view class="section-card contact-card">
      <view class="section-heading">
        <text class="section-number">05</text>
        <text class="section-title">联系老师</text>
      </view>
      <text class="body-text" user-select="true">可携带本次评估结果与老师确认目标梯度、关键差距和下一阶段执行安排。老师可结合你的时间窗口与现有材料进一步判断。</text>
      <button class="contact-button" loading="{{consulting}}" disabled="{{consulting}}" bindtap="onCustomerServiceTap">联系九辰老师</button>
    </view>

    <view class="section-card references-card">
      <view class="section-heading">
        <text class="section-number">06</text>
        <text class="section-title">参考案例</text>
      </view>
      <text class="section-note">案例只作为分析证据。点击编号查看与本次判断相关的案例详情。</text>

      <text wx:if="{{references.length === 0}}" class="empty">当前正文没有直接引用可展示的案例</text>

      <button
        wx:for="{{references}}"
        wx:key="ref"
        class="reference-row"
        data-ref="{{item.ref}}"
        bindtap="onReferenceTap"
      >
        <text wx:if="{{item.caseId}}" class="reference-index">{{item.caseId}}</text>
        <view class="reference-main">
          <text class="reference-title">{{item.title}}</text>
          <text wx:if="{{item.metaLabel}}" class="reference-meta">{{item.metaLabel}}</text>
          <text wx:if="{{item.similarityReason}}" class="reference-reason">{{item.similarityReason}}</text>
        </view>
        <text class="reference-arrow">›</text>
      </button>
    </view>

    <view wx:if="{{output.uncertainties.length || output.disclaimer}}" class="section-card">
      <text class="section-title">不确定性及说明</text>
      <text wx:for="{{output.uncertainties}}" wx:key="*this" class="bullet" user-select="true">· {{item}}</text>
      <text wx:if="{{output.disclaimer}}" class="body-text" user-select="true">{{output.disclaimer}}</text>
    </view>

    <button class="secondary history-link" bindtap="onViewHistory">查看全部历史评估</button>
  </block>

  <view wx:if="{{selectedReference}}" class="reference-mask" catchtap="onCloseReference">
    <view class="reference-sheet" catchtap="onStopTap">
      <view class="reference-sheet-head">
        <text wx:if="{{selectedReference.caseId}}" class="reference-sheet-index">{{selectedReference.caseId}}</text>
        <button class="reference-close" bindtap="onCloseReference">×</button>
      </view>
      <text class="reference-sheet-title">{{selectedReference.title}}</text>
      <text wx:if="{{selectedReference.metaLabel}}" class="reference-sheet-meta">{{selectedReference.metaLabel}}</text>

      <view wx:if="{{selectedReference.similarityReason}}" class="reference-detail-block">
        <text class="reference-detail-label">与本次判断的关联</text>
        <text class="reference-detail-text" user-select="true">{{selectedReference.similarityReason}}</text>
      </view>

      <view wx:if="{{selectedReference.resultSummary}}" class="reference-detail-block">
        <text class="reference-detail-label">结果参照</text>
        <text class="reference-detail-text" user-select="true">{{selectedReference.resultSummary}}</text>
      </view>

      <view wx:if="{{selectedReference.excerpt}}" class="reference-detail-block">
        <text class="reference-detail-label">案例摘要</text>
        <text class="reference-detail-text" user-select="true">{{selectedReference.excerpt}}</text>
      </view>

      <text wx:if="{{selectedReference.caseId}}" class="reference-case-id">参考编号：{{selectedReference.caseId}}</text>
    </view>
  </view>

  <canvas
    canvas-id="reportExportCanvas"
    class="export-canvas"
    style="height: {{exportCanvasHeight}}px;"
  ></canvas>
</view>
