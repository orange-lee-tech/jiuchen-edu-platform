.result-page { min-height: 100vh; box-sizing: border-box; padding: 26rpx 24rpx 70rpx; background: #f6f7fb; color: #252932; }
.report-hero { padding: 18rpx 6rpx 28rpx; }
.eyebrow, .report-title, .report-meta, .section-title, .body-text, .finding-title, .target-school, .target-program, .sub-title, .bullet, .timeframe, .case-result, .disclaimer-title, .disclaimer-text, .empty { display: block; }
.eyebrow { color: #2f6fed; font-size: 22rpx; font-weight: 800; }
.report-title { margin-top: 10rpx; font-size: 36rpx; font-weight: 800; line-height: 1.4; }
.report-meta { margin-top: 10rpx; color: #818791; font-size: 21rpx; }
.card, .state-card { margin-bottom: 18rpx; padding: 25rpx; border: 1rpx solid #e9edf3; border-radius: 22rpx; background: #fff; }
.summary-card { background: linear-gradient(145deg, #f2f6ff, #fff); }
.section-title { margin-bottom: 16rpx; font-size: 28rpx; font-weight: 800; }
.body-text { color: #5c6470; font-size: 22rpx; line-height: 1.7; }
.two-column { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.finding-card { min-width: 0; }
.strengths-card { border-top: 5rpx solid #45a36f; }
.risks-card { border-top: 5rpx solid #dc7d59; }
.finding + .finding, .case-row + .case-row { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid #edf0f4; }
.finding-title { margin-bottom: 7rpx; color: #30353d; font-size: 23rpx; font-weight: 800; }
.section-label { margin: 28rpx 6rpx 15rpx; font-size: 30rpx; font-weight: 800; }
.target-head, .case-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.target-school { font-size: 28rpx; font-weight: 800; }
.target-program { margin-top: 6rpx; color: #7d838c; font-size: 21rpx; }
.tier, .source-chip, .priority { flex-shrink: 0; padding: 7rpx 14rpx; border-radius: 999rpx; font-size: 19rpx; font-weight: 700; }
.tier.reach { background: #fff0ed; color: #b24f45; }
.tier.match { background: #eaf3ff; color: #3066bd; }
.tier.conservative { background: #eaf8ef; color: #287b50; }
.tier.insufficient { background: #f0f1f4; color: #717780; }
.rationale { margin-top: 18rpx; }
.subsection { margin-top: 20rpx; padding-top: 16rpx; border-top: 1rpx solid #eef0f3; }
.sub-title { margin-bottom: 8rpx; color: #4c535d; font-size: 21rpx; font-weight: 800; }
.bullet { margin-top: 7rpx; color: #69717d; font-size: 21rpx; line-height: 1.55; }
.action-row { display: flex; align-items: flex-start; gap: 16rpx; padding: 17rpx 0; border-top: 1rpx solid #eef0f3; }
.action-row:first-of-type { border-top: 0; }
.priority { background: #eef2f8; color: #5e6878; }
.priority.high { background: #fff0ed; color: #ae4d44; }
.priority.medium { background: #fff7df; color: #967126; }
.action-content { flex: 1; }
.timeframe { margin-top: 8rpx; color: #87909c; font-size: 19rpx; }
.source-chip { background: #f0f3f8; color: #657084; }
.case-result { margin-top: 9rpx; color: #3f629d; font-size: 21rpx; line-height: 1.6; }
.uncertainty-card { background: #fffbef; }
.disclaimer { margin: 24rpx 8rpx; padding: 22rpx; border-radius: 18rpx; background: #eceff4; }
.disclaimer-title { color: #555d68; font-size: 21rpx; font-weight: 800; }
.disclaimer-text { margin-top: 8rpx; color: #737b86; font-size: 20rpx; line-height: 1.65; }
.empty { color: #999fa8; font-size: 21rpx; line-height: 1.6; }
.secondary { margin-top: 22rpx; border-radius: 16rpx; background: #e9edf4; color: #4f5866; font-size: 23rpx; font-weight: 700; }
.secondary::after { border: 0; }
.history-link { width: 100%; }
.error-card { color: #9d4b45; text-align: center; }
