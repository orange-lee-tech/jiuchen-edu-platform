<view class="home-page">
  <role-shell view-slot="home" phase="{{shellPhase}}" kind="{{shellKind}}" role-label="{{shellRoleLabel}}" message="{{shellMessage}}" />
  <block wx:if="{{shellPhase === 'ready' && shellKind === 'student'}}">
    <view class="home-intro {{loggedIn ? 'home-intro-compact' : ''}}">
      <image class="home-hero-art" src="/assets/jiuchen-visual-v1/banners/today-campus-hero.webp" mode="aspectFill" aria-hidden="true" />
      <view class="home-intro-content">
        <text class="eyebrow">{{todayLabel}}</text>
        <text class="home-title">今天</text>
        <button wx:if="{{!loggedIn}}" class="home-primary" bindtap="onPrimary">进入我的规划 ›</button>
        <text wx:if="{{readOnly || !assessmentReady}}" class="home-caption">{{readOnly ? '只读模式 · 无编辑和评估权限' : loggedIn ? '学业资料待完善' : '登录后查看个人数据'}}</text>
        <text wx:if="{{!assessmentReady && !readOnly}}" class="home-minor-link" bindtap="onCompleteProfile">{{loggedIn ? '补全学业资料 ›' : '登录并建立档案 ›'}}</text>
      </view>
    </view>
    <view class="home-schedule home-card">
      <view class="home-card-head"><view class="home-heading-with-icon"><image class="home-heading-icon" src="/assets/jiuchen-visual-v1/icons/calendar.webp" mode="aspectFit" /><text class="section-heading">今日课表</text></view><text class="home-card-link" bindtap="onPlanning">本周完整课表 ›</text></view>
      <view class="day-tabs"><view class="day-tab {{scheduleDay === 0 ? 'active' : ''}}" data-day="0" bindtap="onScheduleDay">今天</view><view class="day-tab {{scheduleDay === 1 ? 'active' : ''}}" data-day="1" bindtap="onScheduleDay">明天</view></view>
      <text class="home-schedule-meta">{{scheduleDateLabel}}{{scheduleStage ? ' · 档案阶段：' + scheduleStage : ''}}{{scheduleLabel ? ' · ' + scheduleLabel : ''}}</text>
      <text wx:if="{{scheduleLoading}}" class="home-state">正在读取课表…</text>
      <view wx:elif="{{scheduleError}}" class="home-state"><text>{{scheduleError}}</text><text class="home-state-link" bindtap="onPlanning">进入规划页重试 ›</text></view>
      <text wx:elif="{{!loggedIn}}" class="home-state">登录后查看个人课表</text>
      <view wx:elif="{{scheduleState !== 'ready'}}" class="home-state"><text>{{scheduleState === 'holiday' ? '当前阶段没有学期课表' : scheduleState === 'missing' ? '尚未导入本学期课表' : scheduleState === 'before' ? '课表学期尚未开始' : scheduleState === 'date' ? '需设置本学期第一周周一' : '当天没有匹配课程'}}</text><text class="home-state-link" bindtap="onPlanning">{{scheduleState === 'empty' || scheduleState === 'holiday' ? '查看阶段规划 ›' : '前往课表管理 ›'}}</text></view>
      <block wx:else><view wx:for="{{scheduleCourses}}" wx:key="index" class="home-schedule-course {{item.next ? 'next-course' : ''}}">
        <view class="home-course-when"><text class="home-course-time">{{item.time}}</text><text wx:if="{{item.next}}" class="next-label">下一节</text></view>
        <view class="home-course-main"><text class="home-course-name">{{item.name}}</text><text class="home-course-location">{{item.location}}</text></view>
      </view></block>
    </view>
    <view class="home-plan home-card">
      <view class="home-card-head"><text class="section-heading">阶段规划</text><text class="home-card-link" bindtap="onPlanning">进入规划 ›</text></view>
      <text wx:if="{{planLoading}}" class="home-state">正在读取阶段规划…</text>
      <text wx:elif="{{planError}}" class="home-state">{{planError}}</text>
      <text wx:elif="{{planState === 'unbound'}}" class="home-state">绑定学员身份后，即可查看和编辑自己的阶段规划。</text>
      <block wx:else><text class="home-plan-stage">档案阶段：{{planStageLabel}}</text><view wx:for="{{planPreview}}" wx:key="title" class="home-plan-row"><text class="home-plan-name">{{item.title}}</text><text class="home-plan-status">{{item.status}}</text></view><text wx:if="{{!planPreview.length}}" class="home-state">本阶段暂无计划，进入规划页查看可用内容。</text></block>
    </view>
    <view class="home-shortcuts home-card">
      <view class="home-section-bar"><text class="section-heading">常用入口</text></view>
      <view class="action-list">
<view class="action-row action-assessment" bindtap="onAssessment" hover-class="action-pressed" aria-role="button" aria-label="AI评估与历史结果">
        <view class="action-symbol"><image class="action-icon" src="/assets/jiuchen-visual-v1/icons/ai-assessment.webp" mode="aspectFit" /></view>
        <text class="action-title">AI 评估</text>
        <text class="action-more">›</text>
      </view>
<view class="action-row action-schools" bindtap="onSchools" hover-class="action-pressed" aria-role="button" aria-label="筛选院校库">
        <view class="action-symbol"><image class="action-icon" src="/assets/jiuchen-visual-v1/icons/library.webp" mode="aspectFit" /></view>
        <text class="action-title">院校库</text><text class="action-more">›</text>
      </view>
<view class="action-row action-news" bindtap="onNews" hover-class="action-pressed" aria-role="button" aria-label="阅读保研资讯">
        <view class="action-symbol"><image class="action-icon" src="/assets/jiuchen-visual-v1/icons/news.webp" mode="aspectFit" /></view>
        <text class="action-title">保研资讯</text>
        <text class="action-more">›</text>
      </view>
<view class="action-row action-countdown" bindtap="onCountdownToggle" hover-class="action-pressed" aria-role="button" aria-label="查看或设置倒数日">
        <view class="action-symbol"><image class="action-icon" src="/assets/jiuchen-visual-v1/icons/clock.webp" mode="aspectFit" /></view>
        <text class="action-title">倒数日</text>
        <text wx:if="{{countdowns.length}}" class="action-countdown-days">{{countdowns[0].remainingDays}} 天</text>
        <text class="action-more">›</text>
      </view>
<view class="action-row action-consult" bindtap="onCustomerService" hover-class="action-pressed" aria-role="button" aria-label="联系九辰客服">
        <view class="action-symbol"><image class="action-icon" src="/assets/jiuchen-visual-v1/icons/headset.webp" mode="aspectFit" /></view>
        <text class="action-title">联系客服</text>
        <text class="action-more">›</text>
      </view>
      </view>
    </view>
    <view wx:if="{{countdownOpen}}" class="home-card countdown-panel">
      <view class="home-card-head"><text class="section-heading">我的倒数日</text><text class="home-card-link" bindtap="onCountdownToggle">收起 ›</text></view>
      <text class="countdown-local-note">仅保存在本机当前学员账号</text>
      <view wx:for="{{countdowns}}" wx:key="id" class="countdown-item">
        <view class="countdown-main"><text class="countdown-name">{{item.title}}</text><text class="countdown-date">{{item.date}}</text></view>
        <text class="countdown-remaining">{{item.remainingDays === 0 ? '就是今天' : '还剩 ' + item.remainingDays + ' 天'}}</text>
        <text class="countdown-remove" data-id="{{item.id}}" bindtap="onCountdownDelete">删除</text>
      </view>
      <view wx:if="{{countdowns.length < 8}}" class="countdown-editor">
        <input class="countdown-input" maxlength="24" placeholder="事件名称，如：四六级考试" value="{{countdownTitle}}" bindinput="onCountdownTitleInput" />
        <picker mode="date" start="{{countdownToday}}" end="2099-12-31" value="{{countdownDate}}" bindchange="onCountdownDateChange">
          <view class="countdown-date-picker">目标日期：{{countdownDate}} ›</view>
        </picker>
        <button class="countdown-save" loading="{{countdownSaving}}" disabled="{{countdownSaving}}" bindtap="onCountdownSave">保存倒数日</button>
      </view>
    </view>
    <view class="service-section">
      <text class="section-heading">认识九辰</text>
      <view class="service-links">
        <view class="service-link service-products" bindtap="onProducts" hover-class="service-pressed" aria-role="button" aria-label="查看九辰服务介绍">
          <view class="service-symbol"><image class="service-icon" src="/assets/icons/business-active.png" mode="aspectFit" /></view>
          <text class="service-title">服务介绍</text>
        </view>
        <view class="service-link service-brand" bindtap="onBrand" hover-class="service-pressed" aria-role="button" aria-label="了解九辰品牌">
          <view class="service-symbol"><image class="service-icon" src="/assets/icons/users-active.png" mode="aspectFit" /></view>
          <text class="service-title">关于九辰</text>
        </view>
        <view class="service-link service-website" bindtap="onWebsite" hover-class="service-pressed" aria-role="button" aria-label="访问九辰官网">
          <view class="service-symbol"><image class="service-icon" src="/assets/icons/website-active.png" mode="aspectFit" /></view>
          <text class="service-title">九辰官网</text>
        </view>
      </view>
    </view>
  </block>
</view>
<first-use-guide wx:if="{{!readOnly}}" />
<official-website-dialog id="website-dialog" />
