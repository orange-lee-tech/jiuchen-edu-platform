<view class="page">
  <view class="card">
    <text class="title">{{title}}</text>
    <text class="subtitle">{{subtitle}}</text>
    <text class="hint">当前只验证微信小程序、API、数据库与微信身份基础链路，业务页面将在 P2 开始还原。</text>

    <view class="status-list">
      <view class="status-row">
        <text class="status-label">云端 API</text>
        <text class="status-value">{{apiStatus}}</text>
      </view>
      <view class="status-row">
        <text class="status-label">数据库</text>
        <text class="status-value">{{databaseStatus}}</text>
      </view>
      <view class="status-row">
        <text class="status-label">微信身份</text>
        <text class="status-value">{{identityStatus}}</text>
      </view>
    </view>

    <view wx:if="{{identityMeta}}" class="demo-student">
      <text class="status-label">当前业务用户</text>
      <text class="hint">{{identityMeta}}</text>
    </view>

    <view wx:if="{{studentName}}" class="demo-student">
      <text class="status-label">演示学员</text>
      <text class="student-name">{{studentName}}</text>
      <text class="hint">{{studentMeta}}</text>
    </view>
  </view>
</view>
