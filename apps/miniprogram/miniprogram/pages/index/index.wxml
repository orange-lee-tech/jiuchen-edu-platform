<view class="home-page">
  <role-shell view-slot="home" phase="{{shellPhase}}" kind="{{shellKind}}" role-label="{{shellRoleLabel}}" message="{{shellMessage}}" />
  <block wx:if="{{shellPhase === 'ready' && shellKind === 'student'}}">
    <view class="home-intro">
      <text class="eyebrow">九辰保研 · 陪你走清楚每一步</text>
      <text class="home-title">{{loggedIn ? '从真实背景，找到下一步' : '让保研准备更有方向'}}</text>
      <text class="home-description">整理学业背景，查看评估建议，接续阶段规划。你的资料和历史结果都能再次查看。</text>
      <button class="home-primary" bindtap="onPrimary">{{assessmentReady ? '开始 AI 评估' : (loggedIn ? '完善我的资料' : '建立我的保研档案')}}</button>
      <text class="home-caption">{{assessmentReady ? '已绑定学员 · 学业资料就绪，可以开始评估' : (loggedIn ? '学业资料在“我的”统一管理' : '使用微信登录，已有资料可继续完善')}}</text>
    </view>
    <text class="section-heading">准备与行动</text>
    <view class="action-list">
      <view class="action-row action-assessment" bindtap="onAssessment" hover-class="action-pressed" aria-role="button" aria-label="背景评估与历史结果">
        <view class="action-symbol"><image class="action-icon" src="/assets/icons/assessment-active.png" mode="aspectFit" /></view>
        <view class="action-main"><text class="action-title">背景评估与历史结果</text><text class="action-description">整理背景，查看有依据的分析与建议</text></view>
        <text class="arrow">›</text>
      </view>
      <view class="action-row action-planning" bindtap="onPlanning" hover-class="action-pressed" aria-role="button" aria-label="我的阶段规划">
        <view class="action-symbol"><image class="action-icon" src="/assets/icons/calendar-active.png" mode="aspectFit" /></view>
        <view class="action-main"><text class="action-title">我的阶段规划</text><text class="action-description">查看真实规划、课表与辅导审核进度</text></view>
        <text class="arrow">›</text>
      </view>
      <view class="action-row action-news" bindtap="onNews" hover-class="action-pressed" aria-role="button" aria-label="阅读保研文章">
        <view class="action-symbol"><image class="action-icon" src="/assets/icons/opportunity-active.png" mode="aspectFit" /></view>
        <view class="action-main"><text class="action-title">阅读保研文章</text><text class="action-description">浏览已同步、已分类的九辰资讯</text></view>
        <text class="arrow">›</text>
      </view>
    </view>
    <view class="service-section">
      <text class="section-heading">认识九辰</text>
      <view class="service-links">
        <view class="service-link service-products" bindtap="onProducts" hover-class="service-pressed" aria-role="button">服务介绍 <text>›</text></view>
        <view class="service-link service-brand" bindtap="onBrand" hover-class="service-pressed" aria-role="button">关于九辰 <text>›</text></view>
        <view class="service-link service-advisor" bindtap="onCustomerService" hover-class="service-pressed" aria-role="button"><image class="link-icon" src="/assets/icons/service-active.png" mode="aspectFit" />联系顾问 <text>›</text></view>
        <view class="service-link service-website" bindtap="onWebsite" hover-class="service-pressed" aria-role="button"><image class="link-icon" src="/assets/icons/website-active.png" mode="aspectFit" />九辰官网 <text>›</text></view>
      </view>
      <text class="service-note">服务方案提供介绍与咨询，课程不在线购买。</text>
    </view>
  </block>
</view>
<first-use-guide />
<official-website-dialog id="website-dialog" />
