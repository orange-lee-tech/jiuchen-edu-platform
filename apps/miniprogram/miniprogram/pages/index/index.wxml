<view class="home-page">
  <role-shell slot="home" phase="{{shellPhase}}" kind="{{shellKind}}" role-label="{{shellRoleLabel}}" message="{{shellMessage}}" />
  <block wx:if="{{shellPhase === 'ready' && shellKind === 'student'}}">
    <view class="home-intro">
      <text class="eyebrow">九辰保研 · 陪你走清楚每一步</text>
      <text class="home-title">{{loggedIn ? '从真实背景，找到下一步' : '让保研准备更有方向'}}</text>
      <text class="home-description">整理学业背景，查看评估建议，接续阶段规划。你的资料和历史结果都能再次查看。</text>
      <button class="home-primary" bindtap="onPrimary">{{loggedIn ? '完善我的资料' : '建立我的保研档案'}}</button>
      <text class="home-caption">{{loggedIn ? '已登录 · 可在“我的”查看或绑定九辰身份' : '使用微信登录，已有资料可继续完善'}}</text>
    </view>
    <text class="section-heading">准备与行动</text>
    <view class="action-list">
      <button class="action-row" bindtap="onAssessment"><view class="action-main"><text class="action-title">背景评估与历史结果</text><text class="action-description">整理背景，查看有依据的分析与建议</text></view><text class="arrow">›</text></button>
      <button class="action-row" bindtap="onPlanning"><view class="action-main"><text class="action-title">我的阶段规划</text><text class="action-description">九辰学员查看规划、导入课表与接续辅导</text></view><text class="arrow">›</text></button>
      <button class="action-row" bindtap="onNews"><view class="action-main"><text class="action-title">阅读保研文章</text><text class="action-description">查看已同步、已分类的服务号内容</text></view><text class="arrow">›</text></button>
    </view>
    <view class="service-section">
      <text class="section-heading">认识九辰</text>
      <view class="service-links"><button bindtap="onProducts">服务介绍</button><button bindtap="onBrand">关于九辰</button><button bindtap="onCustomerService">联系顾问</button></view>
      <text class="service-note">服务方案提供介绍与咨询，课程不在线购买。</text>
    </view>
  </block>
</view>
