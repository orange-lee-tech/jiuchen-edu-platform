/* Two equal columns, fixed widths: avoids WeChat flex-basis calc() falling back to a single half-width column. */
.home-page{box-sizing:border-box;min-height:100vh;padding:22rpx 22rpx calc(40rpx + env(safe-area-inset-bottom));background:#eaf1f7;color:#112541;}
.home-intro{padding:30rpx 28rpx;background:#143869;color:#fff;border-left:7rpx solid #f2b544;border-bottom:5rpx solid #0a8b89;border-radius:7rpx;}
.eyebrow,.home-title,.home-description,.home-caption,.section-heading,.action-title,.action-description,.service-note{display:block;}
.eyebrow{font-size:22rpx;font-weight:700;color:#ffd781;letter-spacing:1rpx;}
.home-title{font-size:40rpx;line-height:1.35;font-weight:850;margin-top:12rpx;}
.home-description{font-size:24rpx;line-height:1.62;color:#e5f0ff;margin-top:10rpx;}
button{box-sizing:border-box;margin-left:0;margin-right:0;border-radius:7rpx;white-space:normal;}
button::after{border:0;}
.home-primary{display:flex;width:100%;justify-content:center;align-items:center;margin:22rpx 0 0;min-height:83rpx;padding:12rpx 20rpx;background:#ffc94e;color:#132f57;font-size:29rpx;line-height:1.4;font-weight:850;}
.home-caption{font-size:21rpx;line-height:1.5;color:#d2e5fc;margin-top:13rpx;}
.home-section-bar{display:flex;align-items:center;justify-content:space-between;gap:10rpx;margin:24rpx 0 12rpx;}
.section-heading{font-size:30rpx;font-weight:850;line-height:1.45;color:#142b49;margin:0;}
.section-supplement{font-size:19rpx;color:#71849a;}
.action-list{display:flex;flex-wrap:wrap;justify-content:space-between;row-gap:12rpx;width:100%;}
.action-row{position:relative;display:flex;flex-direction:column;align-items:flex-start;box-sizing:border-box;width:49%;min-height:165rpx;padding:17rpx 16rpx 16rpx;background:#fff;border:1rpx solid #d4e1ed;border-top:5rpx solid #2c67d5;border-radius:7rpx;text-align:left;}
.action-planning{border-top-color:#08a49b;background:#f3fffd;}
.action-news{border-top-color:#e7a331;background:#fffdf4;}
.action-consult{border-top-color:#0c8f82;background:#f2fcf9;}
.action-pressed{background:#dfeafa;}
.action-symbol{display:flex;align-items:center;justify-content:center;width:49rpx;height:49rpx;background:#e6efff;border-radius:5rpx;}
.action-planning .action-symbol,.action-consult .action-symbol{background:#d6f5ef;}
.action-news .action-symbol{background:#fff0c7;}
.action-icon{width:31rpx;height:31rpx;}
.action-title{font-size:26rpx;font-weight:850;line-height:1.3;color:#122944;margin-top:12rpx;}
.action-description{font-size:19rpx;line-height:1.35;color:#60738b;margin-top:5rpx;padding-right:10rpx;}
.action-more{position:absolute;right:17rpx;top:26rpx;color:#1b5faa;font-size:35rpx;}
.service-section{margin-top:28rpx;border-top:3rpx solid #e5a838;padding-top:19rpx;}
.service-links{display:flex;flex-wrap:wrap;justify-content:space-between;row-gap:10rpx;width:100%;margin-top:11rpx;}
.service-link{display:flex;box-sizing:border-box;justify-content:space-between;align-items:center;width:49%;min-height:78rpx;padding:14rpx 17rpx;color:#114889;background:#fff;border:1rpx solid #d2e2ef;border-radius:6rpx;font-size:23rpx;font-weight:750;}
.service-link text{font-size:32rpx;color:#1659a4;}
.service-website{background:#e5eeff;width:100%;}
.service-pressed{opacity:.78;}
.service-note{font-size:20rpx;line-height:1.5;color:#4f6173;margin-top:12rpx;}

.home-minor-link{display:block;margin-top:12rpx;color:#ffe29b;font-size:22rpx;font-weight:750;text-decoration:underline;}

/* Intentional vivid four-color identity, larger icons and tighter composition. */
.home-page{background:linear-gradient(180deg,#e8f1ff 0%,#e9f8f5 63%,#eef4ff 100%);}
.home-intro{background:linear-gradient(132deg,#103561 0%,#19549b 57%,#087f84 100%);border-left:8rpx solid #ffb43f;border-bottom:6rpx solid #0ba796;box-shadow:0 9rpx 19rpx rgba(14,57,96,.13);}
.action-list{row-gap:13rpx;}
.action-row{min-height:171rpx;border-top-width:6rpx;box-shadow:0 3rpx 11rpx rgba(20,55,80,.09);}
.action-planning{background:#d9f9ee;border-top-color:#009f89;}
.action-news{background:#fff1cb;border-top-color:#edaa23;}
.action-assessment{background:#e0eafe;border-top-color:#356eea;}
.action-consult{background:#d9f0fa;border-top-color:#0d91bf;}
.action-symbol{height:65rpx;width:65rpx;border-radius:9rpx;}
.action-planning .action-symbol{background:#83ddc8;}
.action-news .action-symbol{background:#ffda7b;}
.action-assessment .action-symbol{background:#b9cfff;}
.action-consult .action-symbol{background:#a7e0f7;}
.action-icon{height:43rpx;width:43rpx;}
.action-title{font-size:28rpx;color:#0d3149;}
.action-description{font-size:20rpx;color:#486177;}
.action-more{font-size:37rpx;color:#0a6676;}
.service-section{margin-top:22rpx;padding-top:14rpx;}
.service-links{margin-top:9rpx;row-gap:8rpx;}
.service-link{min-height:67rpx;background:#eff6ff;border-left:5rpx solid #608fe7;}
.service-products{background:#f5edff;border-left-color:#9367d9;}
.service-brand{background:#e7f9f6;border-left-color:#2aafa0;}
.service-website{background:#e2ecff;border-left-color:#4376db;}
.service-note{margin-top:8rpx;}
