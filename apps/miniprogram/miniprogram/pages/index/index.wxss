.home-page { padding: 28rpx 28rpx calc(32rpx + env(safe-area-inset-bottom)); color: #18202a; background: #f2f4f6; }
.home-intro { padding: 32rpx; border-top: 6rpx solid #2f6fed; border-radius: 6rpx; background: #e7eef8; }
.eyebrow, .home-title, .home-description, .home-caption, .section-heading, .action-title, .action-description, .service-note { display: block; }
.eyebrow { font-size: 24rpx; font-weight: 600; color: #2459be; line-height: 1.6; }
.home-title { margin-top: 18rpx; font-size: 44rpx; line-height: 1.4; font-weight: 800; }
.home-description { margin-top: 16rpx; font-size: 27rpx; line-height: 1.8; color: #46586e; }
button { border-radius: 8rpx; white-space: normal; }
button::after { border: 0; }
.home-primary { margin: 28rpx 0 0; padding: 22rpx 24rpx; background: #2f6fed; color: #fff; font-size: 28rpx; font-weight: 700; line-height: 1.5; }
.home-primary:active { background: #2459be; }
.home-caption { margin-top: 16rpx; font-size: 23rpx; color: #46586e; line-height: 1.6; }
.section-heading { margin: 30rpx 0 16rpx; font-size: 31rpx; font-weight: 700; }
.action-list { background: #fafbfc; border: 1rpx solid #d8dee6; }
.action-row { display: flex; align-items: center; width: 100%; box-sizing: border-box; margin: 0; padding: 26rpx; background: transparent; border-radius: 0; border-bottom: 1rpx solid #e5e9ee; text-align: left; }
.action-row:last-child { border-bottom: 0; }
.action-row:active { background: #e7eef8; }
.action-main { flex: 1; min-width: 0; }
.action-title { font-size: 29rpx; line-height: 1.5; font-weight: 700; }
.action-description { margin-top: 8rpx; color: #5f6b78; font-size: 25rpx; line-height: 1.7; }
.arrow { margin-left: 20rpx; color: #2459be; font-size: 40rpx; }
.service-links { display: flex; flex-wrap: wrap; gap: 12rpx; }
.service-links button { margin: 0; padding: 18rpx 20rpx; line-height: 1.5; font-size: 25rpx; color: #2459be; background: #edf2f7; }
.service-links button:active { background: #e7eef8; }
.service-note { margin-top: 14rpx; font-size: 23rpx; line-height: 1.7; color: #5f6b78; }
