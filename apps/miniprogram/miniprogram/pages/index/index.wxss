.hero {
  padding: 30rpx;
  background: linear-gradient(145deg, #ffffff 0%, #eef4ff 100%);
}

.brand-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.brand,
.brand-sub {
  display: block;
}

.brand {
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.brand-sub {
  margin-top: 10rpx;
  color: #6f7682;
  font-size: 24rpx;
}

.consult {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #2f6fed;
  color: #ffffff;
  font-size: 24rpx;
}

.search-box {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding: 22rpx 24rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 18rpx;
}

.search-icon {
  margin-right: 14rpx;
  color: #7e8794;
  font-size: 32rpx;
}

.search-placeholder {
  color: #a0a6af;
  font-size: 26rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 22rpx;
}

.quick-item {
  min-height: 210rpx;
  padding: 24rpx;
}

.quick-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.quick-icon.blue { background: #eaf1ff; color: #2f6fed; }
.quick-icon.violet { background: #f1edff; color: #7255e7; }
.quick-icon.cyan { background: #e9f8fb; color: #1589a5; }
.quick-icon.orange { background: #fff2e5; color: #db7a17; }

.quick-title,
.quick-desc {
  display: block;
}

.quick-title {
  margin-top: 18rpx;
  font-size: 29rpx;
  font-weight: 700;
}

.quick-desc {
  margin-top: 8rpx;
  color: #8a8f98;
  font-size: 22rpx;
  line-height: 1.5;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 38rpx 4rpx 18rpx;
}

.more {
  color: #2f6fed;
  font-size: 23rpx;
}

.case-scroll {
  width: 100%;
}

.case-row {
  display: flex;
  gap: 18rpx;
  width: max-content;
  padding-bottom: 4rpx;
}

.case-card {
  box-sizing: border-box;
  width: 430rpx;
  padding: 26rpx;
}

.case-tag,
.case-title,
.case-result,
.case-note {
  display: block;
}

.case-tag {
  color: #2f6fed;
  font-size: 22rpx;
}

.case-title {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.case-result {
  margin-top: 8rpx;
  color: #343a45;
  font-size: 25rpx;
}

.case-note {
  margin-top: 22rpx;
  color: #a0a6af;
  font-size: 20rpx;
}

.course-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.course-card {
  display: flex;
  align-items: center;
  padding: 22rpx;
}

.course-cover {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  border-radius: 18rpx;
  background: #eef4ff;
  color: #2f6fed;
  font-size: 24rpx;
  font-weight: 700;
}

.course-main {
  flex: 1;
  margin-left: 22rpx;
}

.course-title,
.course-meta {
  display: block;
}

.course-title {
  font-size: 28rpx;
  font-weight: 700;
}

.course-meta {
  margin-top: 12rpx;
  color: #8a8f98;
  font-size: 22rpx;
}

.arrow {
  color: #b6bbc3;
  font-size: 40rpx;
}

.update-list {
  padding: 4rpx 24rpx;
}

.update-row {
  display: flex;
  align-items: center;
  min-height: 126rpx;
  border-bottom: 1rpx solid #eef0f4;
}

.update-row:last-child {
  border-bottom: 0;
}

.update-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  background: #2f6fed;
}

.update-main {
  flex: 1;
}

.update-school,
.update-title {
  display: block;
}

.update-school {
  color: #2f6fed;
  font-size: 21rpx;
}

.update-title {
  margin-top: 6rpx;
  font-size: 25rpx;
}

.update-date {
  color: #a0a6af;
  font-size: 21rpx;
}


.course-cover-image {
  width: 104rpx;
  height: 104rpx;
  flex-shrink: 0;
  border-radius: 18rpx;
  background: #eef4ff;
}


.brand-intro {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 22rpx;
  padding: 24rpx 26rpx;
  background: linear-gradient(145deg, #f8fbff 0%, #eef4ff 100%);
}

.brand-intro-eyebrow,
.brand-intro-title,
.brand-intro-desc {
  display: block;
}

.brand-intro-eyebrow {
  color: #7d8eaa;
  font-size: 18rpx;
  letter-spacing: 2rpx;
}

.brand-intro-title {
  margin-top: 8rpx;
  color: #253a60;
  font-size: 27rpx;
  font-weight: 800;
}

.brand-intro-desc {
  margin-top: 7rpx;
  color: #7f8792;
  font-size: 21rpx;
}

.brand-intro-arrow {
  color: #2f6fed;
  font-size: 42rpx;
}
