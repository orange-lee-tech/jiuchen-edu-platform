/* Jiuchen vivid palette: deep navy / cobalt / teal / amber, dense information architecture. */
.home-page {box-sizing:border-box;min-height:100vh;padding:24rpx 24rpx calc(42rpx + env(safe-area-inset-bottom));background:#eaf1f7;color:#112541;}
.home-intro{padding:32rpx 28rpx 30rpx;background:#143869;color:#fff;border-left:8rpx solid #f2b544;border-bottom:5rpx solid #0a8b89;border-radius:10rpx;}
.eyebrow,.home-title,.home-description,.home-caption,.section-heading,.action-title,.action-description,.service-note{display:block;}
.eyebrow{font-size:22rpx;font-weight:700;color:#ffd781;letter-spacing:1rpx;}
.home-title{font-size:43rpx;line-height:1.35;font-weight:800;margin-top:14rpx;}
.home-description{font-size:25rpx;line-height:1.6;color:#e6f0ff;margin-top:12rpx;}
button{box-sizing:border-box;margin-left:0;margin-right:0;border-radius:8rpx;white-space:normal;}
button::after{border:0;}
.home-primary{display:flex;width:100%;justify-content:center;align-items:center;margin:22rpx 0 0;min-height:82rpx;padding:12rpx 24rpx;background:#ffc94e;color:#132f57;font-size:29rpx;line-height:1.4;font-weight:800;}
.home-primary:active{background:#ffe194;}
.home-caption{font-size:22rpx;line-height:1.5;color:#d2e5fc;margin-top:14rpx;}
.section-heading{font-size:31rpx;font-weight:800;line-height:1.45;margin:25rpx 0 14rpx;color:#142b49;}
.action-list{display:flex;flex-direction:column;gap:12rpx;width:100%;}
.action-row{display:flex;align-items:center;gap:18rpx;width:100%;box-sizing:border-box;min-height:126rpx;padding:22rpx 18rpx;background:#fff;border-radius:8rpx;border:1rpx solid #d4e1ed;border-left:7rpx solid #2c67d5;text-align:left;}
.action-planning{border-left-color:#08a49b;background:#f4fffd;}
.action-news{border-left-color:#efa92f;background:#fffdf4;}
.action-pressed{background:#dfeafa;}
.action-symbol{display:flex;align-items:center;justify-content:center;flex:0 0 62rpx;width:62rpx;height:62rpx;background:#e6efff;border-radius:7rpx;}
.action-planning .action-symbol{background:#d6f5ef;}
.action-news .action-symbol{background:#fff0c7;}
.action-icon{width:38rpx;height:38rpx;flex:none;}
.action-main{display:flex;flex:1 1 0;min-width:0;flex-direction:column;align-items:stretch;}
.action-title{font-size:28rpx;font-weight:800;line-height:1.35;color:#122944;white-space:normal;word-break:break-word;}
.action-description{margin-top:6rpx;font-size:23rpx;line-height:1.5;color:#4a6077;white-space:normal;word-break:break-word;}
.arrow{flex:0 0 26rpx;color:#205ccd;font-size:42rpx;line-height:1;text-align:right;}
.service-section{margin-top:24rpx;border-top:4rpx solid #e5a838;padding-bottom:14rpx;}
.service-links{display:flex;flex-wrap:wrap;gap:12rpx;width:100%;}
.service-link{display:flex;box-sizing:border-box;justify-content:space-between;align-items:center;gap:6rpx;flex:0 0 calc(50% - 6rpx);min-width:0;min-height:92rpx;padding:15rpx 18rpx;color:#114889;background:#fff;border:1rpx solid #d2e2ef;border-radius:8rpx;font-size:25rpx;font-weight:750;line-height:1.4;}
.service-link text{color:#1659a4;font-size:32rpx;}
.service-advisor{background:#dcf6f0;color:#087b72;border-color:#8be0d1;}
.service-website{background:#e5eeff;color:#1948a2;}
.service-pressed{opacity:.78;}
.link-icon{width:30rpx;height:30rpx;flex:none;}
.service-note{font-size:21rpx;line-height:1.5;color:#4f6173;margin-top:13rpx;}
