.home-page { padding-top: 20rpx; }
.hero { padding: 34rpx; background: linear-gradient(145deg, #ffffff 0%, #edf4ff 100%); }
.brand-row, .row-between { display: flex; align-items: center; justify-content: space-between; }
.eyebrow { display: block; color: #246bfd; font-size: 23rpx; font-weight: 600; }
.hero-title { display: block; margin-top: 12rpx; max-width: 500rpx; font-size: 42rpx; line-height: 1.35; font-weight: 800; color: #172033; }
.hero-badge { width: 86rpx; height: 86rpx; border-radius: 24rpx; background: #246bfd; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; }
.search-box { margin-top: 30rpx; height: 84rpx; padding: 0 26rpx; border-radius: 20rpx; background: rgba(255,255,255,.9); display:flex; align-items:center; gap:16rpx; }
.search-icon { font-size: 34rpx; color:#8a91a1; }
.search-placeholder { color:#a0a6b4; font-size:26rpx; }
.section-block { margin-top: 34rpx; }
.section-heading { margin-bottom: 20rpx; }
.quick-grid { display:grid; grid-template-columns: 1fr 1fr; gap:18rpx; }
.quick-card { padding: 26rpx; min-height: 190rpx; }
.quick-icon { width:54rpx; height:54rpx; border-radius:16rpx; background:#246bfd; color:#fff; display:flex; align-items:center; justify-content:center; font-size:24rpx; font-weight:700; }
.quick-title { display:block; margin-top:20rpx; font-size:29rpx; font-weight:700; color:#172033; }
.quick-desc { display:block; margin-top:8rpx; color:#8a91a1; font-size:22rpx; line-height:1.55; }
.more-link { color:#246bfd; font-size:24rpx; }
.course-scroll { width:100%; white-space:nowrap; }
.course-row { display:flex; gap:18rpx; padding-bottom:8rpx; }
.course-card { flex:0 0 300rpx; width:300rpx; overflow:hidden; padding-bottom:24rpx; }
.course-cover { height:150rpx; padding:22rpx; background:linear-gradient(135deg,#246bfd,#6d9cff); box-sizing:border-box; }
.course-cover-tag { color:#fff; font-size:22rpx; }
.course-title { display:block; margin:20rpx 20rpx 0; font-size:27rpx; font-weight:700; }
.course-meta { display:block; margin:8rpx 20rpx 0; font-size:22rpx; color:#8a91a1; }
.latest { padding:28rpx; }
.update-row { display:flex; align-items:flex-start; gap:16rpx; padding:20rpx 0; border-top:1rpx solid #eef0f4; }
.dot { width:12rpx; height:12rpx; margin-top:12rpx; border-radius:50%; background:#246bfd; flex:none; }
.update-text { font-size:25rpx; line-height:1.55; color:#4d5566; }
