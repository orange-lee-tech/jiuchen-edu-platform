.teacher-head {
  margin: 8rpx 4rpx 24rpx;
}

.page-title,
.review-student,
.review-title,
.review-meta,
.student-name,
.student-meta,
.student-stage {
  display: block;
}

.page-title { font-size: 38rpx; font-weight: 800; }

.section-head {
  display: flex;
  justify-content: space-between;
  margin: 28rpx 4rpx 14rpx;
}

.section-title { font-size: 28rpx; font-weight: 800; }

.pending-list,
.student-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.pending-review,
.student-card,
.empty {
  padding: 24rpx;
}

.review-student { color: #245681; font-size: 21rpx; font-weight: 700; }
.review-title { margin-top: 8rpx; font-size: 27rpx; font-weight: 750; }
.review-meta,
.student-meta,
.student-stage { margin-top: 7rpx; color: #5f6b78; font-size: 21rpx; }

.review-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 18rpx;
}

.reject-button,
.approve-button {
  margin: 0;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.reject-button { background: #fff; color: #a64e47; }
.approve-button { background: #2f6fed; color: #fff; }
.approve-button::after { border: 0; }

.student-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.student-name { font-size: 27rpx; font-weight: 750; }
.arrow { color: #245681; font-size: 24rpx; }
.empty { color: #5f6b78; font-size: 23rpx; line-height: 1.7; }

.retry-button { margin: 18rpx 0 0; background: #eaf2fa; color: #173e67; font-size: 24rpx; }

.student-actions{display:flex;flex-direction:column;align-items:flex-end;gap:8rpx;}
.edit-mini{margin:0;background:#eaf2fa;border-radius: 6rpx;color:#173e67;font-size:21rpx;line-height:56rpx;padding:0 14rpx;}
