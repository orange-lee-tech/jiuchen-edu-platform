.page{padding:32rpx;color:#173e67}.title{display:block;font-size:36rpx;font-weight:600}.note{display:block;font-size:25rpx;line-height:1.8;color:#697584;margin:24rpx 0}.card{padding:28rpx;background:#fffdf9;border-radius:20rpx}.picker,input,textarea{display:block;box-sizing:border-box;width:100%;padding:20rpx;background:#f4f2ed;border-radius:10rpx;margin:20rpx 0;font-size:28rpx}textarea{height:180rpx}.card button{background:#173e67;color:#fffdf9;margin-top:24rpx}.card .secondary{background:#f4f2ed;color:#173e67}.error{color:#a34738;margin:24rpx 0}.receipt{padding:24rpx 0;word-break:break-all}.receipt text{display:block;font-size:25rpx;line-height:1.8}
