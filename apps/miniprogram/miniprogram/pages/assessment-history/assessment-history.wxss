.history-page { min-height: 100vh; box-sizing: border-box; padding: 28rpx 24rpx 70rpx; background: #f4f2ed; }
.hero { padding: 16rpx 6rpx 26rpx; }
.title, .targets, .empty-title, .empty-desc { display: block; }
.title { color: #173e67; font-size: 38rpx; font-weight: 800; }
.assessment-list { display: flex; flex-direction: column; gap: 18rpx; }
.assessment-card, .state-card { padding: 26rpx; border: 1rpx solid #dbe3e8; border-radius: 8rpx; background: #fffdf9; }
.card-head, .card-foot { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.school { flex: 1; color: #173e67; font-size: 26rpx; font-weight: 800; }
.status { padding: 6rpx 14rpx; border-radius: 999rpx; background: #eef1f5; color: #6f7680; font-size: 19rpx; }
.status.success { background: #e9f8ef; color: #278052; }
.status.progress { background: #eef4ff; color: #3567be; }
.status.danger { background: #fff0ed; color: #b45149; }
.targets { margin-top: 18rpx; color: #526273; font-size: 22rpx; line-height: 1.6; }
.card-foot { margin-top: 22rpx; color: #9aa0aa; font-size: 20rpx; }
.link { color: #245681; font-weight: 700; }
.empty-title { color: #173e67; font-size: 28rpx; font-weight: 800; text-align: center; }
.empty-desc { margin: 14rpx 0 24rpx; color: #526273; font-size: 22rpx; line-height: 1.6; text-align: center; }
.primary { border-radius: 8rpx; background: #173e67; color: #fff; font-size: 24rpx; font-weight: 700; }
.primary::after { border: 0; }
