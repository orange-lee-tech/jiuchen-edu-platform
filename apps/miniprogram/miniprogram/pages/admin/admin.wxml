<auth-gate />
<view class="admin-page">
  <view class="admin-head">
    <text class="admin-title">{{section === 'admin-users' ? '用户与内部编号' : section === 'admin-assignments' ? '师生分配' : section === 'admin-readonly' ? '只读切换身份' : section === 'admin-analytics' ? 'AI 评估与购买统计' : section === 'admin-controls' ? '商业服务管理' : '资讯运营'}}</text>
  </view>

  <view class="admin-quick-return" bindtap="onReturnWorkspace">‹ 返回管理工作台</view>
  <view wx:if="{{loading}}" class="card">正在读取最新管理数据…</view>
  <view wx:elif="{{loadError}}" class="card"><text class="card-title">数据未能读取</text><text class="card-note">{{loadError}}</text><button class="primary" bindtap="loadData">重新读取</button></view>

  <block wx:elif="{{section === 'admin-users'}}">
    <view class="list-toolbar"><text class="card-title">内部编号</text><button class="mini" disabled="{{actionLoading}}" bindtap="onNewEntry">新增 / 绑定</button><button class="mini" bindtap="onOpenMyIdentity">我的兼任身份</button></view>
    <view wx:if="{{formMode === 'create'}}" class="card form-card">
      <text class="card-title">生成内部ID</text>
      <picker range="{{idTypes}}" range-key="label" value="{{newIdTypeIndex}}" bindchange="onIdTypeChange">
        <view class="picker-field">{{idTypes[newIdTypeIndex].label}} ›</view>
      </picker>
      <input class="input" value="{{newIdName}}" placeholder="姓名（学生/老师可填写）" bindinput="onNameInput" />
      <button class="primary" loading="{{actionLoading}}" disabled="{{actionLoading}}" bindtap="onCreateId">生成新编号</button><button class="secondary" disabled="{{actionLoading}}" bindtap="onCloseForm">取消</button>
    </view>

    <view wx:if="{{formMode === 'bind'}}" class="card form-card">
      <text class="card-title">绑定游客账号</text>
      <picker range="{{availableIds}}" range-key="businessId" value="{{bindIdIndex}}" bindchange="onBindIdChange">
        <view class="picker-field">{{availableIds.length ? availableIds[bindIdIndex].businessId : '暂无可用ID'}} ›</view>
      </picker>
      <picker range="{{guestUsers}}" range-key="displayLabel" value="{{bindUserIndex}}" bindchange="onBindUserChange">
        <view class="picker-field">{{guestUsers.length ? guestUsers[bindUserIndex].displayLabel : '暂无可绑定账号'}} ›</view>
      </picker>
      <button class="primary" loading="{{actionLoading}}" disabled="{{actionLoading || !availableIds.length || !guestUsers.length}}" bindtap="onBindId">确认绑定账号</button><button class="secondary" disabled="{{actionLoading}}" bindtap="onCloseForm">取消</button>
    </view>

    <view class="card">
      <input class="input" placeholder="搜索内部编号" value="{{idQuery}}" bindinput="onIdSearch" />
      <picker range="{{idFilters}}" value="{{idFilter}}" bindchange="onIdFilter"><view class="picker-field">{{idFilters[idFilter]}} · 匹配 {{visibleIds.length}} 个 ›</view></picker>
      <view wx:if="{{!visibleIds.length}}" class="card-note">没有匹配的编号，请调整搜索或状态。</view>
      <view wx:for="{{visibleIds}}" wx:key="id" class="id-row">
        <text class="row-title">{{item.entityLabel}}</text>
        <text class="id-code" selectable>{{item.businessId}}</text>
        <view class="id-meta"><text>{{item.typeLabel}}</text><text class="status {{item.status}}">{{item.statusLabel}}</text><text wx:if="{{item.own}}">本人编号</text><text wx:if="{{item.accountLabel}}">{{item.accountLabel}}</text></view>
        <text wx:if="{{item.type === 'student'}}" class="row-desc">{{item.schoolMajorLabel}}</text>
        <text wx:if="{{item.userId && item.profileLabel}}" class="state-note">资料：{{item.profileLabel}}</text>
        <text wx:if="{{item.userId && item.displayName && item.displayName !== item.name}}" class="row-desc">账号显示名：{{item.displayName}}（不等于正式档案姓名）</text>
        <text wx:if="{{item.type === 'student' && item.userId}}" class="row-desc">学业阶段：{{item.currentStage || '资料待完善'}}</text>
        <text wx:if="{{item.type === 'student' && item.assignmentState === 'unassigned'}}" class="state-note">未分配老师</text>
        <text wx:if="{{item.type === 'teacher' && item.userId}}" class="state-note">{{item.assignmentLabel}}</text>
        <text wx:if="{{item.type === 'teacher' && item.userId}}" class="row-desc">实际负责学员：{{item.assignmentCount == null ? '来源未记录' : item.assignmentCount + ' 人'}}</text>
        <text wx:if="{{item.type === 'admin'}}" class="state-note">{{item.assignmentLabel}}</text>
        <view class="id-actions"><button class="mini copy" data-id="{{item.id}}" bindtap="onCopyId">复制编号</button><button wx:if="{{item.actions.length}}" class="mini" disabled="{{actionLoading}}" data-id="{{item.id}}" bindtap="onIdActions">{{item.actions[0] === '暂停访问' ? '暂停 / 更多' : item.actions[0] === '恢复编号' ? '恢复 / 更多' : '绑定 / 更多'}}</button></view>
      </view>
    </view>
    <view class="card visitor-card"><text class="card-title">未绑定身份账号</text><text class="visitor-count">{{unboundAccountCount}}</text><text class="card-note">来自真实普通账号记录，仅展示数量；不把未绑定账号冒充学员，也不展示昵称作为实名。</text></view>
    <view class="card"><text class="card-title">正式账号</text><text class="card-note">账号显示名不等于实名。正式身份以内部编号与已绑定档案为准；资料缺失时显示待完善。</text><input class="input" placeholder="搜索显示名或账号编号" value="{{userQuery}}" bindinput="onUserSearch" /><view wx:if="{{!visibleUsers.length}}" class="card-note">没有匹配的正式账号。</view><view wx:for="{{visibleUsers}}" wx:key="id" class="account-row"><text class="row-title">{{item.displayLabel}}</text><text class="row-desc">{{item.roleLabel}} · {{item.statusLabel}}</text><text class="row-desc">账号加入：{{item.joinedLabel}}</text><text class="account-code" selectable>{{item.id}}</text></view></view>
  </block>

  <block wx:elif="{{section === 'admin-controls'}}">
    <view class="control-switch">
      <view class="control-switch-item {{controlModule === 'ai' ? 'selected' : ''}}" data-module="ai" bindtap="onControlModule">AI 服务管理</view>
      <view class="control-switch-item {{controlModule === 'credits' ? 'selected' : ''}}" data-module="credits" bindtap="onControlModule">评估次数管理</view>
    </view>
    <block wx:if="{{controlModule === 'ai'}}">
      <view class="card control-status">
        <text class="control-eyebrow">当前全局 AI · 版本 {{keyHead.version}}</text>
        <text class="control-active-title">{{activeKey ? activeKey.label : '尚无生效服务'}}</text>
        <text class="card-note">状态：{{keyCurrentStatus}} · 实际来源：{{keySourceLabel}}</text>
        <text class="card-note">{{activeKey ? activeKey.provider + ' · ' + activeKey.model + ' · 对象版本 ' + activeKey.version : '保存第一个服务后自动生效'}}</text>
        <text wx:if="{{activeKey}}" class="card-note">最近报告格式测试：{{activeKey.lastTestResult === 'passed' ? '通过' : activeKey.lastTestResult === 'failed' ? '失败' : '未测试'}}</text>
        <text class="card-note">密钥由服务端加密保存。连接测试会调用供应商，可能产生费用。</text>
        <button wx:if="{{keyHead.activeObjectId}}" class="secondary" data-action="disable" data-id="{{keyHead.activeObjectId}}" disabled="{{actionLoading}}" bindtap="onOpenKeyAction">停用服务</button>
      </view>
      <view class="card" wx:if="{{keyObjectsReady}}">
        <view class="list-toolbar"><text class="card-title">服务对象</text><button class="mini" bindtap="onToggleKeyForm">{{keyFormOpen ? '收起' : '＋ 新增服务'}}</button></view>
        <view wx:if="{{keyFormOpen}}" class="control-form">
          <text class="row-desc">服务商</text>
          <picker range="{{aiServices}}" range-key="name" value="{{keyProviderIndex}}" bindchange="onProviderChange"><view class="picker-field">{{aiServices[keyProviderIndex].name}} ›</view></picker>
          <text class="row-desc">文本模型</text>
          <picker range="{{keyModelOptions}}" range-key="label" value="{{keyModelIndex}}" bindchange="onModelChange"><view class="picker-field">{{keyModelOptions[keyModelIndex].label}} ›</view></picker>
          <text class="card-note">{{keyPresetNote}}</text>
          <text class="row-desc">精确模型 ID · 可编辑</text><input class="input" data-name="keyModel" value="{{keyModel}}" bindinput="onKeyObjectInput" />
          <text class="row-desc">HTTPS API 服务地址 · 可编辑</text><input class="input" data-name="keyApiBaseUrl" value="{{keyApiBaseUrl}}" bindinput="onKeyObjectInput" />
          <text class="row-desc">连接名称</text><input class="input" data-name="keyLabel" value="{{keyLabel}}" placeholder="例如 评估主模型" bindinput="onKeyObjectInput" />
          <text class="row-desc">API Key</text><input class="input" password data-name="apiKeyInput" value="{{apiKeyInput}}" bindinput="onKeyObjectInput" />
          <text class="row-desc">备注 · 可选</text><input class="input" data-name="keyNote" value="{{keyNote}}" bindinput="onKeyObjectInput" />
          <text class="row-desc">回答严谨度 {{keyRigor}} / 10</text><slider min="1" max="10" step="1" value="{{keyRigor}}" activeColor="#b98a2e" backgroundColor="#dce5f0" bindchange="onRigorChange" /><view class="rigor-range"><text>灵活</text><text>严谨</text></view>
          <text class="row-desc">新对象六位口令</text><input class="input" password type="number" maxlength="6" data-name="keyObjectPin" value="{{keyObjectPin}}" bindinput="onKeyObjectInput" />
          <button class="primary" disabled="{{actionLoading}}" loading="{{actionLoading}}" bindtap="onCreateKeyObject">加密保存{{keyHead.initialized ? '候选服务' : '并启用首个服务'}}</button>
        </view>
        <view wx:if="{{keyAction}}" id="key-action-panel" class="control-pin-panel">
          <text class="card-title">{{keyAction === 'activate' ? '启用服务' : keyAction === 'disable' ? '停用服务' : keyAction === 'test' ? '验证连接及报告格式' : keyAction === 'reveal' ? '创建者查看' : keyAction === 'archive' ? '归档服务' : keyAction === 'copy' ? '复制凭据新建模型候选' : '设置对象口令'}} · {{keyActionLabel}}</text>
          <text class="card-note" wx:if="{{keyAction === 'reveal'}}">此操作仅限该服务对象的创建管理员，请输入该对象的六位口令。</text>
          <text class="card-note" wx:elif="{{keyAction === 'test'}}">测试会调用供应商，可能产生费用；通过后仍需真实评估验证报告入库。</text>
          <text class="card-note" wx:elif="{{keyAction === 'copy'}}">仅限来源对象创建者。将沿用同一服务商、HTTPS 地址及加密凭据；新候选不会自动启用，报告格式需单独验证。</text>
          <text class="row-desc">{{keyAction === 'activate' || keyAction === 'disable' || keyAction === 'archive' || keyAction === 'setup' || keyAction === 'copy' ? '当前控制口令' : '该对象六位口令'}}</text>
          <input class="input" password type="number" maxlength="6" data-name="keyActionPin" value="{{keyActionPin}}" bindinput="onKeyActionPinInput" />
          <block wx:if="{{keyAction === 'copy'}}">
            <text class="row-desc">来源对象口令</text><input class="input" password type="number" maxlength="6" data-name="keyCopySourcePin" value="{{keyCopySourcePin}}" bindinput="onKeyActionPinInput" />
            <text class="row-desc">新模型候选名称</text><input class="input" data-name="keyCopyLabel" value="{{keyCopyLabel}}" bindinput="onKeyActionPinInput" />
            <text class="row-desc">同服务商文档预设型号</text><picker wx:if="{{keyCopyModels.length}}" range="{{keyCopyModels}}" range-key="label" value="{{keyCopyModelIndex}}" bindchange="onCopyModelChange"><view class="picker-field">{{keyCopyModels[keyCopyModelIndex].label}} ›</view></picker>
            <text class="row-desc">精确模型 ID · 可手工修改</text><input class="input" data-name="keyCopyModel" value="{{keyCopyModel}}" bindinput="onKeyActionPinInput" />
            <text class="card-note">{{keyCopyModels.length ? '文档预设仅表示已核对公开型号，仍需本账号连接测试；手工输入型号未验证。' : '当前服务商没有本地文档预设，手工输入型号需连接测试。'}}</text>
            <text class="row-desc">备注 · 可选</text><input class="input" data-name="keyCopyNote" value="{{keyCopyNote}}" bindinput="onKeyActionPinInput" />
          </block>
          <block wx:if="{{keyAction === 'activate' || keyAction === 'setup' || keyAction === 'copy'}}"><text class="row-desc">{{keyAction === 'activate' ? '目标对象口令' : '新候选对象口令'}}</text><input class="input" password type="number" maxlength="6" data-name="keyActionTargetPin" value="{{keyActionTargetPin}}" bindinput="onKeyActionPinInput" /></block>
          <button class="primary" disabled="{{actionLoading}}" loading="{{actionLoading}}" bindtap="onConfirmKeyAction">确认本次操作</button>
          <button class="secondary" disabled="{{actionLoading}}" bindtap="onCancelKeyAction">取消</button>
        </view>
        <view wx:for="{{keyObjects}}" wx:key="id" class="list-row">
          <view class="row-main"><text class="row-title">{{item.label}} · {{item.status === 'active' ? '当前已启用' : item.status === 'candidate' ? '候选服务' : item.status === 'disabled' ? '已停用' : '已归档'}}</text><text class="row-desc">{{item.provider}} · {{item.model}} · 版本 {{item.version}}</text><text class="row-desc" wx:if="{{item.sourceObjectId}}">模型候选复制自对象 {{item.sourceObjectId}}</text><text class="row-desc">{{item.note || '无备注'}} · 最近测试 {{item.lastTestResult === 'passed' ? '通过' : item.lastTestResult === 'failed' ? '失败' : '未测试'}}</text></view>
          <button wx:if="{{item.status !== 'active' && item.status !== 'archived' && item.hasObjectPin}}" class="mini" data-action="activate" data-id="{{item.id}}" bindtap="onOpenKeyAction">启用此服务</button>
          <button wx:if="{{!item.hasObjectPin}}" class="mini" data-action="setup" data-id="{{item.id}}" bindtap="onOpenKeyAction">设置对象口令</button>
          <button wx:if="{{item.status !== 'archived' && item.hasObjectPin}}" class="mini" data-action="test" data-id="{{item.id}}" bindtap="onOpenKeyAction">验证连接及报告格式</button>
          <button wx:if="{{item.status !== 'archived' && item.hasObjectPin}}" class="mini" data-action="reveal" data-id="{{item.id}}" bindtap="onOpenKeyAction">创建者查看</button>
          <button wx:if="{{item.status !== 'archived' && item.status !== 'disabled' && item.hasObjectPin}}" class="mini" data-action="copy" data-id="{{item.id}}" bindtap="onOpenKeyAction">复制凭据换模型</button>
          <button wx:if="{{item.status !== 'active' && item.status !== 'archived'}}" class="mini danger" data-action="archive" data-id="{{item.id}}" bindtap="onOpenKeyAction">归档</button>
        </view>
      </view>
    </block>
    <block wx:else>
      <view class="card control-status"><text class="control-eyebrow">当前次数方案 · 版本 {{planHead.version}}</text><text class="control-active-title">{{activePlan ? activePlan.name : '新订单暂无生效方案'}}</text><text class="card-note">{{checkoutStatusLabel}}。旧订单保留购买时的金额和次数。</text></view>
      <view class="card"><text class="card-title">免费赠送次数</text><text class="card-note">游客首次 {{controlSettings.settings.guestFree}} 次；学员累计 {{controlSettings.settings.studentTotalFree}} 次。修改只作用于此后尚未领取的额度。</text>
        <text class="row-desc">游客首次</text><input class="input" type="number" data-name="guestFreeInput" value="{{guestFreeInput}}" bindinput="onControlInput" />
        <text class="row-desc">学员累计</text><input class="input" type="number" data-name="studentFreeInput" value="{{studentFreeInput}}" bindinput="onControlInput" />
        <input wx:if="{{controlSettings.configured}}" class="input" password type="number" maxlength="6" data-name="settingsOldPin" value="{{settingsOldPin}}" placeholder="现有设置口令" bindinput="onControlInput" />
        <input class="input" password type="number" maxlength="6" data-name="settingsNewPin" value="{{settingsNewPin}}" placeholder="本次设置的六位口令" bindinput="onControlInput" />
        <button class="primary" disabled="{{actionLoading}}" bindtap="onSaveSettings">保存免费次数</button>
        <button class="secondary" disabled="{{actionLoading}}" bindtap="onSaveSettingsDraft">保存个人草稿</button>
        <button wx:if="{{settingsDraft.saved && settingsDraft.settings}}" class="secondary" disabled="{{actionLoading || settingsDraft.basedOnVersion !== controlSettings.version}}" data-box="settings" bindtap="onActivateDraft">启用个人草稿</button>
      </view>
      <view class="card" wx:if="{{creditPlansReady}}"><view class="list-toolbar"><text class="card-title">固定售价兑换次数</text><button class="mini" bindtap="onTogglePlanForm">{{planFormOpen ? '收起' : '＋ 新建方案'}}</button></view>
        <text wx:if="{{!fixedPriceCatalogOk}}" class="control-warning">服务端商品价格与固定目录不一致，已阻止创建方案及真实入账；请核对微信商户商品配置。</text>
        <view wx:if="{{planFormOpen}}" class="control-form">
          <text class="row-desc">JC000 · {{planPriceLabels.JC000}}（iOS 不可购买）</text><input class="input" type="number" data-name="planJc000" value="{{planJc000}}" bindinput="onPlanInput" placeholder="兑换次数" />
          <text class="row-desc">JC001 体验包 · {{planPriceLabels.JC001}}</text><input class="input" type="number" data-name="planJc001" value="{{planJc001}}" bindinput="onPlanInput" placeholder="兑换次数" />
          <text class="row-desc">JC002 五次包 · {{planPriceLabels.JC002}}</text><input class="input" type="number" data-name="planJc002" value="{{planJc002}}" bindinput="onPlanInput" placeholder="兑换次数" />
          <text class="row-desc">JC003 十次包 · {{planPriceLabels.JC003}}</text><input class="input" type="number" data-name="planJc003" value="{{planJc003}}" bindinput="onPlanInput" placeholder="兑换次数" />
          <text class="control-warning">{{planCostNotice}}</text>
          <input class="input" data-name="planName" value="{{planName}}" bindinput="onPlanInput" placeholder="方案名称" />
          <input class="input" data-name="planNote" value="{{planNote}}" bindinput="onPlanInput" placeholder="备注 · 可选" />
          <input class="input" type="digit" data-name="planCostYuan" value="{{planCostYuan}}" bindinput="onPlanInput" placeholder="单次模型成本估算（元）· 可不填" />
          <input class="input" password type="number" maxlength="6" data-name="planObjectPin" value="{{planObjectPin}}" bindinput="onPlanInput" placeholder="新方案六位口令" />
          <button class="primary" disabled="{{actionLoading || !fixedPriceCatalogOk}}" bindtap="onCreateCreditPlan">保存{{planHead.initialized ? '候选方案' : '并启用首套方案'}}</button>
        </view>
        <view wx:if="{{creditPlans.length}}" class="control-pin-panel"><input class="input" password type="number" maxlength="6" data-name="planControlPin" value="{{planControlPin}}" bindinput="onPlanInput" placeholder="当前方案控制口令" /><input class="input" password type="number" maxlength="6" data-name="planTargetPin" value="{{planTargetPin}}" bindinput="onPlanInput" placeholder="目标方案口令" /><button wx:if="{{planHead.activePlanId}}" class="secondary" disabled="{{actionLoading}}" bindtap="onDisableCreditPlan">暂停新订单</button></view>
        <view wx:for="{{creditPlans}}" wx:key="id" class="list-row"><view class="row-main"><text class="row-title">{{item.name}} · {{item.status === 'active' ? '当前已启用' : item.status === 'candidate' ? '候选方案' : item.status === 'disabled' ? '已停用' : '已归档'}}</text><text class="row-desc">JC000 {{item.counts.JC000}} / JC001 {{item.counts.JC001}} / JC002 {{item.counts.JC002}} / JC003 {{item.counts.JC003}} 次</text><text class="row-desc">成本：{{item.costVerificationLabel}} · {{item.note || '无备注'}}</text></view><button wx:if="{{!item.hasObjectPin}}" class="mini" data-id="{{item.id}}" bindtap="onSetupLegacyPlanPin">设置口令</button><button wx:if="{{item.status !== 'active' && item.status !== 'archived' && item.hasObjectPin}}" class="mini" data-id="{{item.id}}" bindtap="onActivateCreditPlan">启用</button><button wx:if="{{item.status !== 'active' && item.status !== 'archived'}}" class="mini danger" data-id="{{item.id}}" bindtap="onArchiveCreditPlan">归档</button></view>
      </view>
    </block>
  </block>

  <block wx:elif="{{section === 'admin-readonly'}}">
    <view class="card readonly-notice">
      <text class="card-title">管理员 · 只读身份切换</text>
      <text class="card-note">可查看任何已建档学员与老师的专属信息。点击后仍使用自己的管理员登录身份，不会获得目标账号的修改、付款、上传或AI评估执行权限。</text>
    </view>
    <view class="card">
      <text class="card-title">全部学员</text>
      <view wx:for="{{students}}" wx:key="id" class="readonly-row" data-id="{{item.id}}" bindtap="onReadOnlyStudent">
        <view class="row-main"><text class="row-title">{{item.name}}</text><text class="row-desc">{{item.university || '院校待补充'}} · {{item.major || '专业待补充'}}</text><text class="row-desc">资料：{{item.profileLabel}} · 分配：{{item.assignmentLabel}}</text><text wx:if="{{item.accountDisplayName && item.accountDisplayName !== item.name}}" class="row-desc">账号显示名：{{item.accountDisplayName}}</text></view>
        <text class="readonly-go">{{item.canView === false ? '暂不可查看' : '查看 ›'}}</text>
      </view>
      <text wx:if="{{!students.length}}" class="card-note">暂无学员档案</text>
    </view>
    <view class="card">
      <text class="card-title">全部老师</text>
      <view wx:for="{{teachers}}" wx:key="id" class="readonly-row" data-id="{{item.id}}" bindtap="onReadOnlyTeacher">
        <view class="row-main"><text class="row-title">{{item.name}}</text><text class="row-desc">{{item.title || '职务待补充'}} · 资料：{{item.profileLabel}} · 分配：{{item.assignmentLabel}}</text></view>
        <text class="readonly-go">{{item.canView === false ? '暂不可查看' : '查看 ›'}}</text>
      </view>
      <text wx:if="{{!teachers.length}}" class="card-note">暂无老师档案</text>
    </view>
  </block>

  <block wx:elif="{{section === 'admin-assignments'}}">
    <view class="card">
      <text class="card-title">建立师生关系</text>
      <picker range="{{students}}" range-key="name" value="{{studentIndex}}" bindchange="onStudentChange">
        <view class="picker-field">{{students.length ? students[studentIndex].name : '暂无学员'}} ›</view>
      </picker>
      <text wx:if="{{students.length}}" class="card-note">学员建档：{{students[studentIndex].joinedLabel}}</text>
      <picker range="{{teachers}}" range-key="name" value="{{teacherIndex}}" bindchange="onTeacherChange">
        <view class="picker-field">{{teachers.length ? teachers[teacherIndex].name : '暂无老师'}} ›</view>
      </picker>
