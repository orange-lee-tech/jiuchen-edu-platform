        <picker range="{{mediaChoices}}" value="{{verifiedDraft.mediaType === 'video' ? 2 : verifiedDraft.mediaType === 'image' ? 1 : 0}}" bindchange="onVerifiedOfficialMedia"><view class="picker-field">{{verifiedDraft.mediaType === 'video' ? '视频原文（跳转公众号）' : verifiedDraft.mediaType === 'image' ? '贴图（站内图片）' : '图文（站内阅读）'}}</view></picker>
        <text wx:if="{{verifiedDraft.mediaType !== 'video'}}" class="verified-label">站内内容（必填）</text>
        <text wx:if="{{verifiedDraft.mediaType !== 'video'}}" class="card-note">每行一段文字或一张图片的完整 https://mmbiz.qpic.cn/ 链接，按公众号原稿顺序填写。贴图至少一张图片；勿填原文网页链接。</text>
        <textarea wx:if="{{verifiedDraft.mediaType !== 'video'}}" class="input verified-body" value="{{verifiedDraft.body}}" data-key="body" bindinput="onVerifiedOfficialInput" maxlength="30000" placeholder="正文第一段&#10;https://mmbiz.qpic.cn/..." />
        <button class="primary" loading="{{actionLoading}}" disabled="{{actionLoading}}" bindtap="onVerifiedOfficialSubmit">核对后提交补录</button>
      </view>
    </view>

    <view class="card">
      <text class="card-title">已同步内容与标签 · 待分类 {{pendingClassificationCount}} 篇</text>
      <button class="mini" bindtap="onNewsSort">{{newsUnclassifiedFirst ? '未分类优先' : '发表时间倒序'}} · 点击切换</button>
      <text class="card-note">默认按发表时间倒序，可切换未分类优先；添加标签后学员才可见。重新同步不会覆盖已有标签。留空保存会再次隐藏该文章对学员的展示。</text>
      <view wx:for="{{posts}}" wx:key="id" class="list-row news-row">
        <view class="row-main">
          <text class="row-title">{{item.title}}</text>
          <text class="row-desc">{{item.dateLabel}}</text>
          <text wx:if="{{item.lifecycleLabel}}" class="row-desc">{{item.lifecycleLabel}}</text>
          <text class="row-desc">{{item.source === 'wechat_official' ? (item.publicationTimeSource === 'admin_verified_publish_record' ? '管理员核实原文' : '服务号同步') : '九辰编辑'}} · {{item.status === 'active' ? '已发布' : '已隐藏'}}</text>
          <view class="tag-list">
            <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="tag-chip">{{tag}}</text>
            <text wx:if="{{item.tags.length === 0}}" class="tag-empty">未分类</text>
          </view>
        </view>
        <button class="mini" data-id="{{item.id}}" bindtap="onPreviewNews">预览正文</button>
        <button class="mini" data-id="{{item.id}}" bindtap="onEditNewsTags">管理标签</button>
      </view>
    </view>
  </block>
</view>
