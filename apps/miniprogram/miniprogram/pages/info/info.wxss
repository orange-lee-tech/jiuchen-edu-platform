.info-head{padding:10rpx 4rpx 22rpx}.tab-row{display:flex;padding:8rpx;margin-bottom:22rpx}.tab{flex:1;text-align:center;padding:18rpx 0;border-radius:16rpx;color:#7b8190;font-size:24rpx}.tab.active{background:#246bfd;color:#fff;font-weight:700}.news-list{display:flex;flex-direction:column;gap:18rpx}.news-card{display:flex;overflow:hidden}.news-cover{width:180rpx;min-height:150rpx;background:linear-gradient(145deg,#e8efff,#d7e5ff);display:flex;align-items:center;justify-content:center;color:#246bfd;font-size:23rpx;font-weight:700}.news-body{flex:1;padding:24rpx}.news-title{display:block;font-size:27rpx;line-height:1.5;font-weight:700}.news-source{display:block;margin-top:16rpx;color:#8a91a1;font-size:22rpx}.source-note{margin-top:24rpx;padding:28rpx}.source-title{display:block;font-size:27rpx;font-weight:700}.source-text{display:block;margin-top:12rpx;color:#7f8797;font-size:23rpx;line-height:1.7}