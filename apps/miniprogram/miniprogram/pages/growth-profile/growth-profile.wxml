<auth-gate />
<view class="growth-page">
  <view class="hero">
    <text class="title">我的本科成长履历</text>
    <text wx:if="{{refreshing}}" class="refresh-note">正在后台更新最新履历…</text>
    <text wx:elif="{{cacheState === 'stale'}}" class="refresh-note">已先显示本地缓存，正在尝试刷新</text>
  </view>

  <view wx:if="{{loading && !resume}}" class="state-card">正在整理你的履历…</view>
  <view wx:elif="{{error}}" class="state-card error-card">
    <text>{{error}}</text>
    <button class="retry-button" bindtap="onRetryLoad">重新读取</button>
  </view>

  <block wx:else>
    <view wx:if="{{!growthSchemaReady}}" class="schema-note">
      <text class="schema-title">当前展示基础档案</text>
      <text class="schema-desc">目前可以查看和编辑基础学业资料；其他成长经历暂不可用。</text>
    </view>

    <view class="section-card">
      <view class="section-head">
        <view>
          <text class="section-title">基础身份与学业</text>
        </view>
        <text wx:if="{{!readOnly}}" class="link" bindtap="onEditBaseProfile">修改 ›</text>
      </view>
      <view class="fact-grid">
        <view class="fact"><text class="fact-label">姓名</text><text class="fact-value">{{profile.identity.displayName || '待补充'}}</text></view>
        <view class="fact"><text class="fact-label">本科院校</text><text class="fact-value">{{profile.identity.university || '待补充'}}</text></view>
        <view class="fact"><text class="fact-label">专业</text><text class="fact-value">{{profile.identity.major || '待补充'}}</text></view>
        <view class="fact"><text class="fact-label">年级</text><text class="fact-value">{{profile.identity.currentGrade || '待补充'}}</text></view>
        <view class="fact"><text class="fact-label">绩点 / 均分</text><text class="fact-value">{{profile.identity.gpaText || '待补充'}}</text></view>
        <view class="fact"><text class="fact-label">专业排名</text><text class="fact-value">{{profile.identity.rankText || '待补充'}}</text></view>
      </view>
    </view>

    <view wx:if="{{growthSchemaReady && importCandidates.length}}" class="section-card import-card">
      <view class="section-head">
        <view>
          <text class="section-title">复用你已经填过的资料</text>
          <text class="section-sub">从历史评估中找到 {{importCandidates.length}} 条语言、科研或竞赛经历。确认后才会写入成长档案。</text>
        </view>
      </view>
      <view class="candidate-list">
        <view
          wx:for="{{importCandidates}}"
          wx:key="candidateKey"
          class="candidate {{item.selected ? 'selected' : ''}}"
          data-index="{{index}}"
          bindtap="onCandidateToggle"
        >
          <view class="candidate-check">{{item.selected ? '✓' : ''}}</view>
          <view class="candidate-main">
            <view class="candidate-head">
              <text class="record-type">{{item.typeLabel}}</text>
              <text class="candidate-title">{{item.record.title}}</text>
            </view>
            <text class="record-text">{{item.standardExpression}}</text>
          </view>
        </view>
      </view>
      <button
        class="confirm-button"
        loading="{{importing}}"
        disabled="{{importing || readOnly}}"
        bindtap="onConfirmAssessmentImport"
      >确认所选内容并同步到成长履历</button>
      <text class="confirm-note">未勾选的内容不会写入。资料变更后，可以重新生成简历和填表内容。</text>
    </view>

    <view class="section-card">
      <view class="section-head">
        <view>
          <text class="section-title">已确认经历</text>
          <text class="section-sub">{{records.length}} 条事实记录</text>
        </view>
        <button wx:if="{{growthSchemaReady && !readOnly}}" class="record-add" bindtap="onNewRecord">添加经历</button>
      </view>
      <view wx:if="{{records.length === 0}}" class="empty">
        目前还没有独立成长经历记录。既有评估中的语言、科研和竞赛资料可在确认后迁入，不会要求重新填写。
      </view>
      <view wx:else class="record-list">
        <view wx:for="{{records}}" wx:key="id" class="record">
          <view class="record-head">
            <text class="record-type">{{item.typeLabel}}</text>
            <text class="record-source">{{item.sourceLabel}}</text>
          </view>
          <text class="record-title">{{item.title}}</text>
          <text class="record-text">{{item.standardExpression}}</text>
          <button wx:if="{{item.source.type === 'manual' && !readOnly}}" class="record-edit" data-id="{{item.id}}" bindtap="onEditRecord">编辑这条经历</button>
        </view>
      </view>
    </view>

    <view wx:if="{{recordFormOpen && growthSchemaReady && !readOnly}}" id="growth-record-editor" class="section-card record-editor">
      <text class="section-title">{{recordEditingId ? '编辑经历' : '添加经历'}}</text>
      <text class="record-field-label">经历类型</text>
      <picker range="{{recordTypes}}" range-key="label" value="{{recordTypeIndex}}" bindchange="onRecordTypeChange"><view class="record-picker">{{recordTypes[recordTypeIndex].label}} ›</view></picker>
      <text class="record-field-label">名称 *</text>
      <input class="record-input" data-field="title" maxlength="220" value="{{recordForm.title}}" placeholder="例如：大学生创新训练项目" bindinput="onRecordInput" />
      <text class="record-field-label">机构／主办方</text>
      <input class="record-input" data-field="organization" maxlength="220" value="{{recordForm.organization}}" placeholder="按真实证明材料填写" bindinput="onRecordInput" />
      <text class="record-field-label">担任角色</text>
      <input class="record-input" data-field="role" maxlength="160" value="{{recordForm.role}}" placeholder="例如：项目成员" bindinput="onRecordInput" />
      <view class="record-dates">
        <view><text class="record-field-label">开始时间</text><input class="record-input" data-field="startDate" maxlength="32" value="{{recordForm.startDate}}" placeholder="例如：2025-09" bindinput="onRecordInput" /></view>
        <view><text class="record-field-label">结束时间</text><input class="record-input" data-field="endDate" maxlength="32" value="{{recordForm.endDate}}" placeholder="可留空" bindinput="onRecordInput" /></view>
      </view>
      <text class="record-field-label">主要内容</text>
      <textarea class="record-textarea" data-field="description" maxlength="2000" value="{{recordForm.description}}" placeholder="写清楚你实际完成的工作" bindinput="onRecordInput" />
      <text class="record-field-label">成果／证明</text>
      <textarea class="record-textarea record-textarea-short" data-field="result" maxlength="1200" value="{{recordForm.result}}" placeholder="例如：奖项、论文状态或可核查成果" bindinput="onRecordInput" />
      <text wx:if="{{recordError}}" class="record-error">{{recordError}}</text>
      <view class="record-form-actions"><button class="record-cancel" disabled="{{recordSaving}}" bindtap="onCancelRecord">取消</button><button class="record-save" loading="{{recordSaving}}" disabled="{{recordSaving}}" bindtap="onSaveRecord">保存经历</button></view>
    </view>

    <view class="section-card">
      <view class="section-head">
        <view>
          <text class="section-title">简历预览</text>
          <text class="section-sub">仅使用你已确认的资料生成，不会添加未经确认的经历</text>
        </view>
      </view>
      <view class="target-row">
        <view
          wx:for="{{targets}}"
          wx:key="key"
          class="target-chip {{target === item.key ? 'active' : ''}}"
          data-target="{{item.key}}"
          bindtap="onTargetTap"
        >{{item.label}}</view>
      </view>

      <view wx:if="{{resume && resume.education}}" class="resume-block">
        <text class="resume-label">教育背景</text>
        <text class="resume-title">{{resume.education.school}} · {{resume.education.major || '专业待补充'}}</text>
        <text class="resume-meta">{{resume.education.gpa || '绩点待补充'}} · {{resume.education.rank || '排名待补充'}}</text>
      </view>

      <view wx:if="{{resume && resume.entries.length}}" class="resume-entry-list">
        <view wx:for="{{resume.entries}}" wx:key="id" class="resume-entry">
          <text class="resume-entry-title">{{item.title}}</text>
          <text class="resume-entry-text">{{item.text}}</text>
          <text class="trace">可追溯：{{item.sourceRefs[0]}}</text>
        </view>
      </view>
      <view wx:else class="empty">还没有可用于简历的已确认经历。你可以先补充资料或确认上方找到的经历。</view>

      <button
        wx:if="{{resume}}"
        class="docx-button"
        loading="{{openingDocument}}"
        disabled="{{openingDocument || readOnly}}"
        bindtap="onOpenResumeDocx"
      >生成并打开 DOCX 简历</button>
      <text wx:if="{{resume}}" class="artifact-note">根据已确认资料即时生成，不会修改原始档案；可在微信文档预览中分享或保存。</text>
    </view>

    <view class="section-card">
      <view class="section-head">
        <view>
          <text class="section-title">招聘填空包</text>
          <text class="section-sub">整理已确认资料，方便你核对招聘网站需要的信息</text>
        </view>
      </view>
      <view class="status-grid">
        <view class="status-box good"><text class="status-num">{{matchedCount}}</text><text class="status-label">已自动匹配</text></view>
        <view class="status-box warn"><text class="status-num">{{confirmCount}}</text><text class="status-label">需要确认</text></view>
        <view class="status-box"><text class="status-num">{{missingCount}}</text><text class="status-label">缺少信息</text></view>
      </view>
      <text class="safety-note">系统只生成字段映射，不保存招聘网站密码、不绕过验证码，也不会替你最终提交申请。</text>
    </view>
  </block>
</view>
