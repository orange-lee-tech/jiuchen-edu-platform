.growth-page { min-height: 100vh; box-sizing: border-box; padding: 28rpx 28rpx calc(72rpx + env(safe-area-inset-bottom)); background: #f4f2ed; }
.hero { padding: 16rpx 6rpx 26rpx; }
.title, .section-title, .section-sub, .fact-label, .fact-value, .record-title, .record-text, .record-source, .resume-label, .resume-title, .resume-meta, .resume-entry-title, .resume-entry-text, .trace, .status-num, .status-label, .safety-note, .schema-title, .schema-desc { display: block; }
.title { color: #173e67; font-size: 38rpx; font-weight: 800; }
.section-card, .state-card, .schema-note { margin-bottom: 18rpx; padding: 26rpx; border: 1rpx solid #e8e2d6; border-radius: 8rpx; background: #fffdf9; }
.error-card { color: #b45149; }
.schema-note { background: #fffaf0; border-color: #f3dfb8; }
.schema-title { color: #785a21; font-size: 24rpx; font-weight: 800; }
.schema-desc { margin-top: 10rpx; color: #8a7449; font-size: 21rpx; line-height: 1.65; }
.section-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; margin-bottom: 22rpx; }
.section-title { color: #262b32; font-size: 27rpx; font-weight: 800; }
.section-sub { margin-top: 7rpx; color: #66707d; font-size: 21rpx; line-height: 1.55; }
.link { color: #245681; font-size: 22rpx; font-weight: 700; }
.fact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.fact { padding: 18rpx; border-radius: 8rpx; background: #f3f7fc; }
.fact-label { color: #66707d; font-size: 21rpx; }
.fact-value { margin-top: 7rpx; color: #30353c; font-size: 22rpx; font-weight: 700; word-break: break-all; }
.empty { padding: 20rpx; border-radius: 8rpx; background: #f3f7fc; color: #5f6b78; font-size: 22rpx; line-height: 1.65; }
.record-list, .resume-entry-list { display: flex; flex-direction: column; gap: 14rpx; }
.record { padding: 20rpx; border-radius: 8rpx; background: #f3f7fc; }
.record-head { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; }
.record-type { padding: 5rpx 11rpx; border-radius: 999rpx; background: #eaf2fa; color: #245681; font-size: 18rpx; font-weight: 700; }
.record-source { color: #66707d; font-size: 20rpx; }
.record-title { margin-top: 13rpx; color: #30353b; font-size: 23rpx; font-weight: 800; }
.record-text { margin-top: 8rpx; color: #626a75; font-size: 21rpx; line-height: 1.65; }
.target-row { display: flex; gap: 12rpx; margin-bottom: 22rpx; }
.target-chip { flex: 1; padding: 15rpx 8rpx; border: 1rpx solid #e0e5ed; border-radius: 14rpx; color: #69717d; font-size: 20rpx; text-align: center; background: #fffdf9; }
.target-chip.active { border-color: #245681; background: #eaf2fa; color: #245681; font-weight: 800; }
.resume-block { padding: 20rpx; border-radius: 8rpx; background: #f3f7fc; }
.resume-label { color: #245681; font-size: 18rpx; font-weight: 800; }
.resume-title { margin-top: 8rpx; color: #292e35; font-size: 24rpx; font-weight: 800; }
.resume-meta { margin-top: 6rpx; color: #777f8a; font-size: 20rpx; }
.resume-entry-list { margin-top: 14rpx; }
.resume-entry { padding: 20rpx; border-left: 5rpx solid #cfddec; border-radius: 8rpx; background: #fffdf9; }
.resume-entry-title { color: #30353b; font-size: 22rpx; font-weight: 800; }
.resume-entry-text { margin-top: 7rpx; color: #626a75; font-size: 20rpx; line-height: 1.65; }
.trace { margin-top: 10rpx; color: #66707d; font-size: 20rpx; word-break: break-all; }
.status-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; }
.status-box { padding: 18rpx 8rpx; border-radius: 16rpx; background: #f5f6f8; text-align: center; }
.status-box.good { background: #edf8f1; }
.status-box.warn { background: #fff8e9; }
.status-num { color: #30353b; font-size: 31rpx; font-weight: 800; }
.status-label { margin-top: 5rpx; color: #747c87; font-size: 18rpx; }
.safety-note { margin-top: 18rpx; color: #66707d; font-size: 21rpx; line-height: 1.65; }

.import-card { border-color: #dfe8fb; }
.candidate-list { display: flex; flex-direction: column; gap: 12rpx; }
.candidate { display: flex; gap: 14rpx; padding: 18rpx; border: 1rpx solid #e6eaf0; border-radius: 8rpx; background: #fafbfc; }
.candidate.selected { border-color: #cfddec; background: #eaf2fa; }
.candidate-check { flex: 0 0 34rpx; width: 34rpx; height: 34rpx; border: 2rpx solid #c9cfd8; border-radius: 8rpx; color: #fffdf9; font-size: 22rpx; line-height: 34rpx; text-align: center; }
.candidate.selected .candidate-check { border-color: #245681; background: #245681; }
.candidate-main { flex: 1; min-width: 0; }
.candidate-head { display: flex; align-items: center; gap: 10rpx; }
.candidate-title { flex: 1; color: #30353b; font-size: 22rpx; font-weight: 800; }
.confirm-button { margin-top: 18rpx; border-radius: 8rpx; background: #245681; color: #fffdf9; font-size: 23rpx; font-weight: 800; }
.confirm-button::after { border: 0; }
.confirm-note { display: block; margin-top: 12rpx; color: #66707d; font-size: 21rpx; line-height: 1.55; }

.refresh-note { display: block; margin-top: 10rpx; color: #8a93a0; font-size: 18rpx; }

.docx-button { margin-top: 22rpx; border-radius: 8rpx; background: #245681; color: #fffdf9; font-size: 23rpx; font-weight: 800; }
.docx-button::after { border: 0; }
.artifact-note { display: block; margin-top: 12rpx; color: #66707d; font-size: 21rpx; line-height: 1.6; }

.retry-button { margin-top: 18rpx; width: max-content; padding: 0 26rpx; border: 1rpx solid #cfddec; border-radius: 8rpx; background: #eaf2fa; color: #173e67; font-size: 23rpx; }
.retry-button::after { border: 0; }
.record-add,.record-edit,.record-cancel,.record-save { margin: 0; border-radius: 8rpx; font-size: 22rpx; }
.record-add { flex: none; padding: 0 15rpx; background: #eaf2fa; color: #173e67; }
.record-edit { width: max-content; margin-top: 12rpx; padding: 0 15rpx; background: #eaf2fa; color: #173e67; }
.record-add::after,.record-edit::after,.record-cancel::after,.record-save::after { border: 0; }
.record-editor { border-color: #cfddec; }
.record-field-label { display: block; margin-top: 17rpx; margin-bottom: 7rpx; color: #245681; font-size: 22rpx; font-weight: 700; }
.record-picker,.record-input,.record-textarea { box-sizing: border-box; width: 100%; padding: 14rpx 17rpx; border: 1rpx solid #d8e2e8; border-radius: 6rpx; background: #fffdf9; color: #223246; font-size: 24rpx; }
.record-dates { display: flex; gap: 12rpx; }
.record-dates > view { flex: 1; min-width: 0; }
.record-textarea { min-height: 150rpx; line-height: 1.6; }
.record-textarea-short { min-height: 110rpx; }
.record-error { display: block; margin-top: 14rpx; color: #9c463d; font-size: 22rpx; line-height: 1.5; }
.record-form-actions { display: flex; gap: 12rpx; margin-top: 22rpx; }
.record-form-actions button { flex: 1; min-width: 0; }
.record-cancel { background: #f3f7fc; color: #245681; }
.record-save { background: #173e67; color: #fffdf9; }
