<auth-gate />
<view class="page-shell">
  <view class="import-head">
    <text class="page-title">我的课表</text>
  </view>

  <view class="mode-tabs">
    <view class="mode-tab {{viewMode === 'current' ? 'active' : ''}}" data-mode="current" bindtap="onViewModeTap">本周课表</view>
    <view class="mode-tab {{viewMode === 'all' ? 'active' : ''}}" data-mode="all" bindtap="onViewModeTap">全部课表</view>
    <view class="mode-tab {{viewMode === 'manage' ? 'active' : ''}}" data-mode="manage" bindtap="onViewModeTap">导入 / 编辑</view>
  </view>

  <view wx:if="{{saveError}}" class="schedule-save-error">{{saveError}}。修改尚未写入服务器，请核对后重试。</view>
  <view wx:if="{{schedule}}" class="term-card surface">
    <text class="term-affiliation" bindtap="onReassignStage">归属：{{stageChoiceLabel || '待人工确认归属学期'}} · 点击修改 ›</text>
    <view>
      <text class="term-title">{{currentWeekLabel}}</text>
    </view>
    <view class="date-picker" bindtap="onOpenMondayPicker">{{termStartDate ? '第一周周一：' + termStartDate : '选择第一周周一'}} ›</view>
  </view>

  <view wx:if="{{viewMode === 'manage'}}" class="import-actions">
    <button class="import-card surface" bindtap="onChooseSpreadsheet" loading="{{parsing}}" disabled="{{parsing}}">
      <text class="import-icon">表</text>
      <text class="import-title">微信文件 / Excel / CSV</text>
    </button>
    <button class="import-card surface" bindtap="onChooseImage" loading="{{parsing}}" disabled="{{parsing}}">
      <text class="import-icon">图</text>
      <text class="import-title">课表截图 / 拍照</text>
      <text class="import-desc">识别失败时可手动校正。</text>
    </button>
  </view>

  <view wx:if="{{viewMode === 'manage'}}" class="stage-hint">{{stageHint}}</view>
  <view wx:if="{{fileName}}" class="file-note">
    当前课表：{{fileName}}{{parsing ? ' · 解析中…' : saving ? ' · 保存中…' : ''}}
  </view>

  <view wx:if="{{schedule && schedule.warnings.length}}" class="warnings">
    <view wx:for="{{schedule.warnings}}" wx:key="*this" class="warning">{{item}}</view>
  </view>

  <view wx:if="{{schedule}}" class="result-section">
    <view class="section-head">
      <view>
        <text class="section-title">{{viewMode === 'current' ? '本周课程' : viewMode === 'all' ? '全部课程' : '课表校正'}}</text>
        <text class="section-note">
          {{viewMode === 'current' && currentWeek === 0 ? '先设置学期第一周周一' : visibleCourses.length + ' 门课程'}}
        </text>
      </view>
      <button wx:if="{{viewMode === 'manage'}}" class="add-course" bindtap="onAddCourse">+ 新增课程</button>
    </view>

    <view
      wx:for="{{visibleCourses}}"
      wx:key="index"
      class="course-card surface"
    >
      <view class="course-head">
        <text class="course-name">{{item.name}}</text>
        <text class="course-slot">{{item.day}} · {{item.slot}}</text>
      </view>

      <view class="course-details">
        <text wx:if="{{item.weeks}}" class="course-chip">周次 {{item.weeks}}</text>
        <text wx:if="{{item.location}}" class="course-chip">地点 {{item.location}}</text>
        <text wx:if="{{item.teacher}}" class="course-chip">教师 {{item.teacher}}</text>
      </view>

      <view wx:if="{{viewMode === 'manage'}}" class="course-actions">
        <view class="course-action" data-index="{{index}}" bindtap="onEditCourse">编辑</view>
        <view class="course-action danger" data-index="{{index}}" bindtap="onDeleteCourse">删除</view>
      </view>
    </view>

    <view wx:if="{{visibleCourses.length === 0}}" class="empty surface">
      <text wx:if="{{viewMode === 'current' && currentWeek === 0}}">设置“本学期第一周周一”后即可单独显示本周课表。</text>
      <text wx:elif="{{viewMode === 'manage'}}">当前没有课程。你可以重新导入，或直接“新增课程”手动补录。</text>
      <text wx:else>当前视图没有匹配课程。</text>
    </view>
  </view>

  <view wx:else-if="{{!parsing}}" class="empty surface">
    <text>还没有可用课表。切换到“导入 / 编辑”上传 Excel、CSV 或课表图片。</text>
  </view>

  <view wx:if="{{mondayPickerOpen}}" class="monday-mask">
    <view class="monday-panel">
      <view class="monday-heading">
        <text>选择学期第一周周一</text>
        <text class="monday-close" bindtap="onCloseMondayPicker">×</text>
      </view>
      <text class="monday-hint">请按学校校历确认第一周周一。</text>
      <view class="monday-month-nav">
        <button data-delta="-1" bindtap="onChangeMondayMonth">‹ 上个月</button>
        <text>{{mondayMonth}}</text>
        <button data-delta="1" bindtap="onChangeMondayMonth">下个月 ›</button>
      </view>
      <view class="monday-list">
        <button wx:for="{{mondayOptions}}" wx:key="date" data-date="{{item.date}}" class="monday-option {{termStartDate === item.date ? 'current' : ''}}" bindtap="onPickMonday">{{item.label}}</button>
      </view>
    </view>
  </view>

  <view wx:if="{{showStagePicker}}" class="term-overlay">
    <view class="term-sheet">
      <text class="term-sheet-title">这份课表属于哪个学期？</text>
      <text class="term-sheet-desc">{{stageHint}} {{sourceForStage === 'reassign' ? '选择后将更新当前已导入课表的归属，不需要重新上传文件。' : '请点击准确的学期后继续选择文件。'}}</text>
      <view class="term-option-grid">
        <view wx:for="{{stageOptions}}" wx:key="code" class="term-option {{stageChoice === item.code ? 'selected' : ''}}" data-code="{{item.code}}" bindtap="onSelectStage">{{item.label}}</view>
      </view>
      <view class="term-sheet-footer">
        <button bindtap="onDismissStage" class="term-cancel">取消</button>
        <button bindtap="onConfirmStage" class="term-confirm" disabled="{{!stageChoice}}">{{sourceForStage === 'reassign' ? '确认归档至' : '确认并继续上传'}} {{stageChoiceLabel || '学期'}}</button>
      </view>
    </view>
  </view>
  <view wx:if="{{editing}}" class="editor-mask">
    <view class="editor-sheet">
      <view class="editor-head">
        <text class="editor-title">{{editingIndex >= 0 ? '编辑课程' : '新增课程'}}</text>
        <text class="editor-close" bindtap="onCancelEdit">×</text>
      </view>

      <text class="field-label">课程名</text>
      <input class="field-input" value="{{courseDraft.name}}" placeholder="例如：工程热力学" bindinput="onDraftName" />

      <text class="field-label">星期</text>
      <picker range="{{dayOptions}}" value="{{courseDraft.dayIndex - 1}}" bindchange="onDraftDay">
        <view class="field-picker">{{courseDraft.day}} ›</view>
      </picker>

      <text class="field-label">节次</text>
      <input class="field-input" value="{{courseDraft.slot}}" placeholder="例如：第3-4节" bindinput="onDraftSlot" />

      <text class="field-label">周次</text>
      <input class="field-input" value="{{courseDraft.weeks || ''}}" placeholder="例如：1-16周 / 1-16周单周" bindinput="onDraftWeeks" />

      <text class="field-label">地点</text>
      <input class="field-input" value="{{courseDraft.location || ''}}" placeholder="可选" bindinput="onDraftLocation" />

      <text class="field-label">教师</text>
      <input class="field-input" value="{{courseDraft.teacher || ''}}" placeholder="可选" bindinput="onDraftTeacher" />

      <view class="editor-actions">
        <button class="secondary" bindtap="onCancelEdit">取消</button>
        <button class="primary" loading="{{saving}}" disabled="{{saving}}" bindtap="onSaveCourse">保存课程</button>
      </view>

      <text class="editor-note">这里是学员自己的临时课表，保存后立即生效。</text>
    </view>
  </view>
</view>
