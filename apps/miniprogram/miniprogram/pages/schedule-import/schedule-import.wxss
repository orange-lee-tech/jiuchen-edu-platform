.import-head {
  margin: 8rpx 4rpx 24rpx;
}

.page-title,
.page-desc,
.import-icon,
.import-title,
.import-desc,
.term-title,
.term-desc,
.course-name,
.course-meta,
.field-label,
.editor-title,
.editor-note {
  display: block;
}

.page-title {
  font-size: 38rpx;
  font-weight: 800;
}

.page-desc {
  margin-top: 10rpx;
  color: #777e89;
  font-size: 22rpx;
  line-height: 1.7;
}

.mode-tabs {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  margin-bottom: 18rpx;
  padding: 6rpx;
  border-radius: 10rpx;
  background: #e9edf2;
}

.mode-tab {
  padding: 14rpx 8rpx;
  border-radius: 8rpx;
  color: #6e7783;
  font-size: 21rpx;
  text-align: center;
}

.mode-tab.active {
  background: #fff;
  color: #315f9d;
  font-weight: 800;
}

.term-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
  padding: 22rpx;
}

.term-card > view:first-child {
  flex: 1;
  min-width: 0;
}

.term-title {
  color: #2c333d;
  font-size: 25rpx;
  font-weight: 800;
}

.term-desc {
  margin-top: 6rpx;
  color: #828a95;
  font-size: 19rpx;
  line-height: 1.5;
}

.date-picker {
  flex-shrink: 0;
  padding: 12rpx 14rpx;
  border-radius: 8rpx;
  background: #eef3f8;
  color: #4d6179;
  font-size: 19rpx;
}

.import-actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.import-card {
  box-sizing: border-box;
  width: 100%;
  margin: 0;
  padding: 24rpx;
  text-align: left;
  line-height: 1.5;
  background: #fff;
}

.import-card::after,
.add-course::after,
.mini::after,
.secondary::after,
.primary::after {
  border: 0;
}

.import-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 8rpx;
  background: #eef3f8;
  color: #315f9d;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 52rpx;
  text-align: center;
}

.import-title {
  margin-top: 14rpx;
  color: #22262d;
  font-size: 26rpx;
  font-weight: 750;
}

.import-desc {
  margin-top: 7rpx;
  color: #858d98;
  font-size: 20rpx;
}

.file-note {
  margin: 18rpx 4rpx;
  color: #6f7884;
  font-size: 21rpx;
}

.warnings {
  margin: 14rpx 0;
}

.warning {
  margin-top: 8rpx;
  padding: 14rpx 16rpx;
  border-radius: 8rpx;
  background: #fff7e5;
  color: #80600f;
  font-size: 20rpx;
  line-height: 1.6;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin: 26rpx 4rpx 14rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
}

.section-note {
  display: block;
  margin-top: 4rpx;
  color: #8b919a;
  font-size: 20rpx;
}

.add-course {
  flex-shrink: 0;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 8rpx;
  background: #315f9d;
  color: #fff;
  font-size: 21rpx;
  line-height: 58rpx;
}

.course-card {
  margin-bottom: 12rpx;
  padding: 20rpx;
}

.course-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.course-name {
  min-width: 0;
  flex: 1;
  color: #29313a;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.45;
  word-break: break-all;
}

.course-slot {
  flex-shrink: 0;
  padding: 6rpx 10rpx;
  border-radius: 8rpx;
  background: #eef3f8;
  color: #4d6179;
  font-size: 18rpx;
  font-weight: 700;
  white-space: nowrap;
}

.course-details {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 14rpx;
}

.course-chip {
  display: inline-block;
  max-width: 100%;
  padding: 7rpx 10rpx;
  border-radius: 8rpx;
  background: #f5f7f9;
  color: #6e7783;
  font-size: 18rpx;
  line-height: 1.35;
}

.course-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10rpx;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #edf0f3;
}

.course-action {
  min-width: 92rpx;
  padding: 10rpx 16rpx;
  border-radius: 8rpx;
  background: #eef3f8;
  color: #315f9d;
  font-size: 18rpx;
  font-weight: 700;
  text-align: center;
}

.course-action.danger {
  background: #fff0ee;
  color: #ae5149;
}

.empty {
  margin-top: 18rpx;
  padding: 28rpx;
  color: #888f99;
  font-size: 21rpx;
  line-height: 1.7;
  text-align: center;
}

.editor-mask {
  position: fixed;
  z-index: 1000;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(19, 24, 31, 0.46);
}

.editor-sheet {
  box-sizing: border-box;
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  padding: 28rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));
  border-radius: 16rpx 16rpx 0 0;
  background: #fff;
}

.editor-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.editor-title {
  font-size: 30rpx;
  font-weight: 800;
}

.editor-close {
  color: #76808c;
  font-size: 36rpx;
}

.field-label {
  margin-top: 18rpx;
  color: #4c5662;
  font-size: 20rpx;
  font-weight: 700;
}

.field-input,
.field-picker {
  box-sizing: border-box;
  min-height: 72rpx;
  margin-top: 8rpx;
  padding: 18rpx;
  border: 1rpx solid #dfe4ea;
  border-radius: 8rpx;
  background: #f8f9fa;
  color: #303842;
  font-size: 22rpx;
}

.field-input {
  padding-top: 0;
  padding-bottom: 0;
}

.editor-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 26rpx;
}

.secondary,
.primary {
  flex: 1;
  margin: 0;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.secondary {
  background: #e9edf2;
  color: #55606d;
}

.primary {
  background: #315f9d;
  color: #fff;
}

.editor-note {
  margin-top: 18rpx;
  color: #8b929b;
  font-size: 19rpx;
  line-height: 1.6;
}
