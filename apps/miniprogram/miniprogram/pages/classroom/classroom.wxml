<view class="classroom-page">
  <view class="classroom-top">
    <view>
      <text class="page-title">我的课堂</text>
      <text class="page-subtitle">大学阶段规划与辅导进度</text>
    </view>
    <view class="stage-badge">{{currentStageLabel}}</view>
  </view>

  <view class="classroom-layout">
    <scroll-view
      class="stage-sidebar"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
    >
      <view class="timeline">
        <view
          wx:for="{{stages}}"
          wx:key="code"
          class="timeline-item {{currentStage === index ? 'active' : ''}}"
          data-index="{{index}}"
          bindtap="onStageChange"
        >
          <view class="timeline-mark">
            <view class="timeline-dot"></view>
          </view>
          <text class="timeline-label">{{item.label}}</text>
        </view>
      </view>
    </scroll-view>

    <view class="classroom-main">
      <view class="stage-summary surface">
        <view class="stage-summary-head">
          <view>
            <text class="stage-title">{{currentStageLabel}}</text>
            <text class="stage-desc">{{stageDescription}}</text>
          </view>
          <view class="stage-state">当前阶段</view>
        </view>
      </view>

      <view class="section-title-row">
        <text class="section-title">阶段规划</text>
        <text class="section-note">按阶段持续更新</text>
      </view>

      <view wx:if="{{plans.length > 0}}" class="plan-list">
        <view
          wx:for="{{plans}}"
          wx:key="type"
          class="plan-card surface"
          data-type="{{item.type}}"
          bindtap="onPlanTap"
        >
          <view class="plan-card-head">
            <view class="plan-icon">{{item.badge}}</view>
            <view class="plan-heading">
              <text class="plan-title">{{item.title}}</text>
              <text class="plan-note">{{item.note}}</text>
            </view>
            <text class="plan-arrow">›</text>
          </view>
          <view class="plan-card-foot">
            <text class="progress-label">完成进度</text>
            <text class="plan-progress">{{item.progress}}</text>
          </view>
        </view>
      </view>

      <view wx:else class="pending-card surface">
        <text class="pending-title">本阶段规划待配置</text>
        <text class="pending-desc">保留原型时间轴节点，具体规划内容由九辰后台确认后录入。</text>
      </view>

      <block wx:if="{{showGuidance}}">
        <view class="section-title-row">
          <text class="section-title">辅导老师</text>
          <text class="section-note">查看老师介绍</text>
        </view>

        <view wx:if="{{mentors.length > 0}}" class="mentor-list">
          <view
            wx:for="{{mentors}}"
            wx:key="id"
            class="mentor-card surface"
            data-index="{{index}}"
            bindtap="onMentorTap"
          >
            <view class="mentor-avatar">导</view>
            <view class="mentor-main">
              <text class="mentor-name">{{item.name}}</text>
              <text class="mentor-desc">
                {{item.title || '九辰辅导老师'}} · {{item.relationship === 'primary' ? '主辅导' : '协助'}}
              </text>
            </view>
            <text class="arrow">›</text>
          </view>
        </view>

        <view wx:else class="pending-card surface">
          <text class="pending-title">辅导老师待分配</text>
          <text class="pending-desc">老师由九辰后台维护并按学员/阶段授权。</text>
        </view>

        <view class="section-title-row">
          <text class="section-title">辅导记录</text>
          <text class="section-note">工作人员录入</text>
        </view>

        <view wx:if="{{records.length > 0}}" class="record-list surface">
          <view wx:for="{{records}}" wx:key="id" class="record-row">
            <view class="record-date">{{item.dateLabel}}</view>
            <view class="record-main">
              <text class="record-title">{{item.title}}</text>
              <text wx:if="{{item.teacherName}}" class="record-teacher">记录老师：{{item.teacherName}}</text>
              <text class="record-content">{{item.content}}</text>
            </view>
          </view>
        </view>

        <view wx:else class="pending-card surface">
          <text class="pending-title">暂无辅导记录</text>
          <text class="pending-desc">辅导完成后由九辰工作人员在后台录入，学员端只读。</text>
        </view>
      </block>
    </view>
  </view>
</view>
