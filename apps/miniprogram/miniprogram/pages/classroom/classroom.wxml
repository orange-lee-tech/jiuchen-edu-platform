<view class="classroom-page">
  <role-shell view-slot="plan" phase="{{shellPhase}}" kind="{{shellKind}}" role-label="{{shellRoleLabel}}" message="{{shellMessage}}" />
  <block wx:if="{{shellPhase === 'ready' && shellKind === 'student'}}">
  <view class="classroom-top">
    <view>
      <text class="page-title">我的规划</text>
    </view>
    <view wx:if="{{mode === 'student' && !loading && !loadError}}" class="stage-badge">{{selectedView === 'week' ? '本周课表' : currentStageLabel}}</view>
  </view>

  <view wx:if="{{mode === 'guest'}}" class="entry-state surface">
    <text class="entry-title">接续你的大学阶段规划</text>
    <button class="entry-button" bindtap="onLogin">登录并绑定学员身份</button>
  </view>

  <view wx:elif="{{mode === 'unbound'}}" class="entry-state surface">
    <text class="entry-title">绑定学员身份，查看阶段规划</text>
    <button class="entry-button" bindtap="onBindIdentity">填写九辰学员编号</button>
  </view>

  <view wx:elif="{{mode === 'teacher'}}" class="entry-state surface">
    <text class="entry-title">老师工作台</text>
    <button class="entry-button" bindtap="onTeacherWorkspace">进入我的学员</button>
  </view>

  <view wx:else class="student-layout">
    <view wx:if="{{loadError && !studentName}}" class="plan-error"><text>{{loadError}}</text><button bindtap="onRetryPlan">重新加载规划</button></view>
    <view wx:elif="{{loading && !studentName}}" class="plan-loading">正在读取你的阶段规划…</view>
    <block wx:else>
    <view class="student-tools surface">
      <view>
        <text class="tool-title">{{studentName || '我的计划'}}</text>
      </view>
      <button wx:if="{{!readOnly}}" class="schedule-import-button" bindtap="onScheduleImport">导入课表</button>
    </view>

    <view class="stage-picker surface">
      <view class="stage-picker-top"><view><text class="stage-picker-caption">档案当前阶段：{{actualStageLabel}}</text><text class="stage-picker-current">正在查看：{{currentStageLabel}}</text></view><text class="stage-picker-toggle" bindtap="onToggleStagePicker">{{stagePickerOpen ? '收起' : '选择学期'}} ›</text></view>
      <view wx:if="{{stagePickerOpen}}" class="stage-group-list">
        <view wx:for="{{stageGroups}}" wx:for-item="group" wx:key="year" class="stage-group">
          <text class="stage-group-title">{{group.label}}</text>
          <view class="stage-options"><view wx:for="{{group.stages}}" wx:for-item="stage" wx:key="code" class="stage-option {{currentStageCode === stage.code && selectedView === 'stage' ? 'active' : ''}}" data-code="{{stage.code}}" bindtap="onStageChange">{{stage.label}}</view></view>
        </view>
      </view>
      <view class="current-week-link" bindtap="onCurrentWeekSchedule">查看本周完整课表 ›</view>
    </view>

    <view class="classroom-layout">
      <view class="classroom-main">
        <view wx:if="{{selectedView === 'week'}}" class="week-view">
          <view class="stage-summary surface"><text class="stage-title">本周课表</text><text class="stage-desc">{{weekLabel}}</text></view>
          <view wx:if="{{weekLoading}}" class="pending-card surface">正在读取本周课程…</view>
          <view wx:elif="{{weekError}}" class="plan-error"><text>{{weekError}}</text><button bindtap="loadCurrentWeek">重新读取课表</button></view>
          <view wx:elif="{{weekState !== 'ready'}}" class="pending-card surface">
            <text class="pending-title">{{weekState === 'unknown' ? '档案阶段待确认' : weekState === 'holiday' ? '当前阶段没有学期课表' : weekState === 'missing' ? '尚未导入本学期课表' : weekState === 'date' ? '需要确认学期起始日期' : '本周没有课程'}}</text>
            <text class="pending-desc">{{weekState === 'unknown' ? '请先读取档案阶段，再查看对应学期课表。' : weekState === 'holiday' ? '本周课表按档案当前学期展示；可切换学期查看阶段规划。' : weekState === 'missing' ? '导入本学期真实课表后，这里显示按周次筛选的课程。' : weekState === 'date' ? '在课表管理中设置本学期第一周周一，才能准确筛选本周课程。' : '按当前周次与单双周规则，没有安排课程。可查看完整课表确认。'}}</text>
            <button wx:if="{{!readOnly && weekState !== 'holiday' && weekState !== 'unknown'}}" class="entry-button" bindtap="onScheduleImport">{{weekState === 'missing' ? '导入课表' : '管理课表与日期'}}</button>
          </view>
          <view wx:else class="week-list"><view wx:for="{{weekCourses}}" wx:key="index" class="week-course surface"><text class="course-slot">{{item.day}} · {{item.slot}}</text><text class="plan-title">{{item.name}}</text><text class="plan-note">地点：{{item.location || '暂无'}}{{item.teacher ? ' · ' + item.teacher : ''}}</text></view></view>
        </view>
        <block wx:else>
        <view wx:if="{{loadError}}" class="plan-error"><text>{{loadError}}</text><button bindtap="onRetryPlan">重新加载阶段</button></view>
        <view class="stage-summary surface">
          <view class="stage-summary-head">
            <view>
              <text class="stage-title">{{currentStageLabel}}</text>
              <text class="stage-desc">{{stageDescription}}</text>
            </view>
            <view class="stage-state">当前查看</view>
          </view>
        </view>

        <view class="section-title-row">
          <text class="section-title">阶段规划</text>
          <text wx:if="{{loading || readOnly}}" class="section-note">{{loading ? '同步中…' : '只读查看'}}</text>
        </view>

        <view wx:if="{{plans.length > 0}}" class="plan-list">
          <view
            wx:for="{{plans}}"
            wx:key="type"
            class="plan-card surface"
            data-type="{{item.type}}"
            bindtap="onPlanTap"
          >
            <view class="plan-card-head">
              <view class="plan-icon">{{item.badge}}</view>
              <view class="plan-heading">
                <view class="plan-title-row">
                  <text class="plan-title">{{item.title}}</text>
                  <text class="revision-chip {{item.revisionStatus}}">
                    {{item.revisionStatus === 'pending' ? '旧版草稿未生效' : item.revisionStatus === 'approved' ? '已保存' : '可创建'}}
                  </text>
                </view>
                <text class="plan-note">{{item.note}}</text>
              </view>
              <text class="plan-arrow">{{readOnly ? '查看' : item.revisionStatus === 'none' ? '建立' + item.title : '编辑'}} ›</text>
            </view>
            <view wx:if="{{item.progress}}" class="plan-card-foot">
              <text class="progress-label">条目进度</text>
              <text class="plan-progress">{{item.progress}}</text>
            </view>
          </view>
        </view>

        <view wx:else class="pending-card surface">
          <text class="pending-title">本阶段暂无可编辑计划</text>
        </view>

        <block wx:if="{{showGuidance}}">
          <view class="section-title-row">
            <text class="section-title">辅导老师</text>
          </view>

          <view wx:if="{{mentors.length > 0}}" class="mentor-list">
            <view wx:for="{{mentors}}" wx:key="id" class="mentor-card surface" data-index="{{index}}" bindtap="onMentorTap">
              <view class="mentor-avatar">导</view>
              <view class="mentor-main">
                <text class="mentor-name">{{item.name}}</text>
                <text class="mentor-desc">{{item.title || '九辰辅导老师'}} · {{item.relationship === 'primary' ? '主辅导' : '协助'}}</text>
              </view>
              <text class="arrow">›</text>
            </view>
          </view>

          <view wx:else class="pending-card surface">
            <text class="pending-title">辅导老师待分配</text>
          </view>

          <view class="section-title-row">
            <text class="section-title">辅导记录</text>
          </view>

          <view wx:if="{{records.length > 0}}" class="record-list surface">
            <view wx:for="{{records}}" wx:key="id" class="record-row">
              <view class="record-date">{{item.dateLabel}}</view>
              <view class="record-main">
                <text class="record-title">{{item.title}}</text>
                <text wx:if="{{item.teacherName}}" class="record-teacher">记录老师：{{item.teacherName}}</text>
                <text class="record-content">{{item.content}}</text>
              </view>
            </view>
          </view>

          <view wx:else class="pending-card surface">
            <text class="pending-title">{{guidanceRecordsReady ? '暂无辅导记录' : '暂时无法查看辅导记录'}}</text>
            <text class="pending-desc">{{guidanceRecordsReady ? '老师留下辅导记录后会显示在这里。' : '规划和课表仍可正常使用；请稍后再查看辅导记录。'}}</text>
          </view>
        </block>
        </block>
      </view>
    </view>
    </block>
  </view>
  </block>
</view>
<first-use-guide wx:if="{{!readOnly}}" />
