<view class="page-shell">
  <view class="classroom-hero surface">
    <text class="eyebrow">我的课堂</text>
    <text class="hero-title">把大学四年的准备拆成今天能做的事</text>
    <text class="hero-desc">计划由阶段、类型与具体任务组成，后续由后台为学员持续更新。</text>
  </view>

  <scroll-view class="stage-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="stage-row">
      <view
        wx:for="{{stages}}"
        wx:key="*this"
        class="stage-pill {{currentStage === index ? 'active' : ''}}"
        data-index="{{index}}"
        bindtap="onStageChange"
      >{{item}}</view>
    </view>
  </scroll-view>

  <view class="section-head">
    <view>
      <text class="section-title">阶段计划</text>
      <text class="section-subtitle">{{stages[currentStage]}} · 正常学期展示学业、英语、竞赛与科研</text>
    </view>
  </view>

  <view class="plan-grid">
    <view wx:for="{{plans}}" wx:key="title" class="plan-card surface" bindtap="onPlanTap">
      <view class="plan-icon">{{item.type}}</view>
      <text class="plan-title">{{item.title}}</text>
      <text class="plan-note">{{item.note}}</text>
      <view class="plan-foot">
        <text class="plan-progress">{{item.progress}}</text>
        <text class="plan-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="section-head">
    <view>
      <text class="section-title">指导老师</text>
      <text class="section-subtitle">导师信息由后台维护</text>
    </view>
  </view>

  <view class="mentor-card surface" bindtap="onMentorTap">
    <view class="mentor-avatar">导</view>
    <view class="mentor-main">
      <text class="mentor-name">{{mentor.name}}</text>
      <text class="mentor-desc">{{mentor.desc}}</text>
    </view>
    <text class="arrow">›</text>
  </view>

  <view class="section-head">
    <view>
      <text class="section-title">辅导记录</text>
      <text class="section-subtitle">由工作人员记录关键沟通与行动项</text>
    </view>
  </view>

  <view class="record-list surface">
    <view wx:for="{{records}}" wx:key="date" class="record-row">
      <text class="record-date">{{item.date}}</text>
      <view class="record-main">
        <text class="record-title">{{item.title}}</text>
        <text class="record-content">{{item.content}}</text>
      </view>
    </view>
  </view>
</view>
