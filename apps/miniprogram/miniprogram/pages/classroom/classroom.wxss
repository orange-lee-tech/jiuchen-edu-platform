.classroom-page { padding:28rpx 24rpx calc(40rpx + env(safe-area-inset-bottom)); background:#f2f4f6; color:#18202a; }
.classroom-top { display:flex; flex-wrap:wrap; gap:16rpx; justify-content:space-between; margin-bottom:24rpx; }
.page-title,.page-subtitle,.stage-title,.stage-desc,.plan-title,.plan-note,.mentor-name,.mentor-desc,.record-title,.record-content,.pending-title,.pending-desc,.entry-title,.entry-desc,.tool-title,.tool-desc,.record-teacher,.course-slot { display:block; }
.page-title { font-size:42rpx; font-weight:800; color:#173b73; }
.page-subtitle,.stage-desc,.tool-desc,.entry-desc { color:#5f6b78; font-size:25rpx; line-height:1.7; margin-top:10rpx; }
.stage-badge { background:#fff3cf; color:#705015; font-size:24rpx; padding:12rpx 18rpx; align-self:flex-start; border-radius: 6rpx; }
.surface { border:1rpx solid #d8dee6; border-radius: 8rpx; background:#fafbfc; }
.student-tools,.entry-state { padding:24rpx; margin-bottom:24rpx; }
.student-tools { display:flex; flex-wrap:wrap; align-items:center; gap:20rpx; border-left:6rpx solid #f2b544; }
.student-tools > view { flex:1 1 280rpx; min-width:0; }
.entry-state { background:#e7eef8; border-left:6rpx solid #2f6fed; }
.entry-title,.tool-title { font-size:30rpx; font-weight:700; }
button { border-radius: 8rpx; white-space:normal; box-sizing:border-box; }
button::after { border:0; }
.entry-button,.schedule-import-button,.plan-error button { margin:20rpx 0 0; padding:18rpx 20rpx; font-size:26rpx; line-height:1.5; background:#2f6fed; color:#fff; }
.schedule-import-button { margin:0; }
.entry-button:active,.schedule-import-button:active,.plan-error button:active { background:#2459be; }
.classroom-layout { display:flex; align-items:flex-start; gap:16rpx; }
.stage-sidebar { flex:0 0 136rpx; width:136rpx; position:sticky; top:16rpx; height:calc(100vh - 200rpx); background:#edf2f7; border-radius: 6rpx; }
.timeline,.current-week-nav { padding:8rpx; }
.timeline-item,.current-week-nav { display:flex; align-items:center; padding:18rpx 8rpx; min-height:78rpx; box-sizing:border-box; border-bottom:1rpx solid #d8dee6; }
.timeline-mark { flex:0 0 20rpx; display:flex; justify-content:flex-start; }
.timeline-dot { width:8rpx; height:8rpx; border-radius:50%; background:#89939e; }
.timeline-label,.current-week-label { min-width:0; flex:1; font-size:25rpx; line-height:1.5; color:#46586e; }
.timeline-label text,.current-week-label text { display:block; white-space:nowrap; }
.timeline-item.active,.current-week-nav.active { background:#2459be; }
.timeline-item.active .timeline-label,.current-week-nav.active .current-week-label { color:#fff; font-weight:700; }
.timeline-item.active .timeline-dot,.current-week-nav.active .timeline-dot { background:#f2b544; }
.classroom-main { flex:1; min-width:0; }
.stage-summary { padding:20rpx; background:#e7eef8; border-left:4rpx solid #2f6fed; }
.stage-summary-head { display:flex; flex-wrap:wrap; gap:12rpx; }
.stage-title { font-size:32rpx; font-weight:800; color:#173b73; }
.stage-state { font-size:23rpx; color:#2459be; }
.section-title-row { display:flex; flex-wrap:wrap; align-items:baseline; gap:8rpx; justify-content:space-between; margin:28rpx 0 14rpx; }
.section-title { font-size:29rpx; font-weight:700; }
.section-note { font-size:23rpx; color:#5f6b78; }
.plan-list,.mentor-list,.week-list { display:flex; flex-direction:column; gap:14rpx; margin-top:16rpx; }
.plan-card,.mentor-card,.pending-card,.week-course { padding:20rpx; }
.plan-card:active { background:#e7eef8; }
.plan-card-head { display:flex; flex-wrap:wrap; align-items:center; gap:12rpx; }
.plan-icon { display:none; }
.plan-heading { flex:1 1 100%; min-width:0; }
.plan-title-row { display:flex; flex-wrap:wrap; gap:10rpx; align-items:center; }
.plan-title,.pending-title,.mentor-name,.record-title { font-size:28rpx; font-weight:700; line-height:1.5; word-break:break-word; }
.plan-note,.pending-desc,.mentor-desc,.record-content,.record-teacher { font-size:24rpx; color:#5f6b78; line-height:1.7; margin-top:8rpx; }
.plan-arrow { margin-left:auto; color:#2459be; font-size:25rpx; }
.plan-card-foot { display:flex; flex-wrap:wrap; gap:10rpx; justify-content:space-between; border-top:1rpx solid #e5e9ee; padding-top:14rpx; margin-top:14rpx; font-size:24rpx; }
.progress-label { color:#5f6b78; }
.plan-progress { color:#2459be; font-weight:700; }
.revision-chip { font-size:22rpx; padding:5rpx 10rpx; border-radius: 6rpx; color:#5f6b78; background:#edf2f7; }
.revision-chip.pending { background:#fff3cf; color:#705015; }
.revision-chip.approved { background:#eaf7ef; color:#25603d; }
.pending-card { margin-top:16rpx; }
.mentor-card { display:flex; flex-wrap:wrap; align-items:center; gap:12rpx; }
.mentor-main { flex:1 1 180rpx; min-width:0; }
.mentor-avatar { color:#2459be; background:#e7eef8; padding:12rpx; font-size:24rpx; }
.arrow { color:#2459be; font-size:34rpx; }
.record-list { padding:0 20rpx; background:#fff3cf; }
.record-row { padding:20rpx 0; border-bottom:1rpx solid #e5d9b6; }
.record-date { color:#705015; font-size:24rpx; font-weight:700; margin-bottom:8rpx; }
.record-main { min-width:0; }
.course-slot { font-size:24rpx; color:#2459be; font-weight:700; margin-bottom:10rpx; line-height:1.5; }
.plan-loading,.plan-error { padding:24rpx; background:#edf2f7; color:#46586e; font-size:26rpx; line-height:1.7; }

/* 2026-10 device acceptance: vertical narrow sidebar collapses all words.
   Horizontal scrollable stage selector restores full card width and legibility. */
.classroom-page{background:#eaf1f7;color:#122640;padding:24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));}
.classroom-top{gap:9rpx;margin-bottom:18rpx;align-items:center;flex-wrap:nowrap;}
.page-title{color:#103d75;}
.page-subtitle{font-size:23rpx;line-height:1.5;margin-top:5rpx;color:#405c77;}
.stage-badge{flex:none;max-width:200rpx;line-height:1.35;background:#ffdc83;color:#6e4609;font-weight:700;font-size:22rpx;padding:9rpx 12rpx;}
.student-tools{display:flex;flex-wrap:nowrap;gap:12rpx;align-items:center;padding:19rpx 17rpx;margin-bottom:17rpx;border-left:7rpx solid #08a49b;background:#f9fffe;}
.student-tools > view{flex:1 1 0;min-width:0;}
.tool-title{color:#103d75;}
.tool-desc{font-size:23rpx;line-height:1.5;}
.schedule-import-button{flex:none;padding:14rpx 16rpx;background:#1e65d6;font-size:24rpx;}
.classroom-layout{display:block;width:100%;min-width:0;}
.stage-sidebar{display:block;position:relative;top:auto;box-sizing:border-box;width:100%;height:94rpx;margin:0 0 18rpx;background:#dae7f7;border-radius: 9rpx;white-space:nowrap;overflow:hidden;}
.stage-strip{display:flex;align-items:center;width:max-content;min-height:88rpx;padding:7rpx 8rpx;box-sizing:border-box;gap:8rpx;}
.timeline{display:flex;align-items:center;gap:8rpx;padding:0;width:max-content;}
.timeline-item,.current-week-nav{display:flex;flex:none;align-items:center;justify-content:center;box-sizing:border-box;width:auto;min-width:122rpx;min-height:70rpx;border:0;border-radius: 7rpx;padding:12rpx 16rpx;background:#f8fbff;box-shadow:none;}
.current-week-nav{min-width:135rpx;background:#effff9;}
.timeline-label,.current-week-label{display:block;min-width:0;white-space:nowrap;font-size:24rpx;line-height:1.3;font-weight:700;color:#305272;text-align:center;}
.stage-pressed{opacity:.8;}
.timeline-item.active,.current-week-nav.active{background:#1c56ae;}
.timeline-item.active .timeline-label,.current-week-nav.active .current-week-label{color:#fff;}
.classroom-main{width:100%;box-sizing:border-box;min-width:0;}
.stage-summary{background:#dceaff;border-left:6rpx solid #2364cc;padding:19rpx;}
.stage-title{color:#123f77;}
.stage-desc{line-height:1.5;font-size:23rpx;color:#4c6278;}
.section-title-row{margin:20rpx 0 11rpx;}
.plan-list,.mentor-list,.week-list{gap:12rpx;margin-top:12rpx;}
.plan-card{padding:20rpx;background:#fff;border:1rpx solid #cbdaec;border-left:5rpx solid #2466cb;border-radius: 8rpx;}
.plan-card:nth-child(2n){border-left-color:#04a495;}
.plan-card-head{flex-wrap:nowrap;align-items:flex-start;}
.plan-heading{flex:1 1 0;min-width:0;}
.plan-title-row{gap:9rpx;}
.plan-note{font-size:23rpx;line-height:1.5;color:#496177;}
.plan-arrow{align-self:center;white-space:nowrap;flex:none;color:#205dba;}
.plan-card-foot{margin-top:11rpx;padding-top:11rpx;border-top:1rpx solid #d8e4f0;}
.plan-progress{color:#2058b1;font-weight:800;}
.revision-chip{font-size:20rpx;line-height:1.3;padding:4rpx 10rpx;background:#e5ecf5;}

/* Vertical academic stage navigation. Keep content on the right and allow scrolling
 * the semester rail independently; do not clip the final year. */
.classroom-layout{display:flex;gap:12rpx;align-items:stretch;}
.stage-sidebar{display:block;position:sticky;top:12rpx;box-sizing:border-box;flex:0 0 138rpx;width:138rpx;height:calc(100vh - 248rpx);min-height:370rpx;max-height:940rpx;overflow:hidden;background:#e5f0fb;border:1rpx solid #bdd5ee;border-radius: 6rpx;}
.stage-strip{display:flex;flex-direction:column;box-sizing:border-box;gap:7rpx;width:100%;min-height:100%;padding:9rpx 7rpx;}
.stage-rail-title{display:block;padding:9rpx 6rpx 3rpx;color:#426b8d;font-size:20rpx;font-weight:850;text-align:center;}
.timeline{display:flex;flex-direction:column;box-sizing:border-box;width:100%;gap:7rpx;padding:0;}
.timeline-item,.current-week-nav{display:flex;flex:none;align-items:center;justify-content:center;width:100%;min-width:0;min-height:68rpx;padding:11rpx 5rpx;border-radius: 5rpx;box-sizing:border-box;background:#fff;}
.current-week-nav{min-width:0;background:#d9f8ec;}
.timeline-label,.current-week-label{text-align:center;white-space:normal;word-break:keep-all;line-height:1.35;font-size:22rpx;font-weight:800;}
.timeline-item.active,.current-week-nav.active{background:#175aa8;border-left:5rpx solid #f0b947;}
.classroom-main{display:block;box-sizing:border-box;flex:1 1 0;width:auto;min-width:0;}
.classroom-main .surface{box-sizing:border-box;width:100%;}
.classroom-main .stage-summary{padding:16rpx 12rpx;}
.classroom-main .stage-title{font-size:27rpx;}
.classroom-main .section-title{font-size:25rpx;}
.classroom-main .plan-card{min-width:0;}

/* Compact term switcher; keep the selected viewing stage separate from the canonical student stage. */
.classroom-page{background:#f4f2ed;color:#18374f;}
.classroom-top{align-items:flex-start;}
.page-title{color:#183f62;}
.page-subtitle{color:#627987;}
.surface{background:#fffdf9;border-color:#e4ded2;border-radius: 8rpx;box-shadow:0 4rpx 16rpx rgba(24,57,74,.05);}
.student-tools{background:#fffdf9;border-left-color:#d7ad66;border-radius: 8rpx;}
.schedule-import-button,.entry-button,.plan-error button{background:#205b7d;border-radius: 8rpx;}
.stage-picker{padding:18rpx 20rpx;margin-bottom:18rpx;}
.stage-picker-top{display:flex;justify-content:space-between;align-items:center;gap:16rpx;}
.stage-picker-caption,.stage-picker-current{display:block;font-size:21rpx;line-height:1.55;color:#607584;}
.stage-picker-current{font-size:27rpx;color:#193f5f;font-weight:800;}
.stage-picker-toggle{flex:none;padding:11rpx 14rpx;background:#e7eff1;border-radius: 8rpx;color:#1f607e;font-size:22rpx;font-weight:800;}
.stage-group-list{margin-top:16rpx;padding-top:13rpx;border-top:1rpx solid #e9e3d9;}
.stage-group{margin:8rpx 0 17rpx;}
.stage-group-title{display:block;color:#986c36;font-size:22rpx;font-weight:800;margin-bottom:9rpx;}
.stage-options{display:flex;flex-wrap:wrap;gap:10rpx;}
.stage-option{padding:11rpx 18rpx;border-radius: 9rpx;background:#edf3f4;color:#365a70;font-size:22rpx;}
.stage-option.active{background:#1d5779;color:#fff;border-bottom:3rpx solid #d8ad64;}
.current-week-link{margin-top:12rpx;padding:12rpx 0;border-top:1rpx solid #ede7db;color:#236383;font-size:23rpx;font-weight:750;}
.classroom-layout{display:block;}
.classroom-main{width:100%;}
.stage-summary{background:#e9f0f1;border-left-color:#d6ad69;border-radius: 8rpx;}
.stage-title{color:#194765;}
.plan-card{border-left-color:#d6ad69;border-radius: 8rpx;}
.plan-card:nth-child(2n){border-left-color:#87aeb5;}
.plan-arrow,.course-slot{color:#24647f;}
.revision-chip.pending{background:#fff3da;color:#795921;}
