<view class="page-shell">
  <view class="profile-hero surface" bindtap="onIdentityTap">
    <view class="avatar">{{role === 'teacher' || role === 'staff' ? '师' : role === 'admin' ? '管' : '九'}}</view>
    <view class="identity">
      <view class="identity-line">
        <text class="user-name">{{user.name}}</text>
        <text class="role-chip">{{roleLabel}}</text>
      </view>
      <text class="user-meta">{{user.meta}}</text>
    </view>
    <text class="arrow">›</text>
  </view>

  <view class="stats surface">
    <view wx:for="{{stats}}" wx:key="label" class="stat-item">
      <text class="stat-value">{{item.value}}</text>
      <text class="stat-label">{{item.label}}</text>
    </view>
  </view>

  <view class="section-head">
    <text class="section-title">
      {{role === 'teacher' || role === 'staff' ? '教学工作台' : role === 'admin' ? '管理工作台' : '我的服务'}}
    </text>
  </view>

  <view class="menu-list surface">
    <view
      wx:for="{{menus}}"
      wx:key="key"
      class="menu-row"
      data-key="{{item.key}}"
      data-title="{{item.title}}"
      bindtap="onMenuTap"
    >
      <view class="menu-main">
        <text class="menu-title">{{item.title}}</text>
        <text class="menu-desc">{{item.desc}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <button wx:if="{{loggedIn}}" class="logout-button" bindtap="onLogout">退出登录</button>
  <button wx:if="{{loggedIn}}" class="delete-account-button" bindtap="onDeleteAccount">注销账号</button>

  <view class="service-note surface">
    <text class="note-title">九辰保研</text>
    <text class="note-text" wx:if="{{role === 'teacher' || role === 'staff'}}">老师端只能访问管理员授权的学员与辅导数据。</text>
    <text class="note-text" wx:elif="{{role === 'admin'}}">管理员可维护内部ID、师生关系并同步官方服务号动态。</text>
    <text class="note-text" wx:elif="{{role === 'user'}}">游客不会自动获得任何内部权限；填写九辰内部ID后由系统匹配对应界面。</text>
    <text class="note-text" wx:else>课程模块仅用于内容展示与咨询；付费能力仅用于后续 AI 评估额度。</text>
  </view>
</view>
