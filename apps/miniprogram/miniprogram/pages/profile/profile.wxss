.profile-head{display:flex;align-items:center;padding:30rpx}.avatar{width:92rpx;height:92rpx;border-radius:28rpx;background:#246bfd;color:#fff;display:flex;align-items:center;justify-content:center;font-size:36rpx;font-weight:800}.profile-main{flex:1;margin-left:20rpx}.profile-name{display:block;font-size:31rpx;font-weight:800}.profile-meta{display:block;margin-top:8rpx;color:#8a91a1;font-size:22rpx}.edit-link{color:#246bfd;font-size:23rpx}.credit-card{margin-top:22rpx;padding:28rpx;display:flex;align-items:center;justify-content:space-between;background:linear-gradient(145deg,#1f62ed,#3e7bff);color:#fff}.credit-label{display:block;font-size:23rpx;opacity:.8}.credit-value{display:block;margin-top:8rpx;font-size:30rpx;font-weight:700}.credit-action{font-size:22rpx;background:rgba(255,255,255,.16);padding:10rpx 16rpx;border-radius:999rpx}.service-list{margin-top:22rpx;padding:0 26rpx}.service-row{display:flex;align-items:center;justify-content:space-between;padding:26rpx 0;border-bottom:1rpx solid #eef0f4}.service-row:last-child{border-bottom:0}.service-title{display:block;font-size:27rpx;font-weight:600}.service-value{display:block;margin-top:7rpx;font-size:22rpx;color:#8a91a1}.arrow{font-size:38rpx;color:#b3b8c3}.footer-note{text-align:center;color:#a0a6b4;font-size:22rpx;padding:48rpx 0}