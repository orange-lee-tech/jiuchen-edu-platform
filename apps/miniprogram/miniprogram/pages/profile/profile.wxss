.profile-hero {
  display: flex;
  align-items: center;
  padding: 30rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 94rpx;
  height: 94rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #2f6fed, #6d8ff5);
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 800;
}

.identity {
  flex: 1;
  margin-left: 22rpx;
}

.user-name,
.user-meta,
.stat-value,
.stat-label,
.menu-title,
.menu-desc,
.note-title,
.note-text {
  display: block;
}

.user-name {
  font-size: 31rpx;
  font-weight: 800;
}

.user-meta {
  margin-top: 9rpx;
  color: #8a8f98;
  font-size: 22rpx;
}

.arrow {
  color: #b2b7c0;
  font-size: 38rpx;
}

.stats {
  display: flex;
  margin-top: 18rpx;
  padding: 24rpx 10rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid #eef0f4;
}

.stat-item:last-child {
  border-right: 0;
}

.stat-value {
  font-size: 32rpx;
  font-weight: 800;
}

.stat-label {
  margin-top: 8rpx;
  color: #8a8f98;
  font-size: 21rpx;
}

.section-head {
  margin: 34rpx 4rpx 18rpx;
}

.menu-list {
  padding: 4rpx 24rpx;
}

.menu-row {
  display: flex;
  align-items: center;
  min-height: 128rpx;
  border-bottom: 1rpx solid #eef0f4;
}

.menu-row:last-child {
  border-bottom: 0;
}

.menu-main {
  flex: 1;
}

.menu-title,
.note-title {
  font-size: 27rpx;
  font-weight: 700;
}

.menu-desc,
.note-text {
  margin-top: 8rpx;
  color: #8a8f98;
  font-size: 21rpx;
  line-height: 1.6;
}

.service-note {
  margin-top: 24rpx;
  padding: 26rpx;
}
