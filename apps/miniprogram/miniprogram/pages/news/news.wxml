<view class="page-shell">
  <role-shell view-slot="opportunity" phase="{{shellPhase}}" kind="{{shellKind}}" role-label="{{shellRoleLabel}}" message="{{shellMessage}}" />
  <view wx:if="{{shellPhase === 'ready' && shellKind === 'teacher'}}" class="teacher-guidance">
    <button bindtap="onSchools">院校库 ›</button><button bindtap="onTeacherNews">资讯 ›</button>
  </view>
  <view wx:if="{{shellPhase === 'ready' && shellKind !== 'student' && shellKind !== 'teacher'}}" class="reference-news-link" bindtap="onReferenceNews" hover-class="reference-news-pressed" aria-role="button">
    <text>{{showReferenceNews ? '收起保研参考文章' : '查看保研参考文章'}}</text>
    <text class="reference-news-arrow">{{showReferenceNews ? '⌃' : '›'}}</text>
  </view>

  <block wx:if="{{shellPhase === 'ready' && (shellKind === 'student' || showReferenceNews)}}">
  <view wx:if="{{shellKind !== 'student'}}" class="news-head">
    <text class="page-title">保研参考文章</text>
    <text class="page-desc">具体项目条件请以来源原文为准。</text>
  </view>

  <button wx:if="{{canManageTeacherTags}}" class="teacher-tags-entry" bindtap="onTeacherNewsTags">管理我的资讯标签</button>

  <view wx:if="{{shellKind !== 'teacher'}}" class="school-entry" bindtap="onSchools" hover-class="school-entry-hover" aria-role="button">
    <image class="school-entry-art" src="/assets/jiuchen-visual-v1/banners/school-library-hero.png" mode="aspectFill" aria-hidden="true" />
    <view class="school-entry-icon"><image src="/assets/jiuchen-visual-v1/icons/library.png" mode="aspectFit" /></view>
    <view class="school-entry-copy"><text class="school-entry-title">院校库 · 双一流与特色高校</text></view>
    <text class="school-entry-arrow">›</text>
  </view>

  <view wx:if="{{newsV2Enabled}}" class="news-favorites surface">
    <view class="news-favorites-head" bindtap="onToggleFavorites" aria-role="button">
      <text class="news-favorites-title">我的收藏 · {{favorites.length}} 篇</text>
      <text class="news-favorites-arrow">{{favoritesOpen ? '收起 ⌃' : '展开 ›'}}</text>
    </view>
    <view wx:if="{{favoritesOpen}}" class="news-favorites-body">
      <text wx:if="{{favoritesError}}" class="news-extra-meta">{{favoritesError}}</text>
      <text wx:elif="{{!favorites.length}}" class="news-extra-meta">暂无收藏文章</text>
      <view wx:for="{{favorites}}" wx:key="postId" class="news-extra-row" data-id="{{item.postId}}" bindtap="onFavoriteTap">
        <text class="news-extra-title">{{item.title}}</text>
        <text class="news-extra-meta">打开服务号原文 ›</text>
      </view>
    </view>
  </view>

  <view class="news-search">
    <input class="news-search-input" placeholder="搜索资讯" value="{{searchQuery}}" bindinput="onSearchInput" confirm-type="search" />
    <button class="news-filter-button" bindtap="onFilterTap">{{filtersOpen ? '收起筛选' : selectedTags.length ? '筛选 · ' + selectedTags.length : '复选筛选'}} ▾</button>
  </view>

  <view wx:if="{{pendingClassificationCount > 0}}" class="pending-news-note">
    <view class="pending-news-text">
      <text class="pending-news-title">当前列表有 {{pendingClassificationCount}} 篇资讯待分类</text>
      <text class="pending-news-desc">{{pendingClassificationRole === 'admin' ? '分类后学员才能在资讯中看到，点击处理标签。' : '新同步文章需要管理员添加标签后才能向学员展示。'}}</text>
    </view>
    <button wx:if="{{pendingClassificationRole === 'admin'}}" class="pending-news-action" bindtap="onManageNewsTags">处理标签</button>
  </view>

  <view wx:if="{{loadError}}" class="news-error"><text>{{loadError}}</text><button bindtap="loadNews">重新加载文章</button></view>
  <view wx:elif="{{loading && !allArticles.length}}" class="news-loading">正在读取文章…</view>
  <view wx:elif="{{!allArticles.length}}" class="news-empty"><text>暂无可阅读文章</text><button bindtap="loadNews">刷新文章</button></view>
  <block wx:else>
  <scroll-view class="news-sections" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="news-sections-row">
      <text wx:for="{{sections}}" wx:key="*this" class="news-section-tab {{currentSection === item ? 'active' : ''}}" data-section="{{item}}" bindtap="onSectionTap">{{item}}</text>
      <text class="news-section-tab news-other-tab {{filtersOpen || selectedTags.length ? 'active' : ''}}" bindtap="onOtherTap">{{filtersOpen ? '其他 ⌃' : '其他 ▾'}}</text>
    </view>
  </scroll-view>
  <view wx:if="{{filtersOpen}}" class="news-tag-panel">
    <view class="news-tag-panel-head">
      <text>标签复选 · {{selectedTags.length}} 项已选</text>
      <text wx:if="{{selectedTags.length}}" class="news-tag-clear" bindtap="onClearTags">清空</text>
    </view>
    <view class="news-tag-choices">
      <view wx:for="{{tagChoices}}" wx:key="name" class="category news-multi-tag {{item.selected ? 'active' : ''}}" data-tag="{{item.name}}" bindtap="onTagTap">{{item.selected ? '✓ ' : ''}}{{item.name}}</view>
      <text wx:if="{{!tagChoices.length}}" class="news-extra-meta">暂无分类标签</text>
    </view>
  </view>

  <view
    wx:if="{{featured.id}}"
    class="featured surface"
    data-id="{{featured.id}}"
    bindtap="onArticleTap"
  >
    <view class="featured-media">
      <image
        wx:if="{{featured.coverUrl && !featured.coverFailed}}"
        class="featured-cover"
        src="{{featured.coverUrl}}"
        mode="aspectFill"
        data-id="{{featured.id}}"
        binderror="onCoverError"
      />
      <view wx:else class="cover-fallback featured-fallback">讯</view>
    </view>
    <view class="featured-body">
      <text class="featured-title">{{featured.title}}</text>
      <text wx:if="{{featured.isVideo}}" class="article-meta">视频 · 在服务号原文观看</text>
      <text class="featured-summary">{{featured.summary}}</text>
      <text wx:if="{{featured.rawTagNote}}" class="article-meta">{{featured.rawTagNote}}</text>
      <text wx:if="{{featured.scopeNote}}" class="article-meta">{{featured.scopeNote}}</text>
      <view class="news-card-footer">
        <view class="article-tags"><text wx:for="{{featured.tags}}" wx:for-item="tag" wx:key="*this" class="article-tag">{{tag}}</text></view>
        <text class="featured-meta">来源：{{featured.sourceLabel}}</text>
        <text class="featured-meta">{{featured.dateLabel}}</text>
      </view>
    </view>
  </view>

  <view class="section-head">
    <text class="section-title">最新内容</text>
    <text wx:if="{{loading}}" class="section-note">同步中…</text>
  </view>

  <view class="article-list">
    <view
      wx:for="{{articles}}"
      wx:key="id"
      class="article-card surface"
      data-id="{{item.id}}"
      bindtap="onArticleTap"
    >
      <view class="article-media">
        <image
          wx:if="{{item.coverUrl && !item.coverFailed}}"
          class="article-cover"
          src="{{item.coverUrl}}"
          mode="aspectFill"
          data-id="{{item.id}}"
          binderror="onCoverError"
        />
        <view wx:else class="cover-fallback">讯</view>
      </view>
      <view class="article-main">
        <text class="article-title">{{item.title}}</text>
        <text wx:if="{{item.isVideo}}" class="article-meta">视频 · 在服务号原文观看</text>
        <text wx:if="{{item.summary}}" class="article-summary">{{item.summary}}</text>
        <text wx:if="{{item.rawTagNote}}" class="article-meta">{{item.rawTagNote}}</text>
        <text wx:if="{{item.scopeNote}}" class="article-meta">{{item.scopeNote}}</text>
        <view class="news-card-footer">
          <view class="article-tags"><text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="article-tag">{{tag}}</text><text wx:if="{{item.tags.length === 0}}" class="article-tag muted">未分类</text></view>
          <text class="article-meta">来源：{{item.sourceLabel}}</text>
          <text class="article-meta">{{item.dateLabel}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{!loading && !featured.id}}" class="empty surface">
      {{searchQuery ? '没有匹配的资讯。' : '当前分类暂无内容。'}}
    </view>
  </view>
  </block>
  <view wx:if="{{newsV2Enabled && retiring.length}}" class="news-extra">
    <text class="section-title">即将从资讯列表下架 · {{retiring.length}} 篇</text>
    <view wx:for="{{retiring}}" wx:key="id" class="news-extra-row" data-id="{{item.id}}" bindtap="onArticleTap">
      <text class="news-extra-title">{{item.title}}</text>
      <text class="news-extra-meta">{{item.sourceLabel}} · {{item.dateLabel}} · 将于 {{item.retireAt}} 退出资讯列表</text>
    </view>
  </view>

  </block>
</view>
<first-use-guide wx:if="{{!readOnly}}" />
