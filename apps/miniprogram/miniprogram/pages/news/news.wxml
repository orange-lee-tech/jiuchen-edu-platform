<view class="page-shell">
  <view class="news-head">
    <view>
      <text class="page-title">保研资讯</text>
      <text class="page-desc">服务号内容同步到小程序内阅读，管理员标签用于分类与后续个性化推荐</text>
    </view>
    <text class="source-chip">{{sourceLabel}}</text>
  </view>

  <scroll-view class="category-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="category-row">
      <view
        wx:for="{{categories}}"
        wx:key="*this"
        class="category {{currentCategory === index ? 'active' : ''}}"
        data-index="{{index}}"
        bindtap="onCategoryTap"
      >{{item}}</view>
    </view>
  </scroll-view>

  <view
    class="featured surface"
    data-id="{{featured.id}}"
    bindtap="onArticleTap"
  >
    <image wx:if="{{featured.coverUrl}}" class="featured-cover" src="{{featured.coverUrl}}" mode="aspectFill" />
    <view class="featured-body">
      <text class="featured-tag">{{featured.primaryTag}}</text>
      <text class="featured-title">{{featured.title}}</text>
      <text class="featured-summary">{{featured.summary}}</text>
      <text class="featured-more">{{featured.id ? '小程序内阅读全文 ›' : '等待同步内容'}}</text>
    </view>
  </view>

  <view class="section-head">
    <text class="section-title">最新内容</text>
    <text wx:if="{{loading}}" class="section-note">同步中…</text>
  </view>

  <view class="article-list">
    <view
      wx:for="{{articles}}"
      wx:key="id"
      class="article-card surface"
      data-id="{{item.id}}"
      bindtap="onArticleTap"
    >
      <image wx:if="{{item.coverUrl}}" class="article-cover" src="{{item.coverUrl}}" mode="aspectFill" />
      <view class="article-main">
        <view class="article-tags">
          <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="article-tag">{{tag}}</text>
          <text wx:if="{{item.tags.length === 0}}" class="article-tag muted">未分类</text>
        </view>
        <text class="article-title">{{item.title}}</text>
        <text wx:if="{{item.summary}}" class="article-summary">{{item.summary}}</text>
        <text class="article-meta">{{item.meta}}</text>
      </view>
    </view>

    <view wx:if="{{!loading && articles.length === 0}}" class="empty surface">
      当前分类暂无内容。
    </view>
  </view>
</view>
