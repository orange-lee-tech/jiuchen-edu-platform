.news-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 12rpx 4rpx 22rpx;
}

.page-title,
.page-desc,
.featured-tag,
.featured-title,
.featured-summary,
.featured-more,
.article-title,
.article-summary,
.article-meta {
  display: block;
}

.page-title {
  font-size: 42rpx;
  font-weight: 800;
}

.page-desc {
  max-width: 520rpx;
  margin-top: 10rpx;
  color: #7f8791;
  font-size: 22rpx;
  line-height: 1.6;
}

.category-row {
  display: flex;
  gap: 10rpx;
  width: max-content;
  padding-bottom: 18rpx;
}

.category {
  padding: 12rpx 20rpx;
  border-radius: 10rpx;
  background: #ffffff;
  color: #697380;
  font-size: 22rpx;
}

.category.active {
  background: #20262e;
  color: #ffffff;
}

.featured {
  display: flex;
  overflow: hidden;
  min-height: 184rpx;
  padding: 0;
}

.featured-media {
  position: relative;
  flex: 0 0 168rpx;
  width: 168rpx;
  min-height: 184rpx;
  background: #edf1f5;
}

.featured-cover {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 184rpx;
}

.featured-body {
  flex: 1;
  min-width: 0;
  padding: 24rpx;
}

.cover-fallback {
  display: flex;
  width: 100%;
  height: 100%;
  min-height: 168rpx;
  align-items: center;
  justify-content: center;
  background: #edf1f5;
  color: #71849a;
  font-size: 40rpx;
  font-weight: 800;
}

.featured-fallback {
  min-height: 184rpx;
}

.featured-tag {
  color: #315f9d;
  font-size: 21rpx;
  font-weight: 700;
}

.featured-title {
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.45;
}

.featured-summary {
  margin-top: 14rpx;
  color: #6f7884;
  font-size: 23rpx;
  line-height: 1.7;
}

.featured-more {
  margin-top: 22rpx;
  color: #315f9d;
  font-size: 22rpx;
  font-weight: 700;
}

.section-head {
  margin: 34rpx 4rpx 18rpx;
}

.article-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.article-card {
  display: flex;
  overflow: hidden;
  min-height: 168rpx;
  padding: 0;
}

.article-media {
  position: relative;
  flex: 0 0 152rpx;
  width: 152rpx;
  min-height: 168rpx;
  background: #edf1f5;
}

.article-cover {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 168rpx;
}

.article-main {
  flex: 1;
  min-width: 0;
  padding: 20rpx 22rpx;
}

.article-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.article-tag {
  display: inline-block;
  padding: 5rpx 10rpx;
  border-radius: 8rpx;
  background: #eef3f8;
  color: #53677f;
  font-size: 18rpx;
}

.article-tag.muted {
  background: #f2f3f5;
  color: #9097a0;
}

.article-title {
  margin-top: 10rpx;
  color: #272d35;
  font-size: 27rpx;
  font-weight: 750;
  line-height: 1.5;
}

.article-summary {
  margin-top: 8rpx;
  color: #747d88;
  font-size: 21rpx;
  line-height: 1.6;
}

.article-meta {
  margin-top: 14rpx;
  color: #949ba4;
  font-size: 19rpx;
}

.empty {
  padding: 28rpx;
  color: #8f96a0;
  font-size: 22rpx;
  text-align: center;
}
