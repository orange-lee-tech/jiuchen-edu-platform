<view class="login-page">
  <view class="brand-block">
    <view class="brand-mark">九</view>
    <text class="brand-title">九辰保研</text>
  </view>

  <view class="login-card">
    <text class="method-title">快捷登录</text>
    <text class="method-desc">首次登录自动创建游客账号，不会自动分配学员、老师或管理员ID。</text>

    <button
      class="login-button"
      loading="{{loading}}"
      disabled="{{loading}}"
      bindtap="onWechatLogin"
    >
      微信一键登录
    </button>

    <button
      class="login-button phone"
      open-type="getPhoneNumber"
      bindgetphonenumber="onPhoneLogin"
      loading="{{loading}}"
      disabled="{{loading || !agreed}}"
    >
      手机号快捷登录
    </button>


    <checkbox-group class="agreement-row" bindchange="onAgreementChange">
      <label class="agreement-label">
        <checkbox value="accepted" checked="{{agreed}}" color="#173e67" />
        <text>我已阅读并同意</text>
      </label>
      <text class="agreement-link" bindtap="onAgreementTap">《用户协议》</text>
    </checkbox-group>

    <text wx:if="{{!agreed}}" class="agreement-hint">勾选用户协议后可使用本机号码登录。</text>
  </view>

</view>
