.login-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 86rpx 36rpx calc(60rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #eaf2fa 0%, #f4f2ed 42%, #f4f2ed 100%);
}
.brand-block {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 8rpx;
  background: linear-gradient(145deg, #173e67, #245681);
  box-shadow: 0 12rpx 28rpx rgba(23, 62, 103, 0.14);
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 800;
}

.brand-title,
.method-title,
.method-desc,
.agreement-hint {
  display: block;
}

.brand-title {
  margin-top: 24rpx;
  color: #173e67;
  font-size: 38rpx;
  font-weight: 800;
}

.login-card {
  margin-top: 54rpx;
  padding: 30rpx 26rpx;
  border: 1rpx solid #e8e2d6;
  border-radius: 8rpx;
  background: #fffdf9;
  box-shadow: 0 16rpx 42rpx rgba(36, 41, 55, 0.06);
}

.method-title {
  color: #30333a;
  font-size: 28rpx;
  font-weight: 800;
}

.method-desc,
.agreement-hint {
  margin-top: 10rpx;
  color: #66707d;
  font-size: 22rpx;
  line-height: 1.55;
}

.login-button {
  margin-top: 28rpx;
  border-radius: 8rpx;
  background: #173e67;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 700;
}

.login-button.phone {
  margin-top: 18rpx;
  background: #eaf2fa;
  color: #173e67;
}

.login-button[disabled] {
  opacity: 0.55;
}

.login-button::after {
  border: 0;
}

.agreement-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 28rpx;
  color: #747a84;
  font-size: 21rpx;
}

.agreement-label {
  display: flex;
  align-items: center;
}

.agreement-label checkbox {
  transform: scale(0.8);
  transform-origin: left center;
}

.agreement-link {
  color: #245681;
}

.agreement-hint {
  color: #9b7a36;
}
