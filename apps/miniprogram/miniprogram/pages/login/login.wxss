.login-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 86rpx 36rpx 60rpx;
  background: linear-gradient(180deg, #f4f1ff 0%, #f7f8fb 42%, #f7f8fb 100%);
}

.brand-block {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 30rpx;
  background: linear-gradient(145deg, #6b53d8, #8b75ec);
  box-shadow: 0 18rpx 38rpx rgba(107, 83, 216, 0.2);
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 800;
}

.brand-title,
.brand-desc,
.method-title,
.method-desc,
.native-note,
.agreement-hint {
  display: block;
}

.brand-title {
  margin-top: 24rpx;
  color: #252830;
  font-size: 38rpx;
  font-weight: 800;
}

.brand-desc {
  margin-top: 10rpx;
  color: #9297a0;
  font-size: 23rpx;
}

.login-card {
  margin-top: 54rpx;
  padding: 30rpx 26rpx;
  border: 1rpx solid #eceef3;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 42rpx rgba(36, 41, 55, 0.06);
}

.method-title {
  color: #30333a;
  font-size: 28rpx;
  font-weight: 800;
}

.method-desc,
.native-note,
.agreement-hint {
  margin-top: 10rpx;
  color: #8b919b;
  font-size: 20rpx;
  line-height: 1.55;
}

.login-button {
  margin-top: 28rpx;
  border-radius: 999rpx;
  background: #6b53d8;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 700;
}

.login-button.phone {
  margin-top: 18rpx;
  background: #ece9f8;
  color: #6b53d8;
}

.login-button[disabled] {
  opacity: 0.55;
}

.login-button::after {
  border: 0;
}

.native-note {
  margin-top: 18rpx;
  text-align: center;
}

.agreement-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 28rpx;
  color: #747a84;
  font-size: 21rpx;
}

.agreement-label {
  display: flex;
  align-items: center;
}

.agreement-label checkbox {
  transform: scale(0.8);
  transform-origin: left center;
}

.agreement-link {
  color: #694fd4;
}

.agreement-hint {
  color: #9b7a36;
}

.login-footnote {
  display: block;
  margin-top: 26rpx;
  color: #a0a5ad;
  font-size: 19rpx;
  line-height: 1.5;
  text-align: center;
}
