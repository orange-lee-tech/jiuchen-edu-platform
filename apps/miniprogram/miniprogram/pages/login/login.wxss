.login-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 86rpx 36rpx 60rpx;
  background: linear-gradient(180deg, #f4f1ff 0%, #f7f8fb 42%, #f7f8fb 100%);
}

.brand-block {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 30rpx;
  background: linear-gradient(145deg, #6b53d8, #8b75ec);
  box-shadow: 0 18rpx 38rpx rgba(107, 83, 216, 0.2);
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 800;
}

.brand-title,
.brand-desc,
.portal-title,
.portal-desc {
  display: block;
}

.brand-title {
  margin-top: 24rpx;
  color: #252830;
  font-size: 38rpx;
  font-weight: 800;
}

.brand-desc {
  margin-top: 10rpx;
  color: #9297a0;
  font-size: 23rpx;
}

.login-card {
  margin-top: 54rpx;
  padding: 26rpx;
  border: 1rpx solid #eceef3;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 42rpx rgba(36, 41, 55, 0.06);
}

.portal-tabs {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.portal-tab {
  padding: 24rpx 18rpx;
  border: 2rpx solid #eceef3;
  border-radius: 20rpx;
  background: #fafbfc;
}

.portal-tab.active {
  border-color: #765ede;
  background: #f1edff;
}

.portal-title {
  color: #30333a;
  font-size: 27rpx;
  font-weight: 800;
}

.portal-tab.active .portal-title {
  color: #654bd1;
}

.portal-desc {
  margin-top: 8rpx;
  color: #9398a2;
  font-size: 19rpx;
  line-height: 1.45;
}

.identity-note {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #f7f8fb;
  color: #7b818b;
  font-size: 20rpx;
  line-height: 1.55;
}

.agreement-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 28rpx;
  color: #747a84;
  font-size: 21rpx;
}

.agreement-label {
  display: flex;
  align-items: center;
}

.agreement-label checkbox {
  transform: scale(0.8);
  transform-origin: left center;
}

.agreement-link {
  color: #694fd4;
}

.login-button {
  margin-top: 28rpx;
  border-radius: 999rpx;
  background: #6b53d8;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 700;
}

.login-button::after {
  border: 0;
}

.login-footnote {
  display: block;
  margin-top: 26rpx;
  color: #a0a5ad;
  font-size: 19rpx;
  line-height: 1.5;
  text-align: center;
}
