.login-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 86rpx 36rpx 60rpx;
  background: linear-gradient(180deg, #f4f1ff 0%, #f7f8fb 42%, #f7f8fb 100%);
}

.brand-block {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 30rpx;
  background: linear-gradient(145deg, #6b53d8, #8b75ec);
  box-shadow: 0 18rpx 38rpx rgba(107, 83, 216, 0.2);
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 800;
}

.brand-title,
.brand-desc,
.method-title,
.method-desc,
.pending-note,
.field text {
  display: block;
}

.brand-title {
  margin-top: 24rpx;
  color: #252830;
  font-size: 38rpx;
  font-weight: 800;
}

.brand-desc {
  margin-top: 10rpx;
  color: #9297a0;
  font-size: 23rpx;
}

.login-card {
  margin-top: 54rpx;
  padding: 26rpx;
  border: 1rpx solid #eceef3;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 42rpx rgba(36, 41, 55, 0.06);
}

.method-tabs {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  padding: 6rpx;
  border-radius: 18rpx;
  background: #f5f6f8;
}

.method-tab {
  padding: 14rpx 8rpx;
  border-radius: 14rpx;
  color: #7c828c;
  font-size: 21rpx;
  text-align: center;
}

.method-tab.active {
  background: #ffffff;
  color: #654bd1;
  font-weight: 800;
  box-shadow: 0 4rpx 16rpx rgba(40, 45, 60, 0.06);
}

.method-panel {
  margin-top: 24rpx;
}

.method-title {
  color: #30333a;
  font-size: 28rpx;
  font-weight: 800;
}

.method-desc,
.pending-note {
  margin-top: 10rpx;
  color: #8b919b;
  font-size: 20rpx;
  line-height: 1.55;
}

.field {
  display: block;
  margin-top: 18rpx;
}

.field text {
  margin-bottom: 8rpx;
  color: #616771;
  font-size: 21rpx;
}

.field input {
  height: 72rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  border: 1rpx solid #e0e3e9;
  border-radius: 14rpx;
  background: #fafbfc;
  font-size: 24rpx;
}

.agreement-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 28rpx;
  color: #747a84;
  font-size: 21rpx;
}

.agreement-label {
  display: flex;
  align-items: center;
}

.agreement-label checkbox {
  transform: scale(0.8);
  transform-origin: left center;
}

.agreement-link {
  color: #694fd4;
}

.login-button {
  margin-top: 28rpx;
  border-radius: 999rpx;
  background: #6b53d8;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 700;
}

.login-button.secondary {
  background: #ece9f8;
  color: #6b53d8;
}

.login-button::after {
  border: 0;
}

.login-footnote {
  display: block;
  margin-top: 26rpx;
  color: #a0a5ad;
  font-size: 19rpx;
  line-height: 1.5;
  text-align: center;
}
