.assessment-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 24rpx 70rpx;
  background: #f6f7fb;
}

.hero {
  padding: 16rpx 6rpx 24rpx;
}

.eyebrow,
.title,
.desc,
.section-title,
.status-title,
.status-desc {
  display: block;
}

.eyebrow {
  color: #2f6fed;
  font-size: 22rpx;
  font-weight: 700;
}

.title {
  margin-top: 12rpx;
  color: #252830;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.35;
}

.desc {
  margin-top: 12rpx;
  color: #7d838e;
  font-size: 22rpx;
  line-height: 1.6;
}

.card,
.status-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border: 1rpx solid #eceef3;
  border-radius: 8rpx;
  background: #ffffff;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  color: #30333a;
  font-size: 27rpx;
  font-weight: 800;
}

.link {
  color: #2f6fed;
  font-size: 21rpx;
}

.profile-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eff1f4;
  color: #666d77;
  font-size: 22rpx;
}

.entry {
  display: grid;
  grid-template-columns: 1.1fr 1fr 1.3fr auto;
  gap: 10rpx;
  margin-top: 12rpx;
}

.entry.vertical {
  display: flex;
  flex-direction: column;
}

.input,
.picker-field,
.textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 70rpx;
  padding: 0 16rpx;
  border: 1rpx solid #e1e4e9;
  border-radius: 6rpx;
  background: #fafbfc;
  color: #40454d;
  font-size: 21rpx;
}

.picker-field {
  display: flex;
  align-items: center;
}

.textarea {
  min-height: 150rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  line-height: 1.55;
}

.textarea.compact {
  min-height: 110rpx;
  margin-top: 0;
}

.remove {
  margin: 0;
  padding: 0 16rpx;
  border-radius: 8rpx;
  background: #fff1ef;
  color: #b4534b;
  font-size: 20rpx;
  line-height: 70rpx;
}

.remove::after {
  border: 0;
}

.empty {
  padding: 18rpx 0;
  color: #9aa0aa;
  font-size: 21rpx;
}

.status-card {
  background: #f1f5ff;
}

.status-title {
  color: #355cad;
  font-size: 24rpx;
  font-weight: 800;
}

.status-desc {
  margin-top: 8rpx;
  color: #68748a;
  font-size: 21rpx;
  line-height: 1.55;
}

.actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 24rpx;
}

.primary,
.secondary {
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.primary {
  background: #2f6fed;
  color: #ffffff;
}

.secondary {
  background: #eceff5;
  color: #4f5661;
}

.primary::after,
.secondary::after {
  border: 0;
}


.inline-profile-input {
  flex: 1;
  margin-left: 24rpx;
  color: #3f454e;
  font-size: 22rpx;
  text-align: right;
}

.inline-profile-input::placeholder {
  color: #a0a5ad;
}

.saving-note {
  color: #8a8f98;
  font-size: 20rpx;
}


.picker-select {
  justify-content: space-between;
  color: #4f5661;
}

.competition-search {
  position: relative;
  z-index: 2;
}

.suggestions {
  margin-top: 8rpx;
  overflow: hidden;
  border: 1rpx solid #dfe4ec;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(35, 45, 65, 0.08);
}

.suggestion-item {
  padding: 18rpx 20rpx;
  border-bottom: 1rpx solid #eef1f5;
  color: #3f4650;
  font-size: 21rpx;
  line-height: 1.45;
}

.suggestion-item:last-child {
  border-bottom: 0;
}

.import-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.import-copy {
  min-width: 0;
  flex: 1;
}

.import-desc {
  display: block;
  margin-top: 8rpx;
  color: #7d838e;
  font-size: 20rpx;
  line-height: 1.55;
}

.import-button {
  flex: 0 0 148rpx;
  width: 148rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 8rpx;
  background: #2f6fed;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 68rpx;
}

.import-button::after {
  border: 0;
}

/* Assessment must reflect, not edit, the canonical academic account profile. */
.locked-profile-value {
  max-width: 65%;
  color: #263752;
  text-align: right;
  overflow-wrap: anywhere;
  font-weight: 600;
}
.profile-lock-note {
  display: block;
  padding: 0 0 12rpx;
  color: #596980;
  font-size: 21rpx;
  line-height: 1.55;
}

/* Small native credit purchasing panel: no chart or payment bundle on the client. */
.credit-panel { border-left: 6rpx solid #2f6fed; }
.credit-balance { display:block; font-size:48rpx; font-weight:800; color:#1b4d98; margin:12rpx 0; }
.credit-subtitle { display:block; font-size:22rpx; line-height:1.65; color:#53677d; }
.credit-status { display:block; color:#987026; font-size:22rpx; margin:12rpx 0; }
.credit-offers { display:flex; gap:12rpx; flex-wrap:wrap; margin:18rpx 0 6rpx; }
.credit-offer { margin:0; flex:1 1 220rpx; padding:14rpx; font-size:24rpx; line-height:1.6; color:white; background:#2f6fed; border-radius: 8rpx; }
.credit-verify { margin:16rpx 0 0; background:#e7eef8; color:#2459be; border-radius: 8rpx; font-size:24rpx; }

.context-card{border-left:5rpx solid #0d9488;background:#f7fcfb;}
.context-choice{display:flex;gap:20rpx;align-items:center;justify-content:space-between;padding:19rpx 0;border-top:1rpx solid #dceee9;}
.context-copy{flex:1;min-width:0;display:flex;flex-direction:column;gap:9rpx;}
.context-title{font-weight:800;color:#174f54;font-size:27rpx;}
.context-hint{font-size:22rpx;line-height:1.55;color:#4a7476;}
.context-disclaimer{display:block;font-size:20rpx;line-height:1.5;color:#648581;margin-top:12rpx;}
