.profile-edit-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 56rpx;
  background: #f6f7fb;
}

.intro-card,
.form-card {
  border: 1rpx solid #eceef3;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(33, 40, 58, 0.04);
}

.intro-card {
  padding: 28rpx;
}

.intro-title,
.intro-desc,
.field-label,
.privacy-note {
  display: block;
}

.intro-title {
  color: #292c33;
  font-size: 30rpx;
  font-weight: 800;
}

.intro-desc {
  margin-top: 10rpx;
  color: #858b95;
  font-size: 22rpx;
  line-height: 1.65;
}

.form-card {
  margin-top: 20rpx;
  padding: 2rpx 26rpx;
}

.field {
  display: block;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eef0f4;
}

.field:last-child {
  border-bottom: 0;
}

.field-label {
  color: #5e646e;
  font-size: 22rpx;
  font-weight: 700;
}

.field-input {
  height: 66rpx;
  margin-top: 8rpx;
  color: #262a31;
  font-size: 26rpx;
}

.save-button {
  margin-top: 26rpx;
  border-radius: 18rpx;
  background: #6b53d8;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 700;
}

.save-button::after {
  border: 0;
}

.privacy-note {
  margin: 22rpx 12rpx 0;
  color: #9a9fa8;
  font-size: 19rpx;
  line-height: 1.55;
  text-align: center;
}
