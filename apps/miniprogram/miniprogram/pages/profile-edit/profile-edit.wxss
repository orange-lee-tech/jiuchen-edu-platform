.profile-edit-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 28rpx calc(56rpx + env(safe-area-inset-bottom));
  background: #f4f2ed;
}

.intro-card,
.form-card {
  border: 1rpx solid #e8e2d6;
  border-radius: 8rpx;
  background: #fffdf9;
  box-shadow: 0 8rpx 24rpx rgba(33, 40, 58, 0.04);
}

.intro-card {
  padding: 28rpx;
}

.intro-title,
.field-label {
  display: block;
}

.intro-title {
  color: #173e67;
  font-size: 30rpx;
  font-weight: 800;
}

.form-card {
  margin-top: 20rpx;
  padding: 2rpx 26rpx;
}

.field {
  display: block;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e8e2d6;
}

.field:last-child {
  border-bottom: 0;
}

.field-label {
  color: #5e646e;
  font-size: 22rpx;
  font-weight: 700;
}

.field-input {
  height: 66rpx;
  margin-top: 8rpx;
  color: #262a31;
  font-size: 26rpx;
}

.save-button {
  margin-top: 26rpx;
  border-radius: 8rpx;
  background: #173e67;
  color: #fffdf9;
  font-size: 27rpx;
  font-weight: 700;
}

.save-button::after {
  border: 0;
}


.identity-card {
  margin-top: 20rpx;
  padding: 26rpx;
  border: 1rpx solid #e8e2d6;
  border-radius: 8rpx;
  background: #fffdf9;
  box-shadow: 0 8rpx 24rpx rgba(33, 40, 58, 0.04);
}

.identity-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.identity-title,
.identity-desc,
.locked-code,
.locked-role,
.section-label {
  display: block;
}

.identity-title {
  color: #173e67;
  font-size: 26rpx;
  font-weight: 800;
}

.identity-desc {
  margin-top: 8rpx;
  color: #66707d;
  font-size: 20rpx;
  line-height: 1.5;
}

.identity-status {
  flex-shrink: 0;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: #eaf2fa;
  color: #173e67;
  font-size: 18rpx;
}

.claim-row {
  display: flex;
  gap: 12rpx;
  margin-top: 22rpx;
}

.internal-id-input {
  flex: 1;
  height: 72rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  border: 1rpx solid #dfe2e8;
  border-radius: 6rpx;
  background: #f3f7fc;
  font-size: 24rpx;
}

.claim-button {
  flex-shrink: 0;
  width: 176rpx;
  min-height: 72rpx;
  margin: 0;
  border-radius: 8rpx;
  background: #173e67;
  color: #fffdf9;
  font-size: 22rpx;
}

.claim-button::after {
  border: 0;
}

.locked-id {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f3f7fc;
}

.locked-code {
  color: #30333a;
  font-size: 27rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.locked-role {
  color: #173e67;
  font-size: 21rpx;
  font-weight: 700;
}

.section-label {
  margin: 30rpx 4rpx 12rpx;
  color: #5f6570;
  font-size: 22rpx;
  font-weight: 700;
}

.role-note {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 8rpx;
  background: #eaf2fa;
  color: #245681;
  font-size: 21rpx;
  line-height: 1.6;
}

.load-error { margin-top: 18rpx; padding: 20rpx; border: 1rpx solid #e4c6ae; border-radius: 8rpx; background: #fff8f1; color: #704a2f; font-size: 23rpx; line-height: 1.6; }
.load-error button { margin: 16rpx 0 0; border-radius: 8rpx; background: #173e67; color: #fffdf9; font-size: 23rpx; }
.load-error button::after { border: 0; }
