.teacher-workbench{padding:20rpx 24rpx 40rpx;color:#26384a}.card{margin-bottom:24rpx;padding:28rpx;border-radius:24rpx;background:#fffdf8;border:1rpx solid #e6e0d2;box-shadow:0 8rpx 24rpx #203d5610}.heading{display:block;font-size:32rpx;font-weight:650;color:#244b72;margin-bottom:20rpx}.muted{display:block;color:#75818c;font-size:24rpx;line-height:1.7}.picker{padding:20rpx 0;color:#244b72;font-size:28rpx}.small{font-size:24rpx}.notice{padding:24rpx;line-height:1.7;color:#75818c}.error{color:#a24c3c}.row{display:flex;gap:20rpx;align-items:center;flex-wrap:wrap}.link{font-size:24rpx;color:#315b7e;padding:16rpx 0}.summary text{display:block;font-size:25rpx;line-height:1.9}.student-row{display:flex;flex-direction:column;padding:20rpx;border-bottom:1rpx solid #ebe6db}.selected{background:#edf2f6;border-radius:16rpx}.selection{display:inline-flex;align-items:center;margin:12rpx 20rpx 12rpx 0;font-size:25rpx}.task,.todo{padding:18rpx;margin:18rpx 0;background:#f7f5ef;border-radius:18rpx}.todo>text{display:block}.result{font-size:26rpx;line-height:1.8;padding-top:12rpx}.result-summary{margin-top:12rpx;color:#345d74;font-size:24rpx;font-weight:750;}input,textarea{box-sizing:border-box;width:100%;padding:18rpx;margin:12rpx 0;background:#fff;border:1rpx solid #e3e5e7;border-radius:12rpx;font-size:26rpx}textarea{height:130rpx}.primary,.secondary{margin-top:18rpx;border-radius:16rpx;font-size:27rpx}.primary{background:#244b72;color:#fff}.secondary{background:#f3ead6;color:#31516f}button::after{border:0}
