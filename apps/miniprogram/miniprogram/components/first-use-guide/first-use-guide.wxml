<view wx:if="{{active}}" class="guide-overlay" catchtouchmove="preventTouch">
  <view class="guide-card" role="dialog" aria-label="九辰首次使用引导">
    <view class="guide-progress">第 {{current + 1}} 步 / 共 {{count}} 步</view>
    <view class="guide-title">{{title}}</view>
    <view class="guide-body">{{body}}</view>
    <view class="guide-dots"><view wx:for="{{steps}}" wx:key="index" class="guide-dot {{index === current ? 'selected' : ''}}"></view></view>
    <view class="guide-actions">
      <button class="guide-skip" bindtap="onSkip">跳过引导</button>
      <button class="guide-next" bindtap="onNext">{{current + 1 === count ? '开始使用' : '下一步'}}</button>
    </view>
  </view>
</view>
