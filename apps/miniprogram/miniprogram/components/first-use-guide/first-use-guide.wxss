.guide-overlay { position: fixed; inset: 0; z-index: 999; display: flex; align-items: center; justify-content: center; box-sizing: border-box; padding: 32rpx; background: rgba(8, 23, 46, .67); }
.guide-card { width: 100%; max-width: 650rpx; box-sizing: border-box; padding: 36rpx; background: #fff; border-top: 8rpx solid #f2b544; border-radius: 12rpx; box-shadow: 0 12rpx 48rpx rgba(8,23,46,.22); }
.guide-kicker { color: #2459be; font-size: 24rpx; font-weight: 700; }
.guide-progress { margin-top: 8rpx; color: #66748a; font-size: 22rpx; }
.guide-title { margin-top: 30rpx; color: #173b73; font-size: 40rpx; line-height: 1.4; font-weight: 800; }
.guide-body { margin-top: 22rpx; color: #36465b; font-size: 28rpx; line-height: 1.75; }
.guide-dots { display: flex; gap: 12rpx; margin: 34rpx 0 22rpx; }
.guide-dot { width: 16rpx; height: 12rpx; background: #cbd6e5; border-radius: 6rpx; }
.guide-dot.selected { width: 42rpx; background: #2f6fed; }
.guide-actions { display: flex; align-items: center; gap: 14rpx; }
.guide-actions button { flex: 1; margin: 0; border-radius: 8rpx; font-size: 27rpx; line-height: 1.5; padding: 20rpx 8rpx; }
.guide-skip { background: #edf2f7; color: #46586e; }
.guide-next { background: #2459be; color: #fff; font-weight: 700; }
button::after { border: 0; }
