<view wx:if="{{phase !== 'ready'}}" class="shell-state" aria-live="polite">
  <text class="state-title">{{phase === 'loading' ? '正在确认你的身份' : '暂时无法打开工作区'}}</text>
  <text wx:if="{{phase === 'error'}}" class="state-description">{{message}}</text>
  <button wx:if="{{phase === 'error'}}" class="primary" bindtap="onRetry">重新确认身份</button>
</view>
<view wx:elif="{{kind === 'admin' && viewSlot === 'plan'}}" class="admin-browse">
  <view class="browse-hero">
    <text class="browse-title">身份查阅</text>
    <text class="browse-subtitle">只读查看，不可代为操作。</text>
  </view>
  <view class="browse-controls">
    <input value="{{browseQuery}}" bindinput="onBrowseQuery" placeholder="搜索学员 / 老师 / 学校 / 专业" class="browse-search" />
    <text class="browse-count">学员 {{displayedStudents.length}} · 老师 {{displayedTeachers.length}}</text>
  </view>
  <view wx:if="{{browseLoading}}" class="browse-state">正在加载授权名单…</view>
  <view wx:elif="{{browseError}}" class="browse-state"><text>{{browseError}}</text><button bindtap="loadReadOnlyPeople">重新读取</button></view>
  <block wx:else>
    <view class="browse-heading">学员</view>
    <view wx:for="{{displayedStudents}}" wx:key="id" data-id="{{item.id}}" bindtap="onBrowseStudent" class="browse-person">
      <view><text class="browse-person-name">{{item.name}}</text><text class="browse-person-note">{{item.university || '学校待补充'}} · {{item.major || '专业待补充'}}</text><text class="browse-person-note">{{item.stateLabel}}</text></view>
      <text class="browse-arrow">{{item.canView === false ? '暂不可查看' : '只读查看 ›'}}</text>
    </view>
    <text wx:if="{{!displayedStudents.length}}" class="browse-empty">没有匹配学员</text>
    <view class="browse-heading">老师</view>
    <view wx:for="{{displayedTeachers}}" wx:key="id" data-id="{{item.id}}" bindtap="onBrowseTeacher" class="browse-person">
      <view><text class="browse-person-name">{{item.name}}</text><text class="browse-person-note">{{item.title || '职务待补充'}}</text><text class="browse-person-note">{{item.stateLabel}}</text></view>
      <text class="browse-arrow">{{item.canView === false ? '暂不可查看' : '只读查看 ›'}}</text>
    </view>
    <text wx:if="{{!displayedTeachers.length}}" class="browse-empty">没有匹配老师</text>
  </block>
</view>
<view wx:elif="{{kind === 'admin' && (viewSlot === 'home' || viewSlot === 'opportunity')}}" class="admin-actions-page">
  <view class="admin-actions-intro">
    <text class="admin-actions-title">{{viewSlot === 'home' ? '管理工作台' : '业务与数据运营'}}</text>
  </view>
  <view class="admin-actions-stack">
    <view wx:for="{{actions}}" wx:key="key" class="admin-action {{item.key === 'mirror' ? 'admin-action-highlight' : ''}}" data-key="{{item.key}}" bindtap="onAction" hover-class="admin-action-pressed" aria-role="button">
      <view class="admin-action-symbol"><image class="admin-action-icon" src="/assets/icons/{{item.key === 'assignments' ? 'assignments' : item.key === 'articles' ? 'opportunity' : item.key === 'analytics' ? 'assessment' : 'users'}}-active.png" mode="aspectFit" /></view>
      <view class="admin-action-main"><text class="admin-action-title">{{item.title}}</text><text class="admin-action-description">{{item.description}}</text></view>
      <text class="admin-action-arrow">›</text>
    </view>
  </view>
</view>
<view wx:elif="{{kind !== 'student' && viewSlot !== 'mine'}}" class="workspace">
  <view class="workspace-intro {{viewSlot === 'home' ? 'workspace-home' : 'workspace-compact'}}">
    <image wx:if="{{viewSlot === 'home'}}" class="workspace-icon" src="/assets/icons/{{viewSlot === 'home' ? 'workbench' : viewSlot === 'plan' ? 'users' : kind === 'admin' ? 'business' : 'coaching'}}-active.png" /><text class="workspace-title">{{title}}</text>
    <button wx:if="{{actions.length}}" class="primary" loading="{{opening}}" disabled="{{opening}}" data-key="{{actions[0].key}}" bindtap="onAction"><image class="button-icon" src="/assets/icons/{{actions[0].key === 'assignments' ? 'assignments' : 'users'}}-active.png" />{{actions[0].title}}</button>
  </view>
  <view wx:if="{{actions.length > 1}}" class="secondary-list">
    <button wx:for="{{actions}}" wx:key="key" wx:if="{{index > 0}}" class="action-row" data-key="{{item.key}}" bindtap="onAction" disabled="{{opening}}">
      <image class="action-icon" src="/assets/icons/{{item.key === 'assignments' ? 'assignments' : item.key === 'articles' ? 'opportunity' : 'users'}}-active.png" /><view class="action-main"><text class="action-title">{{item.title}}</text><text class="action-description">{{item.description}}</text></view>
      <text class="arrow">›</text>
    </button>
  </view>
  <view wx:if="{{viewSlot === 'home'}}" class="workspace-note">
    <button class="text-link" bindtap="onMine">查看我的身份与账号</button>
  </view>
</view>
