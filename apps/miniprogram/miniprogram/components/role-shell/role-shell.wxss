:host { display: block; }
.workspace, .shell-state { color: #18202a; }
.workspace-intro, .shell-state { padding: 32rpx; border-radius: 6rpx; }
.workspace-intro { background:#173b73; color:#fff; border-bottom:6rpx solid #f2b544; }
.shell-state { background:#e7eef8; border-top:6rpx solid #2f6fed; }
.workspace-title, .state-title, .state-description, .action-title, .action-description { display: block; }
.workspace-title, .state-title { margin-top: 14rpx; font-size: 42rpx; line-height: 1.4; font-weight: 800; }
.state-description { margin-top: 14rpx; font-size: 26rpx; line-height: 1.75; }
.state-description { color:#46586e; }
button { box-sizing: border-box; border-radius: 8rpx; white-space: normal; margin-left: 0; margin-right: 0; }
.workspace-compact { background: #e7eef8; color: #173b73; border-left: 6rpx solid #2f6fed; border-bottom: 1rpx solid #b6c8df; padding: 26rpx; }
.workspace-compact .workspace-title { font-size: 34rpx; margin-top: 8rpx; }
.workspace-compact .primary { background: #173b73; color: #fff; width: 100%; }
.workspace-compact .primary:active { background: #2459be; }
.workspace-home .primary { width: 100%; }
.action-row { justify-content: flex-start; }

button::after { border: 0; }
.primary { margin: 28rpx 0 0; padding: 22rpx 24rpx; background: #2f6fed; color: #fff; font-size: 28rpx; font-weight: 700; line-height: 1.5; }
.primary:active { background: #2459be; }
.workspace-intro .primary { background:#fff3cf; color:#173b73; }
.workspace-intro .primary:active { background:#f2b544; }
.primary[disabled] { background: #526e9a; color: #fff; }
.secondary-list { margin-top: 24rpx; background: #fafbfc; border: 1rpx solid #d8dee6; }
.action-row { display: flex; align-items: center; width: 100%; padding: 26rpx; margin: 0; border-radius: 0; text-align: left; background: transparent; border-bottom: 1rpx solid #e5e9ee; }
.action-row:last-child { border-bottom: 0; }
.action-row:active { background: #e7eef8; }
.action-main { flex: 1; min-width: 0; }
.action-title { font-size: 29rpx; font-weight: 700; color: #18202a; line-height: 1.5; }
.action-description { margin-top: 8rpx; font-size: 25rpx; color: #5f6b78; line-height: 1.7; }
.arrow { margin-left: 20rpx; color: #2459be; font-size: 40rpx; }
.workspace-note { margin-top: 28rpx; padding: 24rpx; background: #fff3cf; border-left: 4rpx solid #f2b544; }
.text-link { margin: 0; padding: 16rpx 0; text-align: left; background: transparent; color: #2459be; font-size: 26rpx; line-height: 1.5; }
.workspace-icon { width:48rpx; height:48rpx; margin-top:20rpx; padding:10rpx; background:#e7eef8; border-radius:6rpx; }
.action-icon { width:44rpx; height:44rpx; margin-right:20rpx; flex:none; }
.button-icon { width:36rpx; height:36rpx; margin-right:12rpx; vertical-align:middle; }

.admin-browse{background:#edf5f2;color:#153e42;padding:0 0 35rpx;}
.browse-hero{padding:29rpx 25rpx;background:linear-gradient(120deg,#14425b,#09766e);color:white;border-left:6rpx solid #dcb65b;}
.browse-title{display:block;font-size:37rpx;font-weight:850;}
.browse-subtitle{display:block;color:#dbf0ee;font-size:22rpx;line-height:1.55;margin-top:8rpx;}
.browse-controls{margin:17rpx 0;}
.browse-search{border:1rpx solid #c4dfd6;background:white;border-radius:6rpx;height:76rpx;font-size:24rpx;padding:0 19rpx;}
.browse-count{display:block;font-size:22rpx;color:#45776e;margin-top:9rpx;}
.browse-heading{font-size:27rpx;font-weight:850;color:#174d50;margin:20rpx 0 10rpx;}
.browse-person{display:flex;align-items:center;justify-content:space-between;padding:20rpx 17rpx;margin-bottom:9rpx;border:1rpx solid #d4e4dd;background:#fff;border-radius:6rpx;gap:12rpx;}
.browse-person>view{flex:1;min-width:0;}
.browse-person-name{display:block;font-weight:800;font-size:26rpx;}
.browse-person-note{display:block;color:#6c8580;font-size:21rpx;margin-top:6rpx;}
.browse-arrow{color:#06887d;font-size:21rpx;font-weight:750;white-space:nowrap;}
.browse-state,.browse-empty{display:block;font-size:22rpx;color:#657c79;padding:22rpx 14rpx;}

/* Admin pages: edge-to-edge actionable rows instead of narrow, centered native buttons. */
.admin-actions-page{width:100%;box-sizing:border-box;color:#153d52;}
.admin-actions-intro{padding:24rpx 23rpx 26rpx;background:#e7eef8;border-left:6rpx solid #2f6fed;border-bottom:1rpx solid #b9ccdf;border-radius:5rpx;}
.admin-actions-title{display:block;font-size:35rpx;font-weight:850;line-height:1.32;color:#18375e;}
.admin-actions-stack{display:flex;flex-direction:column;gap:11rpx;margin-top:16rpx;width:100%;}
.admin-action{box-sizing:border-box;width:100%;display:flex;align-items:center;gap:16rpx;padding:20rpx 19rpx;min-height:113rpx;background:#fff;border:1rpx solid #d6e3ed;border-left:5rpx solid #3775c8;border-radius:6rpx;}
.admin-action-highlight{border-left-color:#078f84;background:#f0faf6;}
.admin-action-pressed{background:#e5f2f9;}
.admin-action-symbol{display:flex;align-items:center;justify-content:center;flex:none;width:53rpx;height:53rpx;border-radius:5rpx;background:#e6effc;}
.admin-action-highlight .admin-action-symbol{background:#d8f1ea;}
.admin-action-icon{width:33rpx;height:33rpx;}
.admin-action-main{display:flex;flex-direction:column;min-width:0;flex:1 1 0;align-items:stretch;}
.admin-action-title{display:block;font-size:27rpx;line-height:1.4;font-weight:850;color:#133b59;}
.admin-action-description{display:block;margin-top:4rpx;font-size:21rpx;line-height:1.5;color:#5a7183;white-space:normal;word-break:break-word;}
.admin-action-arrow{flex:none;font-size:37rpx;color:#2466ae;line-height:1;}
