# Evaluation-only credential. Never commit a real key.
EVAL_AI_PROVIDER=aliyun-bailian
EVAL_AI_BASE_URL=https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EVAL_AI_API_KEY=
EVAL_AI_MODEL=qwen3.8-flash

# Conservative defaults; tune per provider.
EVAL_CONCURRENCY=2
EVAL_TIMEOUT_MS=60000
EVAL_RETRIES=2
EVAL_MAX_TOKENS=900
EVAL_TEMPERATURE=0
EVAL_JSON_MODE=false

# Optional cost estimate shown by the runner.
EVAL_PRICE_INPUT_PER_MILLION=0.8
EVAL_PRICE_CACHED_INPUT_PER_MILLION=0.1
EVAL_PRICE_OUTPUT_PER_MILLION=2.7
EVAL_PRICE_CURRENCY=CNY

# Optional provider-specific request body additions.
# EVAL_AI_EXTRA_BODY_JSON={}
