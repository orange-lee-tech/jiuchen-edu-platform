{
  "name": "@jiuchen/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "db:push": "drizzle-kit push",
    "db:upgrade:auth": "tsx src/db/upgrade-auth-foundation.ts",
    "db:upgrade:identity-v2": "tsx src/db/upgrade-identity-v2.ts",
    "db:seed:test-internal-ids": "tsx src/db/seed-test-internal-ids.ts",
    "news:test:official-account": "tsx src/scripts/test-official-account.ts",
    "news:sync:official-account": "tsx src/scripts/sync-official-account.ts",
    "db:upgrade:native-auth": "tsx src/db/upgrade-native-auth.ts",
    "db:check:assessment": "tsx src/db/check-assessment-foundation.ts",
    "db:upgrade:assessment": "tsx src/db/upgrade-assessment-foundation.ts",
    "db:upgrade:classroom-guidance": "tsx src/db/upgrade-classroom-guidance.ts",
    "data:validate:product-handbook": "tsx src/scripts/validate-product-handbook.ts",
    "db:upgrade:product-knowledge": "tsx src/db/upgrade-product-knowledge.ts",
    "data:import:product-handbook": "tsx src/scripts/import-product-handbook.ts",
    "db:upgrade:classroom-revisions": "tsx src/db/upgrade-classroom-revisions.ts",
    "assessment:smoke:live": "tsx src/scripts/smoke-assessment-runtime.ts",
    "db:upgrade:credit-payment": "tsx src/db/upgrade-credit-payment-foundation.ts",
    "db:upgrade:growth-profile": "tsx src/db/upgrade-growth-profile.ts"
  },
  "dependencies": {
    "@cloudbase/node-sdk": "^3.18.3",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.0.0",
    "mysql2": "^3.14.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
