PORT=3000
HOST=0.0.0.0
DATABASE_URL=mysql://user:password@127.0.0.1:3306/jiuchen

# CloudBase Run may use split MySQL variables instead of DATABASE_URL.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

WECHAT_APP_ID=
WECHAT_APP_SECRET=

# WeChat Official Account (service account) sync. Server-side only.
WECHAT_OA_APP_ID=
WECHAT_OA_APP_SECRET=

# Assessment-only product values approved on 2026-10-09; checkout stays disabled until
# schema/merchant/callback/refund/device gates. Guest=1, student total=5 (bonus 4).
CREDIT_ENFORCEMENT_ENABLED=false
CREDIT_FREE_GRANT_VERSION=
CREDIT_FREE_GRANT_AMOUNT=
# Server-approved assessment-1=190 fen and assessment-10=1690 fen. Leave empty
# or configure the EXACT approved SKUs; course SKUs are rejected on enable.
CREDIT_PAYMENT_SKUS_JSON=

# WeChat Pay API v3 / JSAPI. Server-side only; never expose these to the Mini Program.
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_MERCHANT_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PEM=
WECHAT_PAY_PLATFORM_SERIAL_NO=
WECHAT_PAY_PLATFORM_CERT_PEM=
WECHAT_PAY_NOTIFY_URL=

# CloudBase Storage adapter. Keep secrets server-side only.
CLOUDBASE_ENV_ID=
# Optional legacy/server API Key path. CAM is preferred for ECS.
CLOUDBASE_APIKEY=
TENCENTCLOUD_SECRETID=
TENCENTCLOUD_SECRETKEY=

# Provider-agnostic OpenAI-compatible Chat Completions endpoints.
# Keep each workload on independent credentials/quota.
ASSESSMENT_AI_PROVIDER=
ASSESSMENT_AI_BASE_URL=
ASSESSMENT_AI_API_KEY=
ASSESSMENT_AI_MODEL=
# Backward-compatible JSON Object mode remains the default.
# Set json_schema only for a model/provider that explicitly supports strict JSON Schema.
ASSESSMENT_AI_RESPONSE_FORMAT=
# Optional legacy switch. Prefer ASSESSMENT_AI_RESPONSE_FORMAT for new work.
ASSESSMENT_AI_JSON_MODE=true
# Provider-specific non-secret request options, e.g. {"enable_thinking":false}.
ASSESSMENT_AI_EXTRA_BODY_JSON=
# Directory containing ai/rag/v1.0.0. Production always selects production-all;
# development/test/evaluation always select the eval-safe train/dev corpus.
ASSESSMENT_CASE_DATA_ROOT=../../data-source/cases

SCHEDULE_AI_PROVIDER=
SCHEDULE_AI_BASE_URL=
SCHEDULE_AI_API_KEY=
SCHEDULE_AI_MODEL=

CUSTOMER_AI_PROVIDER=
CUSTOMER_AI_BASE_URL=
CUSTOMER_AI_API_KEY=
CUSTOMER_AI_MODEL=

# PAYMENTS SAFETY (2026): Token/AI evaluation packages are virtual goods.
# Legacy WeChat JSAPI credentials DO NOT enable checkout. Ordinary payment
# POST /me/payment-orders hard-blocked until a verified WeChat virtual-pay
# adapter is built and approved; CREDIT_ENFORCEMENT_ENABLED controls credits only.
