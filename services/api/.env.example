PORT=3000
HOST=0.0.0.0
DATABASE_URL=mysql://user:password@127.0.0.1:3306/jiuchen

# CloudBase Run may use split MySQL variables instead of DATABASE_URL.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

WECHAT_APP_ID=
WECHAT_APP_SECRET=

# WeChat Official Account (service account) sync. Server-side only.
WECHAT_OA_APP_ID=
WECHAT_OA_APP_SECRET=

# CloudBase Storage adapter. Keep secrets server-side only.
CLOUDBASE_ENV_ID=
# Optional legacy/server API Key path. CAM is preferred for ECS.
CLOUDBASE_APIKEY=
TENCENTCLOUD_SECRETID=
TENCENTCLOUD_SECRETKEY=

# Provider-agnostic OpenAI-compatible Chat Completions endpoints.
# Keep each workload on independent credentials/quota.
ASSESSMENT_AI_PROVIDER=
ASSESSMENT_AI_BASE_URL=
ASSESSMENT_AI_API_KEY=
ASSESSMENT_AI_MODEL=

SCHEDULE_AI_PROVIDER=
SCHEDULE_AI_BASE_URL=
SCHEDULE_AI_API_KEY=
SCHEDULE_AI_MODEL=

CUSTOMER_AI_PROVIDER=
CUSTOMER_AI_BASE_URL=
CUSTOMER_AI_API_KEY=
CUSTOMER_AI_MODEL=
